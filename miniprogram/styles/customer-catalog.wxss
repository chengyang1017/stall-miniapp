@import "./customer-theme.wxss";
@import "./product-placeholder.wxss";.home-body{padding:0 24rpx 38rpx}
.home-sync-status { height:44rpx;line-height:44rpx;font-size:22rpx;color:#8d7eaa;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.deals-section{background:linear-gradient(120deg,#f5dcf6,#e8defc);padding:0 18rpx 18rpx;border-radius:28rpx;overflow:hidden}
.deals-section .section-heading{padding-top:22rpx;margin-top:0;color:#8545bc;font-size:28rpx}
.deals-section .more{font-size:19rpx}
.deals-scroll,.category-scroll{width:100%;white-space:nowrap}
.deals-track,.category-track{display:flex;gap:14rpx}
.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.product{min-width:0;background:#fff;border-radius:24rpx;padding:14rpx;box-shadow:0 6rpx 20rpx #50308b0c;display:flex;gap:14rpx;align-items:center}
.product-media{position:relative;width:108rpx;height:116rpx;flex:0 0 108rpx;border-radius:17rpx;overflow:hidden;background:#f1eafb}
.product-media>image{width:100%;height:100%;display:block}
.product-media .stall-placeholder-choice-shell{transform:scale(.82);transform-origin:top left}
.discount-badge{position:absolute;right:0;top:0;background:#ff4b7e;color:white;border-radius:0 14rpx 0 14rpx;padding:4rpx 8rpx;font-size:17rpx}
.product-copy{min-width:0;flex:1}
.product-name{font-size:26rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.product-description{font-size:20rpx;color:#8d809f;margin:8rpx 0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.product-bottom{display:flex;justify-content:space-between;align-items:center;gap:5rpx}
.product .price{font-size:25rpx}
.product .old{display:block;margin:0;font-size:18rpx}
.product .round-add{width:40rpx;height:40rpx;line-height:40rpx;font-size:27rpx}
.deal-product{flex:0 0 150rpx;display:block;box-sizing:border-box;white-space:normal}
.deal-product .product-media{width:122rpx;height:110rpx}
.deal-product .product-name{font-size:24rpx;margin-top:9rpx}
.deal-product .product-description{display:none}
.deal-product .product-bottom{flex-wrap:wrap}
.feature-swiper{height:190rpx;margin-top:20rpx}
.feature-banner,.category-banner{position:relative;display:flex;align-items:center;justify-content:space-between;overflow:hidden;background:radial-gradient(at 70% 100%,#ec8bbd,transparent 75%),linear-gradient(120deg,#9d41df,#6536dc);border-radius:28rpx;color:#fff;padding:24rpx 30rpx;height:190rpx;box-sizing:border-box;margin-top:20rpx}
.feature-swiper .feature-banner{margin:0;height:190rpx}
.feature-banner image{width:180rpx;height:150rpx;flex-shrink:0;margin-left:20rpx;border-radius:24rpx}
.feature-label{font-size:21rpx;background:#ffffff25;padding:5rpx 16rpx;border-radius:20rpx}
.feature-title{font-size:36rpx;font-weight:750;margin:14rpx 0;max-width:390rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.feature-banner view>view:last-child,.category-banner view:last-child{font-size:24rpx;color:#f6e9ff}
.feature-art{font-size:100rpx;color:#f9d7ff}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx;margin:20rpx 0}
.quick-grid>view{text-align:center;background:white;border-radius:28rpx;box-shadow:0 8rpx 18rpx #50308b0e;padding:15rpx 0;font-size:24rpx}
.quick-grid text{display:block;font-size:40rpx;color:#a45cea;margin-bottom:5rpx}
.category{min-width:94rpx;max-width:160rpx;overflow:hidden;text-overflow:ellipsis;text-align:center;border-radius:23rpx;background:#fff;padding:15rpx 12rpx;font-size:23rpx;color:#54416a}
.category text{display:block;font-size:35rpx;color:#9b72df;margin-bottom:8rpx}
.category.active,.side-category.active{color:#fff;background:linear-gradient(135deg,#9d66f1,#4b2ac2);box-shadow:0 8rpx 20rpx #6b3ac72a}
.category.active text{color:white}
.share-shop,.load-more{margin:24rpx auto;font-size:24rpx;color:#7842d0;background:#eee6fb;border-radius:30rpx}
.category-page{padding:0 18rpx 30rpx}
.category-layout{display:flex;gap:18rpx;align-items:flex-start}
.category-sidebar{width:184rpx;flex:0 0 184rpx;height:calc(100vh - 390rpx);background:#f1ecfa;border-radius:26rpx;padding-top:8rpx}
.side-category{display:flex;align-items:center;gap:12rpx;margin:10rpx 6rpx;padding:23rpx 14rpx;border-radius:24rpx;font-size:25rpx;overflow-wrap:anywhere}
.side-category text{font-size:33rpx;color:#8652da}
.side-category.active text{color:white}
.category-content{flex:1;min-width:0}
.category-banner{height:195rpx;display:block;margin:0;padding:24rpx}
.category-toolbar{display:flex;justify-content:space-between;align-items:center;gap:8rpx;font-size:23rpx;margin-top:26rpx;font-weight:650}
.category-toolbar>view{color:#807192;font-size:21rpx;flex-shrink:0}
.filter-line{color:#8054bf;font-size:23rpx;padding:18rpx 0}
.category-content .product-grid{grid-template-columns:1fr;gap:16rpx}
.category-content .product{min-height:146rpx;padding:16rpx}
.category-content .product-media{width:122rpx;height:126rpx;flex-basis:122rpx}
.category-content .product-name{font-size:28rpx}
.category-content .product .price{font-size:29rpx}
.category-content .product .old{display:inline;font-size:19rpx;margin-left:8rpx}
.category-content .product .round-add{width:48rpx;height:48rpx;line-height:48rpx}
.category-content .product-description{font-size:22rpx}


.category .category-icon{display:block;width:38rpx;height:38rpx;margin:0 auto 10rpx}.side-category .category-icon{width:36rpx;height:36rpx;flex:0 0 36rpx}
