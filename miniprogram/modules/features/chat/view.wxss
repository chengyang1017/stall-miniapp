.support-page{height:100vh;display:flex;flex-direction:column;background:var(--brand-background);box-sizing:border-box}.support-tip{font-size:23rpx;line-height:1.6;color:var(--brand-muted);background:var(--brand-background);padding:18rpx 24rpx}.support-messages{flex:1;height:0;box-sizing:border-box;padding:24rpx}.support-empty{color:var(--brand-muted);text-align:center;padding:50rpx 0;font-size:27rpx}.support-line{display:flex;flex-direction:column;align-items:flex-start;margin:18rpx 0}.support-line.mine{align-items:flex-end}.support-meta{font-size:21rpx;color:var(--brand-muted);margin-bottom:8rpx}.support-bubble{background:white;border-radius:18rpx;padding:20rpx 24rpx;max-width:80%;font-size:29rpx;line-height:1.6;word-break:break-all;white-space:pre-wrap}.support-line.mine .support-bubble{background:var(--brand-background)}.support-compose{display:flex;align-items:center;gap:14rpx;background:#fff;padding:16rpx 22rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--brand-background)}.support-input{flex:1;min-height:64rpx;max-height:170rpx;border:1rpx solid var(--brand-background);border-radius:16rpx;background:var(--brand-background);padding:12rpx 18rpx;box-sizing:border-box;font-size:27rpx}.support-compose button{flex-shrink:0;background:var(--brand-primary);margin:0}
