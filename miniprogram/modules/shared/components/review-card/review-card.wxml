<view class="review-card"><view class="heading">{{row.productName}} · {{row.rating}} / 5 星 <text wx:if="{{row.verifiedPurchase}}">已购评价</text></view><view class="body">{{row.content || '仅评分，未填写文字'}}</view><view class="time">{{row.displayTime}}</view><button wx:if="{{row.imageIds.length}}" size="mini" bindtap="images">查看评价图片（{{row.imageIds.length}}）</button><view wx:if="{{row.reply}}" class="reply">商家已审核回复：{{row.reply}}</view></view>
