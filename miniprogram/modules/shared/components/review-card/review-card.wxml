<view class="review-card"><view wx:if="{{customerSummary}}" class="heading customer-heading"><text class="review-author">{{row.testReview ? 'Sandbox 测试顾客' : row.verifiedPurchase ? '匿名已购顾客' : '匿名顾客'}}</text><text class="review-rating">{{row.rating}} / 5 星</text></view><view wx:else class="heading">{{row.productName}} · {{row.rating}} / 5 星 <text wx:if="{{row.testReview}}">测试评价</text><text wx:elif="{{row.verifiedPurchase}}">已购评价</text></view><view class="body">{{row.content || '仅评分，未填写文字'}}</view><view class="time">{{row.displayTime}}</view><button wx:if="{{row.imageIds.length}}" size="mini" bindtap="images">查看评价图片（{{row.imageIds.length}}）</button><view wx:if="{{row.reply}}" class="reply">商家回复：{{row.reply}}</view></view>
