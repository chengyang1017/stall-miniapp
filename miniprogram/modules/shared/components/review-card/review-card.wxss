.review-card{padding:22rpx 0;border-bottom:1rpx solid #eee6f6;line-height:1.7;word-break:break-all}.heading{font-weight:600;font-size:27rpx}.heading text{font-size:22rpx;color:#8050c1;margin-left:14rpx}.body{font-size:27rpx;margin:12rpx 0;white-space:pre-wrap}.time{font-size:22rpx;color:#9885a5}.reply{padding:16rpx;background:#f5effc;border-radius:12rpx;font-size:25rpx;margin-top:12rpx}button{margin:10rpx 0;color:#8252bf;background:#f6f1fc}
.customer-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.customer-heading text{margin-left:0}.customer-heading .review-author{color:#625170;font-size:25rpx}.customer-heading .review-rating{font-size:23rpx;color:#8350c8}
