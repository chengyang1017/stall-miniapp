.reviews{background:#fff;border-radius:26rpx;margin:20rpx 0;padding:28rpx 24rpx 18rpx;box-shadow:0 6rpx 20rpx #61339508;color:#30263d}
.reviews-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.title{font-size:30rpx;font-weight:700;color:#2d223a}.review-total{font-size:22rpx;color:#968aa4}
.review-score{display:flex;align-items:center;gap:18rpx;padding:20rpx 0 23rpx;border-bottom:1rpx solid #f2eef7}
.score-number{font-size:62rpx;font-weight:800;color:#6a35d5;line-height:1.1;min-width:100rpx}
.score-detail{flex:1;min-width:0}.score-stars{font-size:30rpx;letter-spacing:4rpx;color:#f2a72b;line-height:1.4}.score-caption{font-size:22rpx;color:#8c7d9b;margin-top:4rpx}
.sandbox-tag{font-size:19rpx;padding:6rpx 12rpx;border-radius:24rpx;color:#7951b5;background:#f4edfc;white-space:nowrap}
.filter-scroll{padding-top:20rpx}.filter-scrollview{width:100%;white-space:nowrap}.filter-row{display:flex;gap:12rpx;padding-bottom:10rpx;min-width:max-content}
.filter-chip{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;padding:10rpx 23rpx;border-radius:30rpx;background:#f6f5f8;color:#766b81;font-size:23rpx;line-height:34rpx}
.filter-chip-selected{background:#6f3ed6;color:#fff;font-weight:600}
.reviews-list{display:block}.review-entry{padding:0 0 13rpx;margin-top:12rpx;border-bottom:1rpx solid #f2eef6}.review-entry:last-child{border-bottom:0}
.report-actions{display:flex;justify-content:flex-end;gap:24rpx;font-size:20rpx;color:#a498b0;padding:0 3rpx 8rpx}
.review-error{padding:16rpx;background:#fff4f3;border-radius:12rpx;color:#b53636;font-size:23rpx;margin-top:18rpx;line-height:1.6}.error-actions{display:flex;gap:30rpx;color:#7742c8;margin-top:9rpx;font-weight:600}
.reviews-empty{font-size:24rpx;color:#9b8da7;padding:28rpx 0;text-align:center}
.all-reviews{display:flex;align-items:center;justify-content:center;gap:12rpx;font-size:24rpx;font-weight:600;color:#7042bc;background:#f7f3fd;padding:18rpx;border-radius:15rpx;margin-top:8rpx}.all-reviews text{font-size:32rpx;line-height:1}
.review-bottom{display:flex;align-items:center;justify-content:center;gap:16rpx;color:#8263b0;font-size:22rpx;padding:17rpx 0 3rpx}
.report{background:#faf7fe;border-radius:17rpx;padding:19rpx;margin-top:12rpx}.report-title{font-size:25rpx;font-weight:650;color:#4e366b}.report textarea{width:100%;min-height:142rpx;margin-top:13rpx;padding:12rpx;box-sizing:border-box;background:#fff;border-radius:11rpx;font-size:24rpx}.report-buttons{display:flex;gap:10rpx}.report button,.review-bottom button{font-size:23rpx;background:#f2eafb;color:#7144b3;margin:10rpx 0 0}
