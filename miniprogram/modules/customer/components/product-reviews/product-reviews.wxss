.reviews{background:#fff;border-radius:26rpx;margin:20rpx 0;padding:24rpx;line-height:1.7;box-shadow:0 6rpx 20rpx #61339508}
.reviews-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.title{font-size:29rpx;font-weight:700}.title text{font-size:24rpx;color:#9b8aa9}.view-all{font-size:23rpx;color:#8252bf}.rating-summary{font-size:28rpx;font-weight:650;color:#7941cb;margin-top:10rpx}.rating-summary text{font-size:22rpx;font-weight:400;color:#9a89a9}.filter{background:#f5f0fc;padding:12rpx;border-radius:12rpx;margin:15rpx 0;font-size:24rpx;color:#8056ad}.error{color:#b53636;font-size:24rpx}.reviews-empty{font-size:24rpx;color:#9a8ba8;padding:16rpx 0}.report-actions{display:flex;gap:25rpx;color:#a293ad;font-size:20rpx}.report{background:#f8f4fc;padding:16rpx;border-radius:14rpx}textarea{width:100%;min-height:150rpx}button{margin:10rpx 8rpx 10rpx 0;background:#f0e7fc;color:#7540bc;font-size:23rpx}
