<view class="reviews">
  <view class="reviews-heading"><view class="title">用户评价<text wx:if="{{summary}}">（{{summary.count}}）</text></view><view wx:if="{{compact && !expanded && rows.length}}" class="view-all" bindtap="expand">查看全部 ›</view></view>
  <view wx:if="{{summary && summary.count}}" class="rating-summary">{{summary.average === null ? '暂无评分' : summary.average + ' / 5'}}<text> · 已购公开评价</text></view>
  <view wx:if="{{!compact || expanded}}"><picker range="{{stars}}" value="{{rating || 0}}" bindchange="filter"><view class="filter">{{stars[rating || 0]}} ›</view></picker></view>
  <view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="refresh">重试</button><button size="mini" bindtap="login">微信登录</button></view>
  <view wx:if="{{loading && !rows.length}}" class="reviews-empty">正在读取评价…</view>
  <view wx:if="{{!loading && !error && !rows.length}}" class="reviews-empty">暂无审核通过的评价</view>
  <block wx:for="{{compact && !expanded ? previewRows : rows}}" wx:key="id"><review-card customer-summary="{{true}}" row="{{item}}" bind:images="images"/><view class="report-actions"><text data-id="{{item.id}}" bindtap="report">举报评价</text><text wx:if="{{item.reply}}" data-id="{{item.id}}" bindtap="reportReply">举报回复</text></view></block>
  <view wx:if="{{reportId}}" class="report"><textarea maxlength="500" placeholder="请说明违规原因；举报不等于自动隐藏评价" value="{{reportReason}}" bindinput="reportInput" disabled="{{reportBusy}}"/><button bindtap="submitReport" disabled="{{reportBusy || !reportReason}}" loading="{{reportBusy}}">提交举报</button><button bindtap="cancelReport" disabled="{{reportBusy}}">取消</button></view>
  <view wx:if="{{!compact || expanded}}"><button wx:if="{{hasMore}}" disabled="{{loading}}" bindtap="more">加载更多评价</button><button size="mini" disabled="{{loading}}" bindtap="refresh">刷新评价</button></view>
</view>
