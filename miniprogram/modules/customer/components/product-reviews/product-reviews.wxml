<view class="reviews"><view class="title">已购商品评价</view><view wx:if="{{summary}}">平均评分 {{summary.average === null ? '暂无' : summary.average}} / 5 · {{summary.count}} 条公开评价</view><view wx:if="{{summary}}" class="distribution"><text wx:for="{{summary.distribution}}" wx:key="rating">{{item.rating}}星 {{item.count}} 条　</text></view><picker range="{{stars}}" value="{{rating || 0}}" bindchange="filter"><view class="filter">{{stars[rating || 0]}} ›</view></picker><view wx:if="{{error}}" class="error">{{error}}<button size="mini" bindtap="login">微信登录</button></view><view wx:if="{{loading}}">正在读取评价…</view><view wx:if="{{!loading && !rows.length}}">暂无审核通过的评价</view><block wx:for="{{rows}}" wx:key="id"><review-card row="{{item}}" bind:images="images"/><button size="mini" data-id="{{item.id}}" bindtap="report">举报评价</button><button wx:if="{{item.reply}}" size="mini" data-id="{{item.id}}" bindtap="reportReply">举报回复</button></block><view wx:if="{{reportId}}" class="report"><textarea maxlength="500" placeholder="请说明违规原因；举报不等于自动隐藏评价" value="{{reportReason}}" bindinput="reportInput" disabled="{{reportBusy}}"/><button bindtap="submitReport" disabled="{{reportBusy || !reportReason}}" loading="{{reportBusy}}">提交举报</button><button bindtap="cancelReport" disabled="{{reportBusy}}">取消</button></view><button wx:if="{{hasMore}}" disabled="{{loading}}" bindtap="more">加载更多评价</button><button size="mini" disabled="{{loading}}" bindtap="refresh">刷新评价</button></view>
