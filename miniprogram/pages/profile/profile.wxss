@import "../../styles/customer-theme.wxss";.profile-header{padding-bottom:75rpx}
.profile-identity{position:relative;z-index:1;display:flex;align-items:center;gap:24rpx;margin-top:36rpx}
.profile-avatar{width:112rpx;height:112rpx;line-height:112rpx;text-align:center;border-radius:50%;border:5rpx solid white;background:linear-gradient(150deg,#e5c5fa,#8e64d7,#5131b9);font-size:70rpx;color:white}
.profile-account{flex:1;min-width:0}
.profile-name{font-size:36rpx;font-weight:700}
.profile-subtitle{font-size:24rpx;color:#e6d9fa;margin-top:12rpx}
.profile-chevron{font-size:40rpx;color:#b19acb}
.profile-body{position:relative;padding:0 24rpx 28rpx;margin-top:-42rpx;z-index:2}
.profile-stats{display:flex;justify-content:space-around;text-align:center;padding:24rpx 12rpx}
.profile-stats>view{flex:1;border-right:1rpx solid #e8def4}
.profile-stats>view:last-child{border:0}
.profile-stats>view>text:first-child{font-size:40rpx;color:#8a51dd}
.profile-stats>view>view{font-size:29rpx;font-weight:700;margin:2rpx 0}
.surface .section-heading{margin:0 0 22rpx}
.profile-orders{display:flex;justify-content:space-between;border-top:1rpx solid #f1ecf8;padding-top:22rpx}
.profile-orders>view{flex:1;text-align:center;font-size:23rpx}
.profile-orders text{display:block;font-size:42rpx;color:#8350d3;margin-bottom:12rpx}
.profile-links .service-row{min-height:80rpx}
.merchant-entry{display:flex;align-items:center;gap:20rpx;font-weight:650;font-size:29rpx}
.merchant-entry>view{flex:1}
.help-grid{display:grid;grid-template-columns:repeat(4,1fr);text-align:center;border-top:1rpx solid #f1ecf8;padding-top:18rpx;font-size:24rpx}
.help-grid text{display:block;font-size:40rpx;color:#8350d3;margin-bottom:10rpx}
.account-controls button{background:#eee5fb;color:#6d35cb;border-radius:30rpx;font-size:25rpx}


.login-dialog{margin-top:20rpx;padding:28rpx;border:1rpx solid #e5d8f5;border-radius:24rpx;background:#fff}
.login-dialog-title{font-weight:700;font-size:34rpx;color:#392260}
.login-dialog-subtitle{font-size:24rpx;color:#7d718a;margin:10rpx 0 24rpx}
.login-methods{display:flex;gap:12rpx;margin-bottom:24rpx}
.login-method{flex:1;text-align:center;border:1rpx solid #ddd4ea;border-radius:18rpx;padding:18rpx 8rpx;font-size:26rpx;color:#6a5d77}
.login-method.active{background:#f0e8ff;border-color:#7847ca;color:#6530bc;font-weight:700}
.account-controls .wechat-login-button{background:#07b75a;color:white}
.account-controls .sms-login-button{background:#e7e0ee;color:#685c76}
.phone-input-row{display:flex;align-items:center;gap:22rpx;padding:20rpx 16rpx;border:1rpx solid #dfd4ea;border-radius:18rpx;margin-bottom:16rpx}
.phone-input-row text{font-weight:700;color:#352744}
.phone-input-row input{flex:1;min-width:0;font-size:28rpx}
.login-hint{font-size:22rpx;color:#82788b;line-height:1.7;margin:16rpx 0}
.account-controls .login-close{background:transparent;color:#776a85}
