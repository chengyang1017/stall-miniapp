<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-avatar">我</view>
    <view class="profile-identity">
      <view class="profile-name">我的</view>
      <view class="profile-subtitle">订单与配送信息管理</view>
    </view>
  </view>
  <view class="profile-section">
    <navigator class="profile-link" url="/pages/addresses/addresses">
      <view class="profile-glyph">⌂</view><view class="profile-link-content"><view class="profile-title">收货地址</view><view class="profile-desc">管理常用配送地址</view></view><view class="profile-chevron">›</view>
    </navigator>
    <view class="profile-link" bindtap="openOrders">
      <view class="profile-glyph">☷</view><view class="profile-link-content"><view class="profile-title">我的订单</view><view class="profile-desc">查看订单和配送进度</view></view><view class="profile-chevron">›</view>
    </view>
    <navigator class="profile-link profile-contact" url="/pages/customer-support-chat/customer-support-chat">
      <view class="profile-glyph">✉</view><view class="profile-link-content"><view class="profile-title">联系商家<text wx:if="{{cloudSupport}}"> · 未读 {{supportUnread === null ? '—' : supportUnread}}</text></view><view class="profile-desc">向商家发送消息</view></view><view class="profile-chevron">›</view>
    </navigator>
    <navigator class="profile-link" url="/pages/customer-reviews/customer-reviews"><view class="profile-glyph">☆</view><view class="profile-link-content"><view class="profile-title">我的商品评价</view><view class="profile-desc">查看审核、修改或撤回自己的评价</view></view><view class="profile-chevron">›</view></navigator>
  </view>
  <view class="profile-section">
    <view wx:if="{{merchantAuthorized}}" class="profile-link" bindtap="openMerchant"><view class="profile-glyph">▣</view><view class="profile-link-content"><view class="profile-title">商家工作台</view><view class="profile-desc">通过商家权限验证后显示</view></view><view class="profile-chevron">›</view></view>
    <navigator class="profile-link" url="/pages/customer-settings/customer-settings">
      <view class="profile-glyph">⚙</view><view class="profile-link-content"><view class="profile-title">设置</view><view class="profile-desc">偏好与隐私说明</view></view><view class="profile-chevron">›</view>
    </navigator>
  </view>
  <view class="profile-note">{{cloudSupport ? '客服使用当前云端店铺，需微信身份登录' : '本地演示客服消息只保存在当前设备'}}</view>
</view>
