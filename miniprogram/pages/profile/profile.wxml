<view class="profile-page">
<view class="customer-hero profile-header">
<view class="hero-title">我的</view>
<view class="hero-subtitle">管理账户 · 查看订单 · 享受服务</view>
<view class="profile-identity" bindtap="showLogin">
<view class="profile-avatar avatar-{{avatarStyle}}"><image wx:if="{{avatarPhotoPath}}" src="{{avatarPhotoPath}}" mode="aspectFill" class="profile-avatar-photo"/><text wx:else>♙</text></view>
<view class="profile-account">
<view class="profile-name">{{accountName}}</view>
<view class="profile-subtitle">{{accountSubtitle}}</view>
</view>
<text class="profile-chevron">›</text>
</view>
</view>
<view class="profile-body">
<view wx:if="{{libraryError}}" class="notice">{{libraryError}}</view>
<view class="surface profile-stats">
<view bindtap="openFavorites">
<text>♡</text>
<view>{{favoriteCount === null ? '—' : favoriteCount}}</view>
<text class="muted">我的收藏</text>
</view>
<view bindtap="unavailable">
<text>♧</text>
<view>—</view>
<text class="muted">优惠券</text>
</view>
<view bindtap="unavailable">
<text>◎</text>
<view>—</view>
<text class="muted">积分</text>
</view>
</view>
<view class="surface">
<view class="section-heading" bindtap="openOrders">
<text>▤ 我的订单</text>
<text class="more">查看全部 ›</text>
</view>
<view class="profile-orders">
<view wx:for="{{orderEntries}}" wx:key="label" data-tab="{{item.tab}}" data-fulfillment="{{item.fulfillment}}" bindtap="openOrders">
<text>{{item.icon}}</text>
<view>{{item.label}}</view>
</view>
</view>
</view>
<view class="surface profile-links">
<navigator class="service-row" url="/pages/addresses/addresses">
<text class="service-icon">⌖</text>收货地址<text class="value">›</text>
</navigator>
<view class="service-row" bindtap="unavailable">
<text class="service-icon">♧</text>我的优惠券<text class="value">暂未开通 ›</text>
</view>
<view class="service-row" bindtap="unavailable">
<text class="service-icon">◎</text>积分中心<text class="value">暂未开通 ›</text>
</view>
<view class="service-row" bindtap="openFavorites">
<text class="service-icon">♡</text>我的收藏<text class="value">{{favoriteCount === null ? '—' : favoriteCount}} ›</text>
</view>
<view class="service-row" bindtap="openHistory">
<text class="service-icon">◷</text>浏览记录<text class="value">{{historyCount === null ? '—' : historyCount}} ›</text>
</view>
<navigator class="service-row" url="/pages/customer-reviews/customer-reviews">
<text class="service-icon">☆</text>我的商品评价<text class="value">›</text>
</navigator>
</view>
<view wx:if="{{merchantAuthorized}}" class="surface merchant-entry" bindtap="openMerchant">
<text class="service-icon">♧</text>
<view>
<view>商家工作台</view>
<text class="muted">在线管理店铺与商品</text>
</view>
<text class="profile-chevron">›</text>
</view>
<view class="surface">
<view class="section-heading">帮助与服务</view>
<view class="help-grid">
<navigator url="/pages/customer-support-chat/customer-support-chat">
<text>♧</text>联系商家<view wx:if="{{cloudSupport && supportUnread !== null}}" class="muted">未读 {{supportUnread}}</view>
</navigator>
<view data-kind="faq" bindtap="serviceInfo">
<text>?</text>常见问题</view>
<navigator url="/pages/customer-support-chat/customer-support-chat">
<text>♧</text>意见反馈</navigator>
<view data-kind="about" bindtap="serviceInfo">
<text>ⓘ</text>关于我们</view>
</view>
</view>
<view wx:if="{{customerPhoneSessionActive}}" class="surface account-controls"><view class="service-row"><text class="service-icon">✓</text>手机号顾客身份已连接<text class="value">独立会话</text></view><view class="service-row" bindtap="logoutPhoneSession"><text class="service-icon">⇥</text>退出手机号顾客会话<text class="value">›</text></view></view>
<view class="surface account-controls">
<navigator wx:if="{{loggedIn}}" class="service-row" url="/pages/customer-account/customer-account"><text class="service-icon">♙</text>个人资料<text class="value">›</text></navigator>\n<view wx:if="{{loggedIn}}" class="service-row" bindtap="logout"><text class="service-icon">⇥</text>退出登录<text class="value">›</text></view>
<navigator class="service-row" url="/pages/customer-settings/customer-settings">
<text class="service-icon">⚙</text>设置与隐私<text class="value">›</text>
</navigator>
</view>
<view wx:if="{{phonePreview}}" class="notice">Staging 真机预览 · 非生产环境</view>
</view>
</view>
<view wx:if="{{loginPanel}}" class="login-overlay" catchtap="closeLogin">
  <view class="login-sheet" catchtap="keepLoginOpen">
<view class="login-dialog">
  <view class="login-dialog-title">登录账号</view>
  <view class="login-dialog-subtitle">选择适合你的登录方式</view>
  <view class="login-methods">
    <view class="login-method {{loginMethod === 'wechat' ? 'active' : ''}}" data-method="wechat" bindtap="selectLoginMethod">微信快捷登录</view>
    <view class="login-method {{loginMethod === 'phone' ? 'active' : ''}}" data-method="phone" bindtap="selectLoginMethod">手机号登录</view>
  </view>
  <view wx:if="{{loginMethod === 'wechat'}}">
    <button class="wechat-login-button" loading="{{loginBusy}}" disabled="{{loginBusy}}" bindtap="loginWechat">使用微信账号登录</button>
    <view class="login-hint">通过微信官方登录凭证验证身份，不获取手机号</view>
  </view>
  <view wx:else>
    <view class="phone-input-row"><text>+86</text><input type="number" maxlength="11" placeholder="请输入中国大陆手机号" value="{{phoneNumber}}" bindinput="onPhoneInput"/></view>
    <button class="sms-login-button" bindtap="requestSmsCode" loading="{{smsBusy}}" disabled="{{smsBusy || smsLoginBusy}}">获取短信验证码</button>
    <view class="phone-input-row"><text>验证码</text><input type="number" maxlength="6" placeholder="请输入6位验证码" value="{{smsCode}}" bindinput="onSmsCodeInput"/></view>
    <button class="sms-login-button" bindtap="loginWithSms" loading="{{smsLoginBusy}}" disabled="{{smsLoginBusy || smsBusy}}">使用短信验证码登录</button>
    <button class="wechat-login-button" open-type="getPhoneNumber" bindgetphonenumber="loginWithWechatPhone" loading="{{customerPhoneLoginBusy}}" disabled="{{customerPhoneLoginBusy}}">通过微信授权已绑定的手机号登录（测试）</button>
    <view wx:if="{{customerPhoneLoginStatus}}" class="login-hint">{{customerPhoneLoginStatus}}</view>
    <view class="login-hint">短信验证码登录仅在服务端完成腾讯云配置及审核后开放；未启用时可使用微信授权手机号登录</view>
  </view>
  <view wx:if="{{loginStatus}}" class="notice">{{loginStatus}}</view>
  <button class="login-close" disabled="{{loginBusy}}" bindtap="closeLogin">返回</button>
</view>
  </view>
</view>


<!-- First WeChat login: separate user-initiated official phone consent. -->
<view wx:if="{{phoneOnboarding}}" class="login-overlay" catchtap="dismissPhoneOnboarding">
  <view class="login-sheet" catchtap="keepLoginOpen">
    <view class="login-dialog">
      <view class="login-dialog-title">完成手机号绑定</view>
      <view class="login-dialog-subtitle">微信身份已登录。授权中国大陆 +86 手机号后，会与同一个商家账号关联，下次无需重复绑定。</view>
      <button class="wechat-login-button" open-type="getPhoneNumber" bindgetphonenumber="bindFirstLoginPhone" loading="{{phoneBindBusy}}" disabled="{{phoneBindBusy}}">授权手机号并完成绑定</button>
      <view wx:if="{{phoneBindStatus}}" class="notice">{{phoneBindStatus}}</view>
      <view class="login-hint">仅在你主动同意后获取微信验证的手机号；不会自动合并其他账号。</view>
      <button class="login-close" disabled="{{phoneBindBusy}}" bindtap="dismissPhoneOnboarding">稍后再绑定</button>
    </view>
  </view>
</view>
