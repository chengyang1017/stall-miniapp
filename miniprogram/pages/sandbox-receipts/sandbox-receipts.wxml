<view class="receipt-history">
  <view class="receipt-intro">
    <view class="receipt-title">我的电子小票</view>
    <view wx:if="{{sandboxMode}}" class="receipt-test-notice">
      <text class="receipt-test-badge">测试环境</text>
      <text>仅供查看当前店铺的 Stripe Sandbox 测试交易，不代表真实收款。</text>
    </view>
    <view wx:elif="{{liveMode}}" class="receipt-hint">仅展示当前账号在本店的微信支付验真记录。电子小票不是税务发票。</view>
    <view wx:else class="receipt-hint">电子小票暂未开放，付款情况请以订单详情为准。</view>
    <button size="mini" bindtap="loadMore" wx:if="{{hasMore}}" disabled="{{loading}}">读取更多订单</button>
  </view>
  <view wx:if="{{error}}" class="receipt-error">{{error}}</view>
  <view wx:if="{{loading}}" class="receipt-loading">正在核对电子小票…</view>
  <view wx:if="{{!loading && !receipts.length && !hasMore && !error}}" class="receipt-empty">暂无已核验电子小票</view>
  <view wx:if="{{!loading && !receipts.length && hasMore}}" class="receipt-empty">当前已加载的订单暂无小票，可继续读取历史订单</view>

  <view wx:for="{{receipts}}" wx:key="id" wx:for-item="receipt" class="receipt-card">
    <view class="receipt-card-top">
      <view class="receipt-pay-logo">¥</view>
      <view class="receipt-payment-info">
        <view class="receipt-head">{{receipt.channelText}}</view>
        <view class="receipt-paid-date">{{receipt.paidAt}}</view>
      </view>
      <view class="receipt-paid-amount">¥{{receipt.totalText}}</view>
    </view>
    <view wx:if="{{receipt.sandbox}}" class="receipt-mode-note">Stripe Sandbox 测试交易 · 非真实付款</view>
    <view wx:else class="receipt-live-note">微信支付已通过服务器核验 · 非税务发票</view>
    <view class="receipt-order-id">订单 {{receipt.orderId}}</view>
    <view wx:for="{{receipt.items}}" wx:key="productId" wx:for-item="line" class="receipt-line">
      <text class="receipt-product-name">{{line.name}} × {{line.quantity}}</text>
      <text>¥{{line.lineTotalText}}</text>
    </view>
    <view class="receipt-line receipt-money-line"><text>商品小计</text><text>¥{{receipt.subtotalText}}</text></view>
    <view class="receipt-line receipt-money-line"><text>配送费</text><text>¥{{receipt.deliveryFeeText}}</text></view>
    <view wx:if="{{!receipt.sandbox}}" class="receipt-refund">
      <view class="receipt-line"><text>已确认退款</text><text>¥{{receipt.refundedText}}</text></view>
      <view wx:if="{{receipt.refundPendingCents > 0}}" class="receipt-line"><text>待核验退款</text><text>¥{{receipt.refundPendingText}}</text></view>
      <view class="receipt-line receipt-net"><text>扣除已成功退款后</text><text>¥{{receipt.netText}}</text></view>
    </view>
    <view class="receipt-reference">交易参考：{{receipt.transactionId}}</view>
    <view class="receipt-reference">校验摘要：{{receipt.sha256}}</view>
    <view class="receipt-actions">
      <button class="receipt-copy" size="mini" data-id="{{receipt.id}}" bindtap="copyReceipt">复制小票</button>
      <button class="receipt-open" size="mini" data-order="{{receipt.orderId}}" bindtap="openOrder">查看订单</button>
    </view>
  </view>
  <button wx:if="{{hasMore}}" class="receipt-more" disabled="{{loading}}" loading="{{loading}}" bindtap="loadMore">加载更多订单与小票</button>
  <view wx:if="{{!hasMore && receipts.length}}" class="receipt-hint receipt-finish">已读取全部订单</view>
</view>
