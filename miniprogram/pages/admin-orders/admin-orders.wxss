page{background:#f5f6f8}.page{padding:28rpx;padding-bottom:100rpx}.heading{font-size:36rpx;font-weight:700;margin-bottom:20rpx}.notice,.empty{font-size:25rpx;color:#777;line-height:1.6;margin-bottom:20rpx}.card{background:#fff;padding:26rpx;border-radius:16rpx;margin-bottom:20rpx}.row{display:flex;justify-content:space-between;gap:14rpx}.id{font-size:24rpx;word-break:break-all}.state{font-size:25rpx;color:#16865d;flex-shrink:0}.muted{font-size:25rpx;color:#666;margin-top:12rpx;overflow-wrap:anywhere}.item{font-size:27rpx;margin-top:16rpx;border-bottom:1rpx solid #eee;padding-bottom:12rpx}.total{text-align:right;font-size:29rpx;font-weight:700;color:var(--brand-primary);margin-top:14rpx}.eta{margin-top:20rpx;font-size:26rpx}.eta input{height:78rpx;background:#f5f6f8;padding:0 16rpx;border-radius:10rpx;margin-top:10rpx}.eta button{margin:12rpx 0}.next{margin-top:20rpx}

/* Status tabs (order-status-tabs-v1) */
.order-tabs-scroll { width: 100%; white-space: nowrap; margin: 20rpx 0 24rpx; }
.order-tabs-inner { display: flex; flex-direction: row; width: max-content; gap: 14rpx; padding: 4rpx 0 12rpx; }
.order-tab { display: flex; flex-direction: row; align-items: center; gap: 8rpx; flex-shrink: 0; padding: 16rpx 20rpx; background: #fff; color: var(--brand-muted); border-radius: 999rpx; border: 2rpx solid var(--brand-background); font-size: 25rpx; }
.order-tab-active { background: var(--brand-primary); border-color: var(--brand-primary); color: #fff; font-weight: 600; }
.order-tab-count { min-width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center; padding: 0 5rpx; border-radius: 20rpx; background: var(--brand-background); color: var(--brand-primary); font-size: 20rpx; }
.order-tab-active .order-tab-count { color: var(--brand-primary); background: #fff; }
/* ORDER_SEARCH_V1 */
.order-search-wrap { margin: 18rpx 0 8rpx; }
.order-search-box { display:flex; align-items:center; min-height:82rpx; padding:0 22rpx; background:#fff; border:2rpx solid var(--brand-background); border-radius:18rpx; box-sizing:border-box; }
.order-search-icon { font-size:39rpx; margin-right:14rpx; color:var(--brand-muted); }
.order-search-input { flex:1; min-width:0; font-size:27rpx; color:var(--brand-text); }
.order-search-clear { flex-shrink:0; font-size:24rpx; color:var(--brand-primary); margin-left:14rpx; padding:14rpx 4rpx; }
.order-search-count { font-size:23rpx; color:var(--brand-muted); padding:12rpx 4rpx 0; }
/* ADMIN_ORDER_DATE_FILTER_V1 */
.admin-order-date-bar { display:flex; align-items:center; flex-wrap:wrap; gap:14rpx; padding:16rpx 4rpx; }
.admin-order-date-label { font-size:25rpx; color:var(--brand-muted); }
.admin-order-date-select { padding:14rpx 20rpx; border:2rpx solid var(--brand-background); background:#fff; border-radius:13rpx; font-size:26rpx; color:var(--brand-primary); }
.admin-order-date-clear { font-size:24rpx; color:var(--brand-primary); padding:12rpx 4rpx; }
/* ADMIN_ORDER_TODAY_BUTTON_V1 */
.admin-order-today-btn { padding: 14rpx 22rpx; border-radius: 13rpx; background: var(--brand-background); color: var(--brand-primary); font-size: 26rpx; font-weight: 600; }
.admin-order-today-btn:active { opacity: .65; }
.order-store-counts{padding:16rpx 0;font-size:27rpx;color:var(--brand-primary);font-weight:600}.admin-order-date-bar{flex-wrap:wrap}.admin-order-date-bar button{margin:0}.order-query-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin:16rpx 0}.order-query-actions button{margin:0;font-size:24rpx}.order-batch-panel{position:sticky;top:0;z-index:5;background:var(--brand-background);border-radius:14rpx;padding:20rpx;margin:18rpx 0}.order-selected{box-shadow:inset 0 0 0 2rpx var(--brand-primary)}.order-selection{display:flex;align-items:center;padding:10rpx 0 18rpx;font-size:25rpx}.order-selection checkbox{pointer-events:none;transform:scale(.85)}.order-batch-failure{font-size:23rpx;color:#9b592a;overflow-wrap:anywhere;padding:8rpx 0}.order-action-disabled{pointer-events:none;opacity:.5}.order-page-footer{display:flex;flex-direction:column;align-items:center;gap:18rpx;padding:24rpx 8rpx 60rpx;font-size:24rpx;color:var(--brand-muted)}.order-page-footer button{width:100%}.id{overflow-wrap:anywhere;word-break:break-all}

