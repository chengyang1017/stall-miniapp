<view class="support-page">
  <view class="support-tip">客服收件箱（本地演示）。当前仅有一条本机测试会话，不支持跨设备或多位顾客。</view>
  <scroll-view class="support-messages" scroll-y="true" scroll-into-view="{{bottomId}}">
    <view wx:if="{{messages.length === 0}}" class="support-empty">暂时没有顾客消息。</view>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="support-line {{item.mine ? 'mine' : 'other'}}">
      <view class="support-meta">{{item.mine ? '商家' : '顾客'}} · {{item.time}}</view>
      <view class="support-bubble">{{item.content}}</view>
    </view>
  </scroll-view>
  <view class="support-compose"><textarea class="support-input" maxlength="500" auto-height value="{{draft}}" placeholder="回复顾客（最多500字）" bindinput="onInput"/><button type="primary" size="mini" bindtap="send">回复</button></view>
</view>
