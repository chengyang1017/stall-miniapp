<view class="product-manage-page"><view wx:if="{{presentationError}}" style="padding:16rpx;color:#a44;font-size:24rpx">{{presentationError}}</view>
  <view wx:if="{{cloudLoading}}" style="padding:22rpx">正在读取商品和分类…</view>
  <view wx:if="{{cloudError}}" style="padding:22rpx;color:#b33">{{cloudError}}</view>
  <view class="product-manage-header">
    
    <view class="product-manage-header-actions">
      <button wx:if="{{products.length || batchMode}}" size="mini" bindtap="toggleBatchMode" disabled="{{batchBusy || cloudLoading || queryDirty}}">{{batchMode ? '退出批量管理' : '批量管理'}}</button>
      <button wx:if="{{!batchMode}}" size="mini" type="primary" bindtap="openNewProduct">+ 新增商品</button>
    </view>
  </view>
  <view class="product-query-panel">
    <view class="product-query-search">
      <text class="product-search-icon">⌕</text>
      <input value="{{searchText}}" bindinput="inputSearch" bindconfirm="searchProducts" confirm-type="search" maxlength="100" placeholder="搜索商品名称或分类" disabled="{{batchBusy}}" />
      <text wx:if="{{searchText}}" class="product-search-clear" bindtap="clearSearch">×</text>
      <text class="product-search-submit" bindtap="searchProducts">搜索</text>
    </view>
    <view class="product-filter-toggle" bindtap="toggleProductFilters" role="button" aria-label="展开或收起商品筛选"><text>分类与筛选</text><text class="product-filter-current">{{categoryFilters[categoryFilterIndex].name}} · {{filtersExpanded ? "收起 ▲" : "展开 ▼"}}</text></view>
    <view wx:if="{{filtersExpanded}}" class="product-query-filters">
      <picker mode="selector" range="{{categoryFilters}}" range-key="name" value="{{categoryFilterIndex}}" bindchange="chooseQueryCategory" disabled="{{batchBusy}}">
        <view class="product-query-choice"><text>商品分类</text><text>{{categoryFilters[categoryFilterIndex].name}} ▾</text></view>
      </picker>
      <picker wx:for="{{queryControls}}" wx:key="key" mode="selector" range="{{item.labels}}" value="{{item.index}}" data-key="{{item.key}}" bindchange="chooseQueryFilter" disabled="{{batchBusy}}">
        <view class="product-query-choice"><text>{{item.label}}</text><text>{{item.labels[item.index]}} ▾</text></view>
      </picker>
    </view>
    <view class="product-query-actions">
      <button size="mini" type="primary" bindtap="searchProducts" disabled="{{batchBusy}}">搜索／刷新</button>
      <button size="mini" bindtap="resetQuery" disabled="{{batchBusy}}">重置条件</button>
    </view>
    <text wx:if="{{queryDirty}}" class="product-query-pending">{{refreshRequired ? '数据已变化，请刷新后再操作。' : '搜索内容已修改，请点击搜索。旧结果暂不能操作。'}}</text>
  </view>
  <view class="product-list-heading"><text>商品列表</text><text>{{entries.length}} 条</text></view>
  <view wx:if="{{batchMode}}" class="product-batch-panel">
    <view class="product-batch-summary">
      <text>已选 {{batchSelectedCount}} / {{products.length}} 件商品</text>
      <button size="mini" bindtap="toggleBatchAll" disabled="{{batchBusy || cloudLoading || !products.length}}">{{batchAllSelected ? '取消全选' : '全选'}}</button>
    </view>
    <text class="product-batch-hint">点击已加载的正式商品勾选，草稿不可勾选；售罄操作仅修改商家手动状态，不增加库存，零库存仍不可购买。</text>
    <view class="product-batch-actions">
      <button bindtap="runBatchAction" data-action="activate" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty || !batchSelectedCount || cloudError}}">上架（{{batchSelectedCount}}）</button>
      <button bindtap="runBatchAction" data-action="deactivate" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty || !batchSelectedCount || cloudError}}">下架（{{batchSelectedCount}}）</button>
      <button bindtap="runBatchAction" data-action="soldOut" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty || !batchSelectedCount || cloudError}}">标记售罄（{{batchSelectedCount}}）</button>
      <button bindtap="runBatchAction" data-action="inStock" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty || !batchSelectedCount || cloudError}}">恢复有货（{{batchSelectedCount}}）</button>
    </view>
    <picker mode="selector" range="{{categories}}" range-key="name" bindchange="chooseBatchCategory" disabled="{{batchBusy || cloudLoading || !categories.length}}">
      <view class="product-batch-category">{{batchCategoryName ? '目标分类：' + batchCategoryName : (categories.length ? '请选择目标分类 ›' : '暂无可用分类')}}</view>
    </picker>
    <button class="product-batch-category-submit" bindtap="runBatchAction" data-action="category" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty || !batchSelectedCount || !batchCategoryId || cloudError}}">修改分类（{{batchSelectedCount}} 件）</button>
    <text wx:if="{{batchBusy}}" class="product-batch-feedback">{{batchProgress || '等待确认…'}} 已选 {{batchSelectedCount}} 件，请勿重复操作。</text>
  </view>
  <view wx:if="{{batchResult}}" class="product-batch-result">{{batchResult}}</view>
  <view wx:if="{{!cloudLoading && !cloudError && entries.length === 0 && !queryDirty}}" class="product-manage-empty">没有符合当前条件的商品或草稿</view>
  <view wx:for="{{entries}}" wx:key="entryKey">
    <view wx:if="{{item.kind === 'draft'}}" class="product-draft-card">
      <text class="product-manage-name">{{item.payload.productName || '未命名草稿'}}</text>
      <text class="product-draft-label">草稿 · 顾客不可见 · 不参与批量操作</text>
      <view class="product-draft-actions">
        <button size="mini" data-id="{{item.id}}" bindtap="openDraft" disabled="{{batchMode || batchBusy || cloudLoading || queryDirty}}">继续编辑</button>
        <button size="mini" data-id="{{item.id}}" bindtap="discardDraft" disabled="{{batchMode || batchBusy || cloudLoading || queryDirty}}">放弃草稿</button>
      </view>
    </view>
  <view wx:else class="product-manage-row product-card-click-v1 {{batchMode && batchSelected[item.id] ? 'product-batch-selected' : ''}}" data-id="{{item.id}}" bindtap="openEditProduct" role="button" aria-label="{{batchMode ? (batchSelected[item.id] ? '已选择商品' : '选择商品') : '编辑商品'}} {{item.name}}">
    <view wx:if="{{batchMode}}" class="product-batch-checkbox"><checkbox checked="{{batchSelected[item.id] || false}}" disabled="{{batchBusy || cloudLoading}}" color="#267452" /></view>
    <image wx:if="{{item.imageUrl}}" class="product-manage-image" src="{{item.imageUrl}}" mode="aspectFill" />
    <!-- UNIFIED_PLACEHOLDER_THUMB_V1 -->
<view wx:else class="stall-placeholder-choice-shell">
  <image wx:if="{{(placeholderStyle === 'custom') ? (customPlaceholderUrl) : false}}" class="stall-custom-placeholder-preview" src="{{customPlaceholderUrl}}" mode="aspectFill" />
  <view wx:if="{{placeholderStyle === 'classic'}}" class="stall-empty-thumb-v4 stall-classic-picker"><view class="stall-classic-icon"><view class="stall-classic-sun"></view><view class="stall-classic-hill"></view></view><text class="stall-classic-text">暂无图片</text></view>
  <view wx:if="{{placeholderStyle === 'mountain'}}" class="stall-empty-thumb-v4 stall-empty-art-v5">
    <view class="stall-art-frame-v5">
      <view class="stall-art-sun-v5"></view>
      <view class="stall-art-hill-back-v5"></view>
      <view class="stall-art-hill-front-v5"></view>
    </view>
    <text class="stall-art-label-v5">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'bag'}}" class="stall-empty-thumb-v4 stall-bag-placeholder-v6">
    <view class="stall-bag-icon-v6">
      <view class="stall-bag-handle-v6"></view>
      <view class="stall-bag-body-v6"></view>
    </view>
    <text class="stall-bag-label-v6">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'playful'}}" class="stall-empty-thumb-v4 stall-art-placeholder-v7">
    <view class="stall-art-glow-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-left-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-right-v7"></view>
    <view class="stall-art-shadow-v7"></view>
    <view class="stall-art-box-v7">
      <view class="stall-art-box-side-v7"></view>
      <view class="stall-art-box-front-v7"></view>
      <view class="stall-art-box-top-v7"></view>
      <view class="stall-art-ribbon-v7"></view>
      <view class="stall-art-face-left-v7"></view>
      <view class="stall-art-face-right-v7"></view>
      <view class="stall-art-smile-v7"></view>
    </view>
    <text class="stall-art-caption-v7">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'premium'}}" class="stall-empty-thumb-v4 stall-premium-art-v8">
    <view class="spa-v8-background"></view>
    <view class="spa-v8-halo"></view>
    <view class="spa-v8-ring"></view>
    <view class="spa-v8-dot spa-v8-dot-a"></view>
    <view class="spa-v8-dot spa-v8-dot-b"></view>
    <view class="spa-v8-star spa-v8-star-a"></view>
    <view class="spa-v8-star spa-v8-star-b"></view>
    <view class="spa-v8-shadow"></view>
    <view class="spa-v8-package">
      <view class="spa-v8-box-side"></view>
      <view class="spa-v8-box-front"></view>
      <view class="spa-v8-box-lid"></view>
      <view class="spa-v8-ribbon-front"></view>
      <view class="spa-v8-ribbon-top"></view>
      <view class="spa-v8-bow spa-v8-bow-left"></view>
      <view class="spa-v8-bow spa-v8-bow-right"></view>
      <view class="spa-v8-bow-center"></view>
      <view class="spa-v8-sticker"><view class="spa-v8-sticker-heart"></view></view>
    </view>
    <view class="spa-v8-label"><text>暂无图片</text></view>
  </view>
</view>
    <view class="product-manage-info">
      <text class="product-manage-name">{{item.name}}</text>
      <view class="product-card-meta"><text class="product-manage-price">¥{{item.price}}</text><text class="product-card-edit">编辑 ›</text></view>
      <text class="product-manage-state">{{item.statusLabel}}{{item.soldOut ? ' · 已售罄' : ''}}</text>
      <text class="product-schedule-label">{{item.inventoryLabel}}</text>
      <text wx:if="{{item.publishAt}}" class="product-schedule-label">{{item.pendingPublication ? '计划上架：' : '已按计划上架：'}}{{item.publishTimeText || item.publishAt}}（{{storeTimeZone === 'Asia/Shanghai' ? '北京时间 UTC+8' : storeTimeZone}}）</text>
    </view>
    
  </view>
  </view>
  <view class="product-query-footer">
    <text>已加载 {{entries.length}} 条（正式商品 {{products.length}}，草稿 {{drafts.length}}）</text>
    <text wx:if="{{loadingMore}}">正在加载更多…</text>
    <text wx:if="{{moreError}}" class="product-query-pending">{{moreError}}</text>
    <button wx:if="{{refreshRequired}}" bindtap="searchProducts" disabled="{{batchBusy}}">数据有变化，刷新列表</button>
    <button wx:elif="{{hasMore}}" bindtap="loadMore" disabled="{{batchBusy || cloudLoading || loadingMore || queryDirty}}">{{moreError ? '重试加载更多' : '加载更多'}}</button>
    <text wx:if="{{!hasMore && !cloudLoading && !cloudError && entries.length && !queryDirty}}">已加载全部匹配结果</text>
  </view>
</view>
