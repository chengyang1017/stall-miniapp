page { background: #f5f6f8; }
.product-status-filters { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; margin-bottom:22rpx; }
.product-status-filters button { width:100%; margin:0; padding:0 6rpx; font-size:23rpx; line-height:76rpx; background:#fff; color:#58665f; }
.product-status-filters button.selected { background:#267452; color:#fff; }
.product-draft-card { padding:24rpx; border-radius:16rpx; background:#fff; margin-bottom:16rpx; }
.product-draft-label,.product-schedule-label { display:block; color:#92651c; font-size:22rpx; line-height:1.6; overflow-wrap:anywhere; }
.product-draft-actions { display:flex; gap:16rpx; margin-top:16rpx; }
.product-draft-actions button { margin:0; color:var(--brand-primary); background:var(--brand-background); }
.product-manage-info .product-copy-button { align-self: flex-start; margin: 4rpx 0 0; padding: 0 24rpx; min-height: 64rpx; line-height: 64rpx; color: var(--brand-primary); background: var(--brand-background); font-size: 24rpx; }
.product-manage-header { flex-wrap: wrap; gap: 16rpx; }
.product-manage-header-actions { display: flex; flex-wrap: wrap; gap: 12rpx; }
.product-manage-header-actions button { margin: 0; }
.product-batch-panel { position: sticky; top: 0; z-index: 5; padding: 20rpx; margin-bottom: 20rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(38,116,82,.08); }
.product-batch-summary { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 28rpx; font-weight: 600; color: var(--brand-primary); }
.product-batch-summary button { margin: 0; flex-shrink: 0; }
.product-batch-hint { display: block; margin: 14rpx 0; color: #777; font-size: 23rpx; line-height: 1.5; }
.product-batch-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.product-batch-actions button, .product-batch-category-submit { width: 100%; margin: 0; font-size: 25rpx; line-height: 2.8; color: var(--brand-primary); background: var(--brand-background); }
.product-batch-category { margin: 16rpx 0 12rpx; padding: 18rpx; border: 1rpx solid var(--brand-primary-soft); border-radius: 12rpx; color: var(--brand-primary); font-size: 26rpx; }
.product-batch-feedback, .product-batch-result { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; color: #87581f; }
.product-batch-result { padding: 20rpx; margin-bottom: 20rpx; border-radius: 12rpx; background: #fff7e8; }
.product-manage-row.product-batch-selected { background: var(--brand-background); box-shadow: inset 0 0 0 2rpx var(--brand-border); }
.product-batch-checkbox { flex: 0 0 48rpx; width: 48rpx; pointer-events: none; }
.product-batch-checkbox checkbox { transform: scale(.85); transform-origin: left center; }
.page { padding: 28rpx; }
.heading { font-size: 38rpx; font-weight: bold; margin-bottom: 28rpx; }
.subheading { font-size: 30rpx; font-weight: bold; margin-bottom: 24rpx; }
.card { padding: 28rpx; border-radius: 18rpx; background: white; margin-bottom: 22rpx; }
.field { margin-bottom: 24rpx; font-size: 26rpx; color: #555; }
input, .picker { margin-top: 12rpx; background: #f7f7f7; border: 1rpx solid #ddd; padding: 18rpx; border-radius: 8rpx; height: auto; min-height: 48rpx; }
.inline, .line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.inline { margin-bottom: 20rpx; }
.inline input { flex: 1; }
.line { border-top: 1rpx solid #eee; padding: 16rpx 0; font-size: 26rpx; }
.line button { margin: 0; }
.small { display: inline-block; margin-left: 8rpx !important; }
.hint { font-size: 24rpx; color: #777; padding-bottom: 30rpx; }


