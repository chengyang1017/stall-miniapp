<view class="merchant-login-page">
  <view class="merchant-login-card">
    <view class="merchant-login-title">{{shareInvitation ? "店铺成员邀请" : "账号与权限"}}</view>
    <view class="merchant-login-desc">{{shareInvitation ? "你收到了加入商家团队的邀请。使用自己的微信账号登录后，确认加入即可。" : "登录后由服务器核实店铺权限。已有权限的成员可进入工作台；新成员须凭店主提供的一次性邀请码加入。"}}</view>
    <view wx:if="{{cloudOnly}}" class="merchant-login-desc">当前店铺 {{storeSlug}} · 可信Staging已由构建配置固定，无需输入地址或Token。</view>
    <block wx:if="{{!cloudOnly}}">
    <view class="merchant-login-label">后端地址</view>
    <input class="merchant-login-input" disabled="{{busy}}" value="{{apiBase}}" placeholder="https://api.example.com" bindinput="onBaseInput" />
    <view class="merchant-login-label">店铺标识</view>
    <input class="merchant-login-input" disabled="{{busy}}" value="{{storeSlug}}" placeholder="例如 stall-demo" bindinput="onSlugInput" />
    </block>
    <button type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="loginWechat">微信登录并验证商家身份</button>
    <view class="merchant-login-result">{{status}}</view>
    <button wx:if="{{authenticated}}" type="primary" bindtap="openAuthorizedWorkspace">进入商家工作台</button>
    <button wx:if="{{authenticated}}" bindtap="logout">退出本机商家登录</button>
  </view>
  <view wx:if="{{!authenticated || shareInvitation}}" class="merchant-login-card">
    <view class="merchant-login-title">{{shareInvitation ? "确认加入店铺" : "使用邀请码加入店铺"}}</view>
    <view class="merchant-login-desc">请先使用自己的微信登录。邀请码只能使用一次，24小时后失效。</view>
    <view wx:if="{{inviteStoreMismatch}}" class="merchant-login-result">邀请店铺与当前店铺不一致，无法加入。</view>
    <input wx:if="{{!shareInvitation}}" class="merchant-login-input" maxlength="32" value="{{joinCode}}" bindinput="onJoinCodeInput" placeholder="输入店主发给你的邀请码" />
    <view wx:else class="merchant-login-desc">已收到邀请码 · 无需手动输入</view>
    <button disabled="{{busy || memberBusy || inviteStoreMismatch}}" loading="{{memberBusy}}" bindtap="redeemMemberInvitation">{{shareInvitation ? "确认加入商家团队" : "加入商家工作台"}}</button>
    <view wx:if="{{memberStatus}}" class="merchant-login-result">{{memberStatus}}</view>
  </view>
  <view wx:if="{{authenticated && canInvite}}" class="merchant-login-card merchant-team-card">
    <view class="merchant-login-title">成员与权限</view>
    <view class="merchant-login-desc">店主可以邀请其他微信账号协助经营，并查看或撤销已有成员的权限。</view>

    <view class="merchant-team-section">
      <view class="merchant-team-title">邀请新成员</view>
      <view class="merchant-login-desc">邀请码一次性使用，24 小时后失效。成员使用自己的微信账号登录。</view>
      <button class="merchant-team-primary" bindtap="createMemberInvitation" loading="{{memberBusy}}" disabled="{{busy || memberBusy || membersLoading}}">生成邀请码</button>
      <view wx:if="{{invitationCode}}" class="merchant-team-invitation">
        <text selectable="true">{{invitationCode}}</text>
        <button size="mini" bindtap="copyMemberInvitation">复制</button>
      </view>
      <button wx:if="{{invitationCode}}" open-type="share" class="merchant-team-share" disabled="{{busy || memberBusy}}">发送邀请给微信好友</button>
      <view wx:if="{{memberStatus}}" class="merchant-login-result">{{memberStatus}}</view>
    </view>

    <view class="merchant-team-section">
      <view class="merchant-team-title">已授权成员 <text class="merchant-team-count">{{members.length}}</text></view>
      <view class="merchant-login-desc">权限由服务器验证；撤销后成员无法继续访问受保护的商家接口。</view>
      <view wx:if="{{membersLoading}}" class="merchant-team-loading">正在读取成员…</view>
      <view wx:if="{{membersError}}" class="merchant-team-error">{{membersError}}</view>
      <view wx:if="{{!membersLoading && !membersError && !members.length}}" class="merchant-team-empty">暂无成员</view>
      <view wx:for="{{members}}" wx:key="memberKey" class="merchant-team-member">
        <view class="merchant-team-avatar">♙</view>
        <view class="merchant-team-meta">
          <view class="merchant-team-name">{{item.label}}</view>
          <view class="merchant-team-role">{{item.role === 'owner' ? '店主' : item.role === 'manager' ? '管理员' : '员工'}}</view>
        </view>
        <button wx:if="{{!item.isSelf && item.role !== 'owner'}}" class="merchant-team-remove" size="mini" data-id="{{item.memberKey}}" bindtap="removeManagedMember" disabled="{{busy || memberBusy || membersLoading}}">移除</button>
      </view>
      <button class="merchant-team-refresh" size="mini" bindtap="refreshMembers" loading="{{membersLoading}}" disabled="{{busy || memberBusy || membersLoading}}">刷新成员列表</button>
    </view>
  </view>
  <view wx:if="{{showLocalDev}}" class="merchant-login-card">
    <view class="merchant-login-title">本地开发测试</view>
    <view class="merchant-login-desc">仅开发者工具连接本机 stall-demo 时显示，不属于正式微信登录。</view>
    <input class="merchant-login-input" disabled="{{busy}}" password="true" value="{{devToken}}" bindinput="onTokenInput" placeholder="本地临时测试 Token" />
    <button loading="{{busy}}" disabled="{{busy}}" bindtap="loginDev">使用本地测试会话验证</button>
  </view>
</view>
