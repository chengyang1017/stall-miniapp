.merchant-login-page{min-height:100vh;box-sizing:border-box;padding:28rpx;background:var(--brand-background)}.merchant-login-card{background:#fff;border-radius:20rpx;padding:30rpx;margin-bottom:24rpx}.merchant-login-title{font-size:36rpx;font-weight:650;color:var(--brand-text);margin-bottom:14rpx}.merchant-login-desc{font-size:25rpx;color:var(--brand-muted);line-height:1.7;margin-bottom:26rpx}.merchant-login-label{font-size:26rpx;color:var(--brand-border);margin:14rpx 0}.merchant-login-input{height:88rpx;background:var(--brand-background);padding:0 20rpx;border-radius:12rpx;margin-bottom:22rpx;font-size:28rpx}.merchant-login-result{font-size:25rpx;color:var(--brand-border);line-height:1.6;margin:22rpx 0}

@import "../../styles/merchant-theme.wxss";
