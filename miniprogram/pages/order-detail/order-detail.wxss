page{background:#f4f6f5;color:#1e3026}
.order-detail-page{padding:24rpx 24rpx 90rpx;box-sizing:border-box}
.order-detail-card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:18rpx}
.order-detail-title{font-size:29rpx;font-weight:700;color:#203c2c;margin-bottom:18rpx}
.order-detail-empty{text-align:center;padding:94rpx 24rpx;color:#7d8781}
.order-detail-muted{color:#78897e;font-size:23rpx;line-height:1.6;margin:12rpx 0;word-break:break-all}
.order-detail-line{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;border-bottom:1rpx solid #f0f2f0;padding:18rpx 0;font-size:25rpx;color:#35493c;line-height:1.55}
.order-detail-line text:first-child{flex:1;min-width:0}
.order-detail-line text:last-child{text-align:right;min-width:0;max-width:58%;overflow-wrap:anywhere}
.order-detail-total{text-align:right;color:#168357;font-weight:750;font-size:30rpx;margin-top:20rpx}
.order-detail-reason{color:#b5523e;line-height:1.6;font-size:26rpx}
.order-detail-proof{width:240rpx;height:240rpx;border-radius:16rpx;margin-top:14rpx}
.order-hero{background:linear-gradient(125deg,#214a37,#168355);border-radius:25rpx;color:#fff;padding:33rpx 32rpx 27rpx;margin-bottom:16rpx}
.order-hero-top{display:flex;align-items:center;justify-content:space-between}
.order-hero-label{font-size:24rpx;opacity:.84}
.order-hero-test{font-size:20rpx;background:rgba(255,255,255,.15);padding:8rpx 15rpx;border-radius:100rpx}
.order-hero-status{font-weight:750;font-size:47rpx;margin-top:19rpx}
.order-hero-payment{font-size:24rpx;opacity:.92;line-height:1.5;margin-top:10rpx}
.order-hero-footer{border-top:1rpx solid rgba(255,255,255,.2);display:flex;flex-direction:column;gap:7rpx;margin-top:30rpx;padding-top:20rpx;font-size:20rpx;line-height:1.5;opacity:.82;overflow-wrap:anywhere}
.order-quick-actions{display:flex;flex-direction:column;background:#fff;border-radius:21rpx;margin-bottom:18rpx;padding:0 27rpx}
.order-action-item{padding:25rpx 0;display:flex;justify-content:space-between;align-items:center;font-size:27rpx;color:#253e2f}
.order-action-item+.order-action-item{border-top:1rpx solid #eef1ef}
.order-action-chevron{font-size:37rpx;color:#a2afa5;line-height:1}
.payment-history-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx;margin-bottom:14rpx}
.payment-history-heading{flex:1;min-width:0}
.payment-history-heading .order-detail-title{margin:0}
.payment-history-heading .order-detail-muted{margin-top:6rpx}
.payment-refresh-btn{margin:0!important;border-radius:13rpx!important;background:#eaf5ee!important;color:#1b7850!important;font-size:22rpx!important;border:0!important;flex-shrink:0}
.attempt-history-toggle{padding:17rpx 0;display:flex;align-items:center;justify-content:space-between;color:#728778;font-size:23rpx;border-top:1rpx solid #eef1ef}
.payment-attempt-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;background:#f6f9f7;padding:18rpx;border-radius:13rpx;margin:10rpx 0}
.payment-attempt-info{display:flex;flex-direction:column;gap:5rpx;min-width:0;flex:1}
.payment-attempt-channel{font-weight:650;font-size:25rpx}
.payment-attempt-state{font-size:22rpx;color:#708477}
.payment-attempt-price{font-weight:700;font-size:27rpx;flex-shrink:0}
.receipt-ticket{border:1rpx solid #dceae1;border-radius:20rpx;overflow:hidden;margin-top:18rpx;background:#fff}
.ticket-top{padding:24rpx 22rpx;display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.ticket-identity{display:flex;align-items:center;gap:14rpx;min-width:0;flex:1}
.ticket-icon{display:flex;align-items:center;justify-content:center;background:#e5f6ea;color:#168253;font-size:26rpx;font-weight:700;width:48rpx;height:48rpx;border-radius:50%;flex-shrink:0}
.ticket-title{font-weight:700;font-size:27rpx;color:#20392a}
.ticket-subtitle{font-size:20rpx;color:#7d8c82;line-height:1.5;margin-top:5rpx;overflow-wrap:anywhere}
.ticket-tag{flex-shrink:0;color:#168253;background:#eaf7ee;font-size:20rpx;padding:7rpx 12rpx;border-radius:100rpx}
.ticket-paid-label{text-align:center;font-size:23rpx;color:#859187;margin-top:18rpx}
.ticket-paid-amount{text-align:center;color:#176f48;font-size:54rpx;font-weight:750;margin:7rpx 0 10rpx}
.ticket-disclaimer{font-size:21rpx;line-height:1.55;color:#8a978c;text-align:center;margin:0 22rpx 27rpx}
.ticket-controls{display:flex;border-top:1rpx solid #e8eee9;align-items:center;gap:10rpx;padding:13rpx 18rpx}
.ticket-expand{flex:1;display:flex;justify-content:space-between;gap:9rpx;padding:13rpx 4rpx;color:#227c53;font-size:24rpx}
.ticket-copy{margin:0!important;background:#188553!important;color:#fff!important;font-size:23rpx!important;border:0!important;border-radius:12rpx!important;flex-shrink:0}
.ticket-expanded{border-top:1rpx solid #e8eee9;background:#fcfdfc;padding:23rpx 22rpx 25rpx}
.ticket-section-name{font-size:25rpx;font-weight:700;color:#2a4634;margin-bottom:14rpx}
.ticket-product-row{display:flex;align-items:start;justify-content:space-between;gap:15rpx;font-size:24rpx;margin-bottom:16rpx}
.ticket-product-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:7rpx;overflow-wrap:anywhere}
.ticket-product-muted{color:#87968a;font-size:21rpx}
.ticket-money-row{display:flex;justify-content:space-between;margin:14rpx 0;font-size:23rpx;color:#77887b}
.ticket-money-total{font-size:26rpx;font-weight:700;color:#236f48;padding-top:18rpx;border-top:1rpx solid #e4eae5}
.ticket-reference-title{margin-top:30rpx;padding-top:22rpx;border-top:1rpx solid #e4eae5}
.ticket-reference-row{margin:15rpx 0;display:flex;flex-direction:column;gap:7rpx;font-size:22rpx;color:#87958a}
.ticket-reference-row text:last-child{font-size:22rpx;color:#42594a;word-break:break-all;overflow-wrap:anywhere}
.sandbox-refund-summary{background:#f6faf7;border:1rpx solid #dcece0;border-radius:14rpx;padding:20rpx;margin:18rpx 0}
.sandbox-refund-item{border:1rpx solid #e8ece9;border-radius:12rpx;padding:16rpx 20rpx;margin:16rpx 0}
.sandbox-refund-item .order-detail-line{padding:8rpx 0}
