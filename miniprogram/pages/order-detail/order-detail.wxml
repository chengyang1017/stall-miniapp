<view class="order-detail-page">
  <view wx:if="{{found && cloudMode && order.fulfillmentStatus === 'delivered'}}" class="order-detail-card"><view class="order-detail-title">评价商品</view><view class="order-detail-muted">须核验真实支付后才能发表；商家已送达不等于已确认收款。</view><navigator wx:for="{{items}}" wx:key="orderItemId" wx:if="{{item.orderItemId}}" url="/pages/customer-reviews/customer-reviews?orderItemId={{item.orderItemId}}">评价 {{item.name}} ›</navigator></view>
  <view wx:if="{{detailLoading && !found}}" class="order-detail-empty">正在读取订单详情…</view>
  <view wx:elif="{{!found}}" class="order-detail-empty">
    <view>{{detailError || (detailNotFound ? "找不到该订单" : "订单详情尚未加载")}}</view>
    <button size="mini" bindtap="reloadOrderDetail" disabled="{{detailLoading}}">重新读取订单</button>
  </view>
  <view wx:if="{{found && detailError}}" class="order-detail-card">
    <view class="order-detail-muted">{{detailError}}（以下为上次已加载的信息）</view>
    <button size="mini" bindtap="reloadOrderDetail" disabled="{{detailLoading}}">重试刷新</button>
  </view>
  <view wx:if="{{found}}">
    <view class="order-hero">
      <view class="order-hero-top"><text class="order-hero-label">订单进度</text><text wx:if="{{order.paymentSource === 'stripe:sandbox'}}" class="order-hero-test">测试订单</text></view>
      <view class="order-hero-status">{{statusText}}</view>
      <view class="order-hero-payment">{{paymentText}}</view>
      <view class="order-hero-footer"><text>订单号 {{order.id}}</text><text>{{createdText}}</text></view>
    </view>
    <view class="order-quick-actions">
      <navigator class="order-action-item" url="/pages/customer-support-chat/customer-support-chat"><text>联系店铺客服</text><text class="order-action-chevron">›</text></navigator>
      <navigator wx:if="{{cloudMode && order.fulfillmentStatus === 'delivering'}}" class="order-action-item" url="/pages/customer-tracking/customer-tracking?id={{order.id}}"><text>查看配送位置</text><text class="order-action-chevron">›</text></navigator>
    </view>
    <view class="order-detail-card"><view class="order-detail-title">商品清单</view><view wx:for="{{items}}" wx:key="productId" class="order-detail-line"><text>{{item.name}} × {{item.quantity}}</text><text>¥{{item.subtotal}}</text></view><view class="order-detail-total">合计 ¥{{order.totalText}}</view></view>
    <view class="order-detail-card"><view class="order-detail-title">配送信息</view><view class="order-detail-line"><text>收货人</text><text>{{order.receiverName}}</text></view><view class="order-detail-line"><text>联系电话</text><text>{{order.phone}}</text></view><view class="order-detail-line"><text>收货地址</text><text>{{order.area}} {{order.detail}}</text></view><view class="order-detail-line"><text>配送时段</text><text>{{order.slotText}}</text></view><view wx:if="{{order.estimatedArrival}}" class="order-detail-line"><text>预计送达</text><text>{{order.estimatedArrival}}</text></view><view wx:if="{{order.note}}" class="order-detail-muted">顾客备注：{{order.note}}</view></view>
    <view wx:if="{{cloudMode && livePayEnabled && !phoneReadOnly && order.paymentSource === 'wechatpay:live'}}" class="order-detail-card">
      <view class="order-detail-title">正式付款记录</view>
      <view class="order-detail-muted">付款与退款金额来自服务端验真的微信支付记录；非税务发票。</view>
      <button size="mini" loading="{{liveReceiptBusy}}" disabled="{{liveReceiptBusy}}" bindtap="copyWechatLiveReceipt">复制付款记录</button>
      <view wx:if="{{liveReceiptError}}" class="order-detail-muted">{{liveReceiptError}}</view>
    </view>
    <view wx:if="{{cloudMode && livePayEnabled && !phoneReadOnly && order.paymentStatus === 'unpaid' && order.fulfillmentStatus === 'new'}}" class="order-detail-card">
      <view class="order-detail-title">微信支付</view>
      <view class="order-detail-muted">使用微信支付完成付款。付款状态以微信支付服务端核验为准。</view>
      <button type="primary" loading="{{livePaymentBusy}}" disabled="{{livePaymentBusy}}" bindtap="payWithWechat">立即微信支付</button>
      <button size="mini" loading="{{livePaymentBusy}}" disabled="{{livePaymentBusy}}" bindtap="refreshWechatPayment">刷新付款状态</button>
      <view wx:if="{{livePaymentText}}" class="order-detail-muted">{{livePaymentText}}</view>
    </view>
    <view wx:if="{{cloudMode && !livePayEnabled && sandboxUiEnabled && !phoneReadOnly && order.paymentStatus === 'unpaid'}}" class="order-detail-card">
      <view class="order-detail-title">Sandbox 外部支付测试</view>
      <view wx:if="{{sandboxUnavailable}}" class="order-detail-muted">测试支付服务尚未启用，下面的创建付款操作暂不可用；订单仍为待支付。管理员接通独立 Sandbox 环境后，可点击「立即刷新支付状态」重新检查。</view>
      <view>仅隔离测试环境可用。复制链接到外部浏览器完成测试付款；返回本页后将自动核对服务端结果，微信原生支付尚未接入。</view>
      <view wx:if="{{sandboxActionText}}" class="order-detail-muted">{{sandboxActionText}}</view>
      <view wx:if="{{sandbox.resumeCheckout}}">
        <view class="order-detail-muted">当前待付款渠道：{{sandbox.resumeCheckout.channelText}}。可继续使用原 Stripe Checkout 测试会话。</view>
        <button wx:if="{{sandbox.resumeCheckout.channel === 'wechat_pay'}}" type="primary" bindtap="copyActiveSandboxCheckout">继续微信测试 · 复制原链接</button>
        <view wx:else class="order-detail-muted">该历史测试渠道不再提供新的付款入口。可先核验并取消当前未付款会话，再改用微信支付测试；已收款或待核对的交易不会重复扣款。</view>
        <button wx:if="{{sandbox.resumeCheckout.channel !== 'wechat_pay'}}" type="primary" data-channel="wechat_pay" bindtap="switchSandboxChannel" disabled="{{sandboxActionBusy}}">改用微信支付测试</button>
        <button size="mini" bindtap="cancelSandboxPayment" disabled="{{sandboxActionBusy}}">仅取消当前测试付款</button>
      </view>
      <view wx:elif="{{sandbox.attempts.length && (sandbox.attempts[sandbox.attempts.length-1].status === 'creating' || sandbox.attempts[sandbox.attempts.length-1].status === 'processing' || sandbox.attempts[sandbox.attempts.length-1].status === 'review')}}">
        <view class="order-detail-muted">当前付款请求尚未确认结束。请先刷新支付状态，不要新建或重复付款。</view>
      </view>
      <view wx:else>
        <view wx:if="{{sandbox.retryChannel}}" class="order-detail-muted">
          {{sandbox.retryLabel}}。上次选择：{{sandbox.retryChannelText}}。
          如需再次付款，只能重新创建微信支付的 Stripe Sandbox 测试会话，不会自动扣款。
        </view>
        <button type="primary" data-channel="wechat_pay" disabled="{{sandboxActionBusy || sandboxUnavailable}}" bindtap="openSandboxCheckout">获取微信支付测试链接</button>
      </view>
    </view>
    <view wx:if="{{cloudMode && !livePayEnabled && sandboxUiEnabled && !phoneReadOnly}}" class="order-detail-card payment-history-card">
      <view class="payment-history-head">
        <view class="payment-history-heading"><view class="order-detail-title">付款与电子小票</view><view class="order-detail-muted">仅供测试环境使用</view></view>
        <button class="payment-refresh-btn" size="mini" bindtap="loadSandboxPayment">刷新状态</button>
      </view>
      <view wx:if="{{sandboxPollText}}" class="order-detail-muted">{{sandboxPollText}}</view>
      <view wx:if="{{sandboxError}}" class="order-detail-muted">{{sandboxError}}</view>
      <view wx:if="{{sandbox.stale}}" class="order-detail-muted">渠道暂不可用，以下为已保存状态，最新结果尚未确认。</view>
      <view wx:if="{{sandbox.attempts.length && sandbox.receipts.length}}" class="attempt-history-toggle" bindtap="togglePaymentHistory"><text>支付尝试记录（{{sandbox.attempts.length}}）</text><text>{{paymentHistoryExpanded ? '收起 ⌃' : '展开 ⌄'}}</text></view>
      <view wx:for="{{sandbox.attempts}}" wx:key="id" wx:if="{{!sandbox.receipts.length || paymentHistoryExpanded}}" class="payment-attempt-row">
        <view class="payment-attempt-info"><text class="payment-attempt-channel">{{item.channelText}}</text><text class="payment-attempt-state">{{item.label}}</text></view>
        <text class="payment-attempt-price">¥{{item.amountText}}</text>
      </view>
      <view wx:if="{{sandbox.refundSummary.hasRefunds}}" class="sandbox-refund-summary">
        <view class="order-detail-title">测试退款进度</view>
        <view class="order-detail-line"><text>渠道已确认退款合计</text><text>¥{{sandbox.refundSummary.completedText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.hasAwaiting}}" class="order-detail-line"><text>待处理／待渠道确认</text><text>¥{{sandbox.refundSummary.awaitingText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.hasReview}}" class="order-detail-line"><text>需人工核查金额</text><text>¥{{sandbox.refundSummary.reviewText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.merchantPaidKnown}}" class="order-detail-line"><text>原订单付款扣除已成功商家退款</text><text>¥{{sandbox.refundSummary.merchantRemainingText}}</text></view>
        <view class="order-detail-muted">以上均为 Stripe 测试交易。待处理和人工核查金额不算退款成功；超时收款补偿退款与商家主动退款分别记录。</view>
      </view>
      <view wx:for="{{sandbox.refunds}}" wx:key="id" class="sandbox-refund-item">
        <view class="order-detail-line"><text>{{item.kindText}}</text><text>¥{{item.amountText}}</text></view>
        <view class="order-detail-muted">退款状态：{{item.label}}</view>
        <view wx:if="{{item.refundId}}" class="order-detail-muted">Stripe 退款编号：{{item.refundId}}</view>
        <view wx:else class="order-detail-muted">尚无已核实的 Stripe 退款编号</view>
        <view wx:if="{{item.createdAt}}" class="order-detail-muted">申请记录时间：{{item.createdAt}}</view>
      </view>
      <view wx:for="{{sandbox.receipts}}" wx:key="id" wx:for-item="receipt" class="receipt-ticket">
        <view class="ticket-top"><view class="ticket-identity"><text class="ticket-icon">✓</text><view><view class="ticket-title">测试付款凭证</view><view class="ticket-subtitle">{{receipt.channelText}} · {{receipt.paidAt}}</view></view></view><text class="ticket-tag">已确认</text></view>
        <view class="ticket-paid-label">付款金额</view>
        <view class="ticket-paid-amount">¥{{receipt.totalText}}</view>
        <view class="ticket-disclaimer">Stripe Sandbox 测试交易，不代表真实资金到账</view>
        <view class="ticket-controls">
          <view class="ticket-expand" data-id="{{receipt.id}}" bindtap="toggleReceiptDetails"><text>{{receiptExpandedId === receipt.id ? '收起小票明细' : '查看小票明细'}}</text><text>{{receiptExpandedId === receipt.id ? '⌃' : '⌄'}}</text></view>
          <button class="ticket-copy" size="mini" data-id="{{receipt.id}}" bindtap="copySandboxReceipt">复制小票</button>
        </view>
        <view wx:if="{{receiptExpandedId === receipt.id}}" class="ticket-expanded">
          <view class="ticket-section-name">商品明细</view>
          <view wx:for="{{receipt.items}}" wx:for-item="line" wx:key="productId" class="ticket-product-row">
            <view class="ticket-product-info"><text>{{line.name}}</text><text class="ticket-product-muted">× {{line.quantity}} · 单价 ¥{{line.unitText}}</text></view><text>¥{{line.lineTotalText}}</text>
          </view>
          <view class="ticket-money-row"><text>商品小计</text><text>¥{{receipt.subtotalText}}</text></view>
          <view class="ticket-money-row"><text>配送费</text><text>¥{{receipt.deliveryFeeText}}</text></view>
          <view class="ticket-money-row ticket-money-total"><text>实付合计</text><text>¥{{receipt.totalText}}</text></view>
          <view class="ticket-section-name ticket-reference-title">交易凭证</view>
          <view class="ticket-reference-row"><text>订单编号</text><text selectable="true">{{receipt.orderId}}</text></view>
          <view class="ticket-reference-row"><text>Stripe 交易参考</text><text selectable="true">{{receipt.transactionId}}</text></view>
          <view class="ticket-reference-row"><text>PaymentIntent</text><text selectable="true">{{receipt.paymentIntentId}}</text></view>
          <view class="ticket-reference-row"><text>SHA-256 校验摘要</text><text selectable="true">{{receipt.sha256}}</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{!livePayEnabled && sandboxUiEnabled && simulationAuthorized}}" class="order-detail-card"><view>Staging测试入口 · 不发生真实付款</view><button bindtap="confirmSimulation" disabled="{{simulationBusy || !simulationEligible}}" loading="{{simulationBusy}}">{{simulationBusy ? '正在核对模拟确认' : '授权测试：模拟支付确认'}}</button><view>仅服务端授权的测试人员可操作；非微信支付，不计真实收入。</view><view>{{simulationError}}</view></view>

    <view wx:if="{{issueText}}" class="order-detail-card"><view class="order-detail-title">取消 / 异常原因</view><view class="order-detail-reason">{{issueText}}</view></view>
    <view wx:if="{{deliveredText || proofImage}}" class="order-detail-card"><view class="order-detail-title">送达凭证</view><view wx:if="{{proofError}}" class="order-detail-muted">{{proofError}}</view><button wx:if="{{cloudMode}}" size="mini" bindtap="renewProof" disabled="{{proofLoading}}" loading="{{proofLoading}}">重新获取凭证链接</button><view wx:if="{{deliveredText}}" class="order-detail-muted">送达时间：{{deliveredText}}</view><image wx:if="{{proofImage}}" class="order-detail-proof" src="{{proofImage}}" mode="aspectFill" bindtap="previewProof" binderror="proofReadError"/><view wx:else class="order-detail-muted">尚无送达照片</view></view>
  </view>
</view>
