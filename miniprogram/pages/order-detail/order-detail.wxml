<view class="order-detail-page">
  <navigator wx:if="{{found && cloudMode && order.fulfillmentStatus === 'delivering'}}" class="order-detail-card" url="/pages/customer-tracking/customer-tracking?id={{order.id}}">查看配送位置 ›</navigator>
  <navigator class="order-detail-card" url="/pages/customer-support-chat/customer-support-chat">联系店铺客服 ›</navigator>
  <view wx:if="{{found && cloudMode && order.fulfillmentStatus === 'delivered'}}" class="order-detail-card"><view class="order-detail-title">评价商品</view><view class="order-detail-muted">须核验真实支付后才能发表；商家已送达不等于已确认收款。</view><navigator wx:for="{{items}}" wx:key="orderItemId" wx:if="{{item.orderItemId}}" url="/pages/customer-reviews/customer-reviews?orderItemId={{item.orderItemId}}">评价 {{item.name}} ›</navigator></view>
  <view wx:if="{{detailLoading && !found}}" class="order-detail-empty">正在读取订单详情…</view>
  <view wx:elif="{{!found}}" class="order-detail-empty">
    <view>{{detailError || (detailNotFound ? "找不到该订单" : "订单详情尚未加载")}}</view>
    <button size="mini" bindtap="reloadOrderDetail" disabled="{{detailLoading}}">重新读取订单</button>
  </view>
  <view wx:if="{{found && detailError}}" class="order-detail-card">
    <view class="order-detail-muted">{{detailError}}（以下为上次已加载的信息）</view>
    <button size="mini" bindtap="reloadOrderDetail" disabled="{{detailLoading}}">重试刷新</button>
  </view>
  <view wx:else>
    <view wx:if="{{cloudMode && !phoneReadOnly && order.paymentStatus === 'unpaid'}}" class="order-detail-card">
      <view class="order-detail-title">Sandbox 外部支付测试</view>
      <view>仅隔离测试环境可用。复制链接到外部浏览器完成测试付款；返回本页后将自动核对服务端结果，微信原生支付尚未接入。</view>
      <view wx:if="{{sandboxActionText}}" class="order-detail-muted">{{sandboxActionText}}</view>
      <view wx:if="{{sandbox.resumeCheckout}}">
        <view class="order-detail-muted">当前待付款渠道：{{sandbox.resumeCheckout.channelText}}。可继续使用原 Stripe Checkout 测试会话。</view>
        <button type="primary" bindtap="copyActiveSandboxCheckout">继续付款 · 复制原测试链接</button>
        <view class="order-detail-muted">更换支付方式</view>
        <button size="mini" data-channel="wechat_pay" bindtap="switchSandboxChannel" disabled="{{sandboxActionBusy || sandbox.resumeCheckout.channel === 'wechat_pay'}}">微信测试</button>
        <button size="mini" data-channel="alipay" bindtap="switchSandboxChannel" disabled="{{sandboxActionBusy || sandbox.resumeCheckout.channel === 'alipay'}}">支付宝测试</button>
        <button size="mini" data-channel="card" bindtap="switchSandboxChannel" disabled="{{sandboxActionBusy || sandbox.resumeCheckout.channel === 'card'}}">银行卡测试</button>
        <button size="mini" bindtap="cancelSandboxPayment" disabled="{{sandboxActionBusy}}">仅取消当前测试付款</button>
      </view>
      <view wx:elif="{{sandbox.attempts.length && (sandbox.attempts[sandbox.attempts.length-1].status === 'creating' || sandbox.attempts[sandbox.attempts.length-1].status === 'processing' || sandbox.attempts[sandbox.attempts.length-1].status === 'review')}}">
        <view class="order-detail-muted">当前付款请求尚未确认结束。请先刷新支付状态，不要新建或重复付款。</view>
      </view>
      <view wx:else>
        <view wx:if="{{sandbox.retryChannel}}" class="order-detail-muted">
          {{sandbox.retryLabel}}。上次选择：{{sandbox.retryChannelText}}。
          重新尝试会创建新的 Stripe Sandbox 测试付款会话，不会自动扣款。
        </view>
        <button wx:if="{{sandbox.retryChannel}}" type="primary" disabled="{{sandboxActionBusy}}" bindtap="retrySandboxCheckout">重新尝试 {{sandbox.retryChannelText}}</button>
        <view wx:if="{{sandbox.retryChannel}}" class="order-detail-muted">也可以改选其他支付方式：</view>
        <button size="mini" data-channel="wechat_pay" disabled="{{sandboxActionBusy}}" bindtap="openSandboxCheckout">微信支付测试链接</button>
        <button size="mini" data-channel="alipay" disabled="{{sandboxActionBusy}}" bindtap="openSandboxCheckout">支付宝测试链接</button>
        <button size="mini" data-channel="card" disabled="{{sandboxActionBusy}}" bindtap="openSandboxCheckout">银行卡测试链接</button>
      </view>
    </view>
    <view wx:if="{{cloudMode && !phoneReadOnly}}" class="order-detail-card">
      <view class="order-detail-title">Sandbox 支付记录与电子小票</view>
      <button size="mini" bindtap="loadSandboxPayment">立即刷新支付状态</button>
      <view wx:if="{{sandboxPollText}}" class="order-detail-muted">{{sandboxPollText}}</view>
      <view wx:if="{{sandboxError}}" class="order-detail-muted">{{sandboxError}}</view>
      <view wx:if="{{sandbox.stale}}">渠道暂不可用，以下为已保存状态，最新结果尚未确认。</view>
      <view wx:for="{{sandbox.attempts}}" wx:key="id">{{item.channelText}} · ¥{{item.amountText}} · {{item.label}}</view>
      <view wx:if="{{sandbox.refundSummary.hasRefunds}}" class="sandbox-refund-summary">
        <view class="order-detail-title">测试退款进度</view>
        <view class="order-detail-line"><text>渠道已确认退款合计</text><text>¥{{sandbox.refundSummary.completedText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.hasAwaiting}}" class="order-detail-line"><text>待处理／待渠道确认</text><text>¥{{sandbox.refundSummary.awaitingText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.hasReview}}" class="order-detail-line"><text>需人工核查金额</text><text>¥{{sandbox.refundSummary.reviewText}}</text></view>
        <view wx:if="{{sandbox.refundSummary.merchantPaidKnown}}" class="order-detail-line"><text>原订单付款扣除已成功商家退款</text><text>¥{{sandbox.refundSummary.merchantRemainingText}}</text></view>
        <view class="order-detail-muted">以上均为 Stripe 测试交易。待处理和人工核查金额不算退款成功；超时收款补偿退款与商家主动退款分别记录。</view>
      </view>
      <view wx:for="{{sandbox.refunds}}" wx:key="id" class="sandbox-refund-item">
        <view class="order-detail-line"><text>{{item.kindText}}</text><text>¥{{item.amountText}}</text></view>
        <view class="order-detail-muted">退款状态：{{item.label}}</view>
        <view wx:if="{{item.refundId}}" class="order-detail-muted">Stripe 退款编号：{{item.refundId}}</view>
        <view wx:else class="order-detail-muted">尚无已核实的 Stripe 退款编号</view>
        <view wx:if="{{item.createdAt}}" class="order-detail-muted">申请记录时间：{{item.createdAt}}</view>
      </view>
      <view wx:for="{{sandbox.receipts}}" wx:key="id" wx:for-item="receipt">
        <view>测试电子小票 · {{receipt.notice}}</view><view>订单：{{receipt.orderId}}</view>
        <view>{{receipt.channelText}} · ¥{{receipt.totalText}} {{receipt.currency}} · {{receipt.paidAt}}</view>
        <view wx:for="{{receipt.items}}" wx:for-item="line" wx:key="productId">{{line.name}} × {{line.quantity}} · 单价 ¥{{line.unitText}} · 小计 ¥{{line.lineTotalText}}</view>
        <view>商品小计：¥{{receipt.subtotalText}} · 配送费：¥{{receipt.deliveryFeeText}}</view>
        <view>合计：¥{{receipt.totalText}}</view>
        <view>交易参考：{{receipt.transactionId}}</view><view>PaymentIntent：{{receipt.paymentIntentId}}</view><view>校验摘要：{{receipt.sha256}}</view>
        <button size="mini" data-id="{{receipt.id}}" bindtap="copySandboxReceipt">复制完整测试小票</button>
      </view>
    </view>
    <view wx:if="{{simulationAuthorized}}" class="order-detail-card"><view>Staging测试入口 · 不发生真实付款</view><button bindtap="confirmSimulation" disabled="{{simulationBusy || !simulationEligible}}" loading="{{simulationBusy}}">{{simulationBusy ? '正在核对模拟确认' : '授权测试：模拟支付确认'}}</button><view>仅服务端授权的测试人员可操作；非微信支付，不计真实收入。</view><view>{{simulationError}}</view></view>
    <view class="order-detail-card"><view class="order-detail-title">订单详情</view><view class="order-detail-status">{{statusText}}</view><view class="order-detail-muted">支付状态：{{paymentText}}</view><view class="order-detail-muted">订单编号：{{order.id}}</view><view class="order-detail-muted">下单时间：{{createdText}}</view></view>
    <view class="order-detail-card"><view class="order-detail-title">商品清单</view><view wx:for="{{items}}" wx:key="productId" class="order-detail-line"><text>{{item.name}} × {{item.quantity}}</text><text>¥{{item.subtotal}}</text></view><view class="order-detail-total">合计 ¥{{order.totalText}}</view></view>
    <view class="order-detail-card"><view class="order-detail-title">配送信息</view><view class="order-detail-line"><text>收货人</text><text>{{order.receiverName}}</text></view><view class="order-detail-line"><text>联系电话</text><text>{{order.phone}}</text></view><view class="order-detail-line"><text>收货地址</text><text>{{order.area}} {{order.detail}}</text></view><view class="order-detail-line"><text>配送时段</text><text>{{order.slotText}}</text></view><view wx:if="{{order.estimatedArrival}}" class="order-detail-line"><text>预计送达</text><text>{{order.estimatedArrival}}</text></view><view wx:if="{{order.note}}" class="order-detail-muted">顾客备注：{{order.note}}</view></view>
    <view wx:if="{{issueText}}" class="order-detail-card"><view class="order-detail-title">取消 / 异常原因</view><view class="order-detail-reason">{{issueText}}</view></view>
    <view wx:if="{{deliveredText || proofImage}}" class="order-detail-card"><view class="order-detail-title">送达凭证</view><view wx:if="{{proofError}}" class="order-detail-muted">{{proofError}}</view><button wx:if="{{cloudMode}}" size="mini" bindtap="renewProof" disabled="{{proofLoading}}" loading="{{proofLoading}}">重新获取凭证链接</button><view wx:if="{{deliveredText}}" class="order-detail-muted">送达时间：{{deliveredText}}</view><image wx:if="{{proofImage}}" class="order-detail-proof" src="{{proofImage}}" mode="aspectFill" bindtap="previewProof" binderror="proofReadError"/><view wx:else class="order-detail-muted">尚无送达照片</view></view>
  </view>
</view>
