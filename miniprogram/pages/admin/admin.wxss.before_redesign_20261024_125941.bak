.admin-dashboard{padding:28rpx 28rpx 100rpx;box-sizing:border-box;min-height:100vh;background:#f5f7f6}
.admin-dash-header{padding:35rpx 12rpx 35rpx}.admin-dash-kicker{color:#16865d;font-size:21rpx;font-weight:600;letter-spacing:2rpx}.admin-dash-title{font-size:43rpx;font-weight:700;color:#1c2923;margin-top:12rpx}.admin-dash-caption{color:#6d7b73;font-size:26rpx;margin-top:10rpx}
.admin-dash-link{display:flex;align-items:center;background:#fff;border-radius:22rpx;padding:27rpx 24rpx;margin-bottom:20rpx;box-shadow:0 4rpx 18rpx rgba(38,66,48,.04)}
.admin-dash-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:#e8f5ed;color:#16865d;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;margin-right:22rpx;flex-shrink:0}
.admin-dash-info{flex:1;min-width:0}.admin-dash-name{font-size:30rpx;color:#1d2b24;font-weight:600}.admin-dash-desc{font-size:23rpx;color:#8a968e;margin-top:7rpx}.admin-dash-chevron{font-size:46rpx;color:#aab6ae;margin-left:10rpx}.admin-dash-note{font-size:23rpx;color:#929b95;line-height:1.7;padding:18rpx 10rpx}

/* ADMIN_MENU_ICONS_LARGE_START */
.admin-dash-icon, .merchant-hub-icon {
  width: 86rpx;
  height: 86rpx;
  min-width: 86rpx;
  font-size: 46rpx;
  font-weight: 400;
  line-height: 86rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  flex-shrink: 0;
}
/* ADMIN_MENU_ICONS_LARGE_END */

/* ADMIN_UNIFORM_MENU_ICONS_V1 */
.admin-dashboard .admin-dash-link { display:flex; align-items:center; box-sizing:border-box; }
.admin-dashboard .admin-dash-icon {
  width:100rpx; height:100rpx; min-width:100rpx; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  padding:0; box-sizing:border-box; overflow:visible;
  background:#e8f5ed; border-radius:14rpx;
  font-size:72rpx; line-height:1;
  margin-right:20rpx;
}
.admin-dashboard .admin-dash-info { flex:1; min-width:0; }