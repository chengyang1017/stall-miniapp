<view class="page">
  <view class="heading">商家管理（本地演示）</view>
  <navigator url="/pages/delivery/delivery" style="padding:24rpx;background:#fff;margin-bottom:20rpx;color:#16865d;">管理配送地区和配送时段 →</navigator>
  <view class="card">
    <view class="subheading">分类管理</view>
    <view class="inline"><input placeholder="新分类名称" value="{{categoryName}}" bindinput="inputCategory" /><button size="mini" bindtap="addCategory">添加</button></view>
    <view wx:for="{{categories}}" wx:key="id" class="line"><text>{{item.name}}</text><button size="mini" data-id="{{item.id}}" bindtap="deleteCategory">删除</button></view>
  </view>
  <view class="card">
    <view class="subheading">{{editId ? '编辑商品' : '新增商品'}}</view>
    <view class="field">商品名称<input placeholder="例如：炒饭" value="{{productName}}" bindinput="inputName" /></view>
    <view class="field">
  商品分类
  <picker
    range="{{categories}}"
    range-key="name"
    bindchange="selectCategory"
  >
    <view class="picker">
      {{selectedCategoryName || '请选择分类'}}
    </view>
  </picker>
</view>
    <view class="field">原价 ¥<input type="digit" placeholder="例如：15" value="{{priceText}}" bindinput="inputPrice" /></view>
    <view class="field">折后价 ¥（留空表示无折扣）<input type="digit" placeholder="例如：12" value="{{discountText}}" bindinput="inputDiscount" /></view>
    <view class="field">折扣开始（可留空）<input placeholder="2026-10-23 10:00" value="{{startText}}" bindinput="inputStart" /></view>
    <view class="field">折扣结束（可留空）<input placeholder="2026-10-23 18:00" value="{{endText}}" bindinput="inputEnd" /></view>
    <view class="line"><text>允许销售</text><switch checked="{{isAvailable}}" bindchange="switchAvailable" color="#16865d" /></view>
    <button type="primary" bindtap="saveProduct">保存商品</button>
    <button wx:if="{{editId}}" bindtap="resetForm">取消编辑</button>
  </view>
  <view class="card"><view class="subheading">已保存商品</view>
    <view wx:for="{{products}}" wx:key="id" class="line"><text>{{item.name}} · ¥{{item.price}}</text><view><button class="small" size="mini" data-id="{{item.id}}" bindtap="editProduct">编辑</button><button class="small" size="mini" data-id="{{item.id}}" bindtap="deleteProduct">删除</button></view></view>
  </view>
  <view class="hint">当前数据只存储在本机微信开发者工具中，正式上线前必须接后端并验证商家权限。</view>
</view>
