<view wx:if="{{accessLoading}}" class="merchant-page">正在核验商家权限…</view>
<view wx:if="{{accessError}}" class="merchant-page">{{accessError}}<navigator url="/pages/merchant-login/merchant-login">微信登录并验证店铺权限</navigator></view>
<view wx:if="{{workspaceAuthorized}}" class="merchant-page">
  <view class="merchant-hero">
    <view class="merchant-eyebrow">MERCHANT CENTER</view>
    <view class="merchant-hero-row">
      <view>
        <view class="merchant-title">商家工作台</view>
        <view class="merchant-subtitle">日常经营，一处管理</view>
      </view>
      <view style="display:flex;gap:12px;align-items:center"><button wx:if="{{canOpenCustomer}}" size="mini" bindtap="openCustomerShop">进入顾客端</button><navigator class="merchant-account" url="/pages/merchant-login/merchant-login">账号与权限 <text>›</text></navigator></view>
    </view>
  </view>

  <view class="merchant-content">
    <navigator class="merchant-pending" url="/pages/admin-orders/admin-orders">
      <view class="merchant-pending-mark">!</view>
      <view class="merchant-pending-info">
        <view class="merchant-pending-title">待处理订单</view>
      <view class="merchant-pending-sub">{{pendingError || (pendingLoading ? '正在同步订单数量…' : '待支付 ' + (unpaidOrderCount === null ? '—' : unpaidOrderCount) + ' 单 · 待接单 ' + (pendingNewOrderCount === null ? '—' : pendingNewOrderCount) + ' 单')}}</view>
      </view>
      <view wx:if="{{(pendingNewOrderCount || 0) + (unpaidOrderCount || 0) > 0}}" class="merchant-count">{{(pendingNewOrderCount || 0) + (unpaidOrderCount || 0)}}</view>
      <view wx:else class="merchant-count merchant-count-empty">{{pendingNewOrderCount === null ? '—' : '0'}}</view>
      <text class="merchant-arrow">›</text>
    </navigator>

    <view class="merchant-section-title">常用操作</view>
    <view class="merchant-shortcuts">
      <navigator url="/pages/admin-products/admin-products" class="merchant-shortcut"><view class="merchant-shortcut-icon">🛍️</view><text>商品管理</text></navigator>
      <navigator url="/pages/admin-orders/admin-orders" class="merchant-shortcut"><view class="merchant-shortcut-icon">📦</view><text>订单管理</text></navigator>
      <navigator url="/pages/store-hours/store-hours" class="merchant-shortcut"><view class="merchant-shortcut-icon">⏰</view><text>营业管理</text></navigator>
      <navigator url="/pages/admin-billing/admin-billing" class="merchant-shortcut"><view class="merchant-shortcut-icon">🧾</view><text>营业账单</text></navigator>
    </view>

    <view class="merchant-section-title">商品与店铺</view>
    <view class="merchant-group">
      <navigator class="merchant-item" url="/pages/admin-categories/admin-categories"><view class="merchant-item-symbol">🗂️</view><view class="merchant-item-text"><view class="merchant-item-name">分类管理</view><view class="merchant-item-desc">整理商品分类与顺序</view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item" url="/pages/admin-placeholders/admin-placeholders"><view class="merchant-item-symbol">🖼️</view><view class="merchant-item-text"><view class="merchant-item-name">图片显示设置</view><view class="merchant-item-desc">商品缺图时的展示样式</view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item" url="/pages/delivery/delivery"><view class="merchant-item-symbol">🚚</view><view class="merchant-item-text"><view class="merchant-item-name">配送设置</view><view class="merchant-item-desc">配送区域、范围及时间</view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item merchant-last" url="/pages/admin-note-tags/admin-note-tags"><view class="merchant-item-symbol">✎</view><view class="merchant-item-text"><view class="merchant-item-name">备注标签</view><view class="merchant-item-desc">管理下单快捷备注</view></view><text class="merchant-arrow">›</text></navigator>
    </view>

    <view class="merchant-section-title">店铺首页展示</view>
    <view class="merchant-minimum">
      <view class="merchant-setting-heading">首页副标题</view>
      <view class="merchant-setting-desc">显示在首页店铺名称下方，最多50个字符；留空可恢复默认文案。</view>
      <view wx:if="{{!homeSubtitleEditing}}" class="merchant-minimum-row">
        <text class="merchant-minimum-current">{{homeSubtitle}}</text>
        <button class="merchant-save" size="mini" bindtap="beginHomeSubtitleEdit" disabled="{{!settingsReady || homeSubtitleSaving}}">编辑</button>
      </view>
      <view wx:else>
        <input class="merchant-minimum-input merchant-subtitle-input" maxlength="50" value="{{homeSubtitleDraft}}" bindinput="onHomeSubtitleInput" placeholder="精选好物 · 便捷选购" disabled="{{homeSubtitleSaving}}" />
        <view class="merchant-minimum-row">
          <button class="merchant-save" size="mini" bindtap="saveHomeSubtitle" loading="{{homeSubtitleSaving}}" disabled="{{homeSubtitleSaving || !settingsReady}}">保存</button>
          <button size="mini" bindtap="cancelHomeSubtitleEdit" disabled="{{homeSubtitleSaving}}">取消</button>
        </view>
      </view>
    </view>

    <view class="merchant-section-title">首页宣传横幅</view>
    <view class="merchant-minimum">
      <view class="merchant-setting-heading">精选优惠宣传图（{{promoBanners.length}}/10）</view>
      <view class="merchant-setting-desc">建议上传 4:1 横向图片，例如 1200 × 300 像素。重要内容请放在中央，避免手机屏幕裁切边缘。支持 JPG、PNG、WebP，单张不超过 5MB。</view>
      <view class="merchant-setting-desc">顾客可左右滑动查看，超过一张时自动轮播。未上传时隐藏此区域，不影响折扣专区。</view>
      <view wx:if="{{promoBanners.length}}" class="merchant-promo-list">
        <view wx:for="{{promoBanners}}" wx:key="key" class="merchant-promo-item">
          <view class="merchant-promo-meta"><text>第 {{index + 1}} 张</text><text>{{index === 0 ? '首图' : '轮播图'}}</text></view>
          <image class="merchant-promo-preview" src="{{item.url}}" mode="aspectFill"/>
          <view class="merchant-promo-actions">
            <button size="mini" bindtap="uploadPromoBanner" data-index="{{index}}" disabled="{{promoBannerBusy || !settingsReady}}">更换</button>
            <button size="mini" bindtap="changePromoOrder" data-index="{{index}}" data-offset="-1" disabled="{{promoBannerBusy || index === 0}}">上移</button>
            <button size="mini" bindtap="changePromoOrder" data-index="{{index}}" data-offset="1" disabled="{{promoBannerBusy || index === promoBanners.length - 1}}">下移</button>
            <button size="mini" bindtap="removePromoBanner" data-index="{{index}}" disabled="{{promoBannerBusy}}">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="merchant-promo-empty">尚未上传 · 首页自动隐藏</view>
      <view wx:if="{{promoBannerError}}" class="merchant-setting-desc merchant-promo-error">{{promoBannerError}}</view>
      <view class="merchant-promo-actions merchant-promo-footer">
        <button class="merchant-save" size="mini" bindtap="uploadPromoBanner" loading="{{promoBannerBusy}}" disabled="{{promoBannerBusy || promoBanners.length >= 10 || !settingsReady || settingsSaving || homeSubtitleSaving}}">添加横幅</button>
        <button wx:if="{{promoBanners.length}}" size="mini" bindtap="hidePromoBanner" disabled="{{promoBannerBusy || !settingsReady}}">全部隐藏</button>
      </view>
    </view>

    <view class="merchant-section-title">经营设置</view>
    <view class="merchant-minimum">
      <view class="merchant-setting-heading">起送金额</view>
      <view class="merchant-setting-desc">商品合计达到设定金额才能下单；设为 0 则不限制。</view>
      <view wx:if="{{!minimumEditing}}" class="merchant-minimum-row"><text class="merchant-yen">¥</text><text class="merchant-minimum-current">{{minimumOrderInput || '—'}}</text><button class="merchant-save" size="mini" bindtap="beginMinimumEdit" disabled="{{settingsLoading || settingsSaving || !settingsReady}}">编辑</button></view>
      <view wx:else class="merchant-minimum-row"><text class="merchant-yen">¥</text><input class="merchant-minimum-input" type="digit" value="{{minimumOrderInput}}" bindinput="onMinimumOrderInput" placeholder="0.00" disabled="{{settingsLoading || settingsSaving || !settingsReady}}" /><button class="merchant-save" size="mini" bindtap="saveMinimumOrder" disabled="{{settingsLoading || settingsSaving || !settingsReady}}">{{settingsSaving ? '保存中' : '保存'}}</button><button size="mini" bindtap="cancelMinimumEdit" disabled="{{settingsSaving}}">取消</button></view>
      <view wx:if="{{settingsError}}" class="merchant-setting-desc">{{settingsError}}<text bindtap="refreshMinimum"> · 点击重新读取</text></view>
    </view>

    <view class="merchant-section-title">配送收费</view>
    <view class="merchant-minimum">
      <view class="merchant-minimum-row"><text>收取固定配送费</text><switch checked="{{deliveryFeeEnabled}}" color="#16865d" disabled="{{!cloudMode || !settingsReady || settingsSaving || trackingSaving || deliveryFeeSaving}}" bindchange="toggleDeliveryFee"/></view>
      <view class="merchant-setting-desc">默认免费配送；开启后每单按固定金额收费。起送金额仍按商品小计计算。</view>
      <view wx:if="{{!deliveryFeeEditing}}" class="merchant-minimum-row"><text>每单 ¥{{deliveryFeeInput}}</text><button class="merchant-save" size="mini" bindtap="beginDeliveryFeeEdit" disabled="{{!cloudMode || !settingsReady || settingsSaving || deliveryFeeSaving}}">编辑</button></view>
      <view wx:else class="merchant-minimum-row"><text class="merchant-yen">¥</text><input class="merchant-minimum-input" type="digit" placeholder="0.00" value="{{deliveryFeeInput}}" bindinput="onDeliveryFeeInput" disabled="{{deliveryFeeSaving}}"/><button class="merchant-save" size="mini" bindtap="saveDeliveryFee" disabled="{{deliveryFeeSaving}}">保存</button><button size="mini" bindtap="cancelDeliveryFeeEdit" disabled="{{deliveryFeeSaving}}">取消</button></view>
    </view>
    <view class="merchant-section-title">配送位置隐私</view>
    <view class="merchant-minimum">
      <view class="merchant-minimum-row"><text>允许顾客查看配送实时位置</text><switch checked="{{shareDeliveryLocation}}" disabled="{{!cloudMode || !settingsReady || settingsSaving || trackingSaving}}" bindchange="toggleTrackingVisibility" color="#16865d"/></view>
      <view class="merchant-setting-desc">默认关闭。开启后，仍需配送人员为当前订单主动授权共享；关闭会阻止新的位置上传并隐藏坐标。</view>
    </view>
    <view class="merchant-section-title">服务与数据</view>
    <navigator class="merchant-item" url="/pages/merchant-reviews/merchant-reviews"><view class="merchant-item-text"><view class="merchant-item-name">商品评价</view><view class="merchant-item-desc">查看评分、回复与举报 · 审核由平台负责</view></view><text class="merchant-arrow">›</text></navigator>
    <navigator class="merchant-item" url="/pages/store-code/store-code"><view class="merchant-item-text"><view class="merchant-item-name">店铺小程序码</view><view class="merchant-item-desc">微信官方码 · 保存、分享与打印图片</view></view><text class="merchant-arrow">›</text></navigator>
    <view class="merchant-group">
      <navigator class="merchant-item" url="/pages/admin-analytics/admin-analytics"><view class="merchant-item-symbol">📊</view><view class="merchant-item-text"><view class="merchant-item-name">经营分析</view><view class="merchant-item-desc">销售趋势、商品表现与经营报表</view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item" url="/pages/support-inbox/support-inbox"><view class="merchant-item-symbol">✉️</view><view class="merchant-item-text"><view class="merchant-item-name">客服消息</view><view class="merchant-item-desc">查看与回复顾客咨询<text wx:if="{{cloudMode}}"> · 未读 {{supportUnread === null ? '—' : supportUnread}}</text><text wx:if="{{supportError}}"> · {{supportError}}</text></view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item" url="/pages/merchant-members/merchant-members"><view class="merchant-item-symbol">👥</view><view class="merchant-item-text"><view class="merchant-item-name">成员与权限管理</view><view class="merchant-item-desc">邀请商家成员、查看及撤销授权</view></view><text class="merchant-arrow">›</text></navigator>
      <navigator class="merchant-item merchant-last" url="/pages/admin-backup/admin-backup"><view class="merchant-item-symbol">💾</view><view class="merchant-item-text"><view class="merchant-item-name">数据备份与恢复</view><view class="merchant-item-desc">导出与导入商家数据</view></view><text class="merchant-arrow">›</text></navigator>
    </view>
    <view class="merchant-footnote">部分功能仍在逐步接入云端；操作结果以实际保存状态为准。</view>
  </view>
</view>
