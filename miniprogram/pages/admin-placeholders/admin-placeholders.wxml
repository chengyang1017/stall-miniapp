<view class="page">
<view class="hint">{{cloudMode ? '云端店铺缺图设置，顾客与商家共用；自定义图不会写入商品真实图片字段。' : '本机演示缺图设置'}}<text wx:if="{{busy}}"> · 正在处理…</text></view>
<view wx:if="{{error}}" class="hint">{{error}}</view><button size="mini" bindtap="refresh" disabled="{{busy}}">重新读取设置</button>

<view class="card stall-placeholder-admin-card" ><view class="subheading">商品缺图样式</view>
  <view class="merchant-style-gallery-v1">
<view class="merchant-gallery-card {{placeholderStyle === 'classic' ? 'merchant-gallery-selected' : ''}}" data-style="classic" bindtap="chooseGalleryStyle">
<view class="merchant-gallery-preview"><view class="stall-empty-thumb-v4 stall-classic-picker"><view class="stall-classic-icon"><view class="stall-classic-sun"></view><view class="stall-classic-hill"></view></view><text class="stall-classic-text">暂无图片</text></view></view>
<view class="merchant-gallery-footer"><text>经典图案</text><text wx:if="{{placeholderStyle === 'classic'}}" class="merchant-gallery-check">已选中</text></view></view><view class="merchant-gallery-card {{placeholderStyle === 'mountain' ? 'merchant-gallery-selected' : ''}}" data-style="mountain" bindtap="chooseGalleryStyle">
<view class="merchant-gallery-preview"><view class="stall-empty-thumb-v4 stall-empty-art-v5"><view class="stall-art-frame-v5"><view class="stall-art-sun-v5"></view><view class="stall-art-hill-back-v5"></view><view class="stall-art-hill-front-v5"></view></view><text class="stall-art-label-v5">暂无图片</text></view></view>
<view class="merchant-gallery-footer"><text>山峰插画</text><text wx:if="{{placeholderStyle === 'mountain'}}" class="merchant-gallery-check">已选中</text></view></view><view class="merchant-gallery-card {{placeholderStyle === 'bag' ? 'merchant-gallery-selected' : ''}}" data-style="bag" bindtap="chooseGalleryStyle">
<view class="merchant-gallery-preview"><view class="stall-empty-thumb-v4 stall-bag-placeholder-v6"><view class="stall-bag-icon-v6"><view class="stall-bag-handle-v6"></view><view class="stall-bag-body-v6"></view></view><text class="stall-bag-label-v6">暂无图片</text></view></view>
<view class="merchant-gallery-footer"><text>购物袋</text><text wx:if="{{placeholderStyle === 'bag'}}" class="merchant-gallery-check">已选中</text></view></view><view class="merchant-gallery-card {{placeholderStyle === 'playful' ? 'merchant-gallery-selected' : ''}}" data-style="playful" bindtap="chooseGalleryStyle">
<view class="merchant-gallery-preview"><view class="stall-empty-thumb-v4 stall-art-placeholder-v7"><view class="stall-art-glow-v7"></view><view class="stall-art-spark-v7 stall-art-spark-left-v7"></view><view class="stall-art-spark-v7 stall-art-spark-right-v7"></view><view class="stall-art-shadow-v7"></view><view class="stall-art-box-v7"><view class="stall-art-box-side-v7"></view><view class="stall-art-box-front-v7"></view><view class="stall-art-box-top-v7"></view><view class="stall-art-ribbon-v7"></view><view class="stall-art-face-left-v7"></view><view class="stall-art-face-right-v7"></view><view class="stall-art-smile-v7"></view></view><text class="stall-art-caption-v7">暂无图片</text></view></view>
<view class="merchant-gallery-footer"><text>彩色礼盒</text><text wx:if="{{placeholderStyle === 'playful'}}" class="merchant-gallery-check">已选中</text></view></view><view class="merchant-gallery-card {{placeholderStyle === 'premium' ? 'merchant-gallery-selected' : ''}}" data-style="premium" bindtap="chooseGalleryStyle">
<view class="merchant-gallery-preview"><view class="stall-empty-thumb-v4 stall-premium-art-v8"><view class="spa-v8-background"></view><view class="spa-v8-halo"></view><view class="spa-v8-ring"></view><view class="spa-v8-dot spa-v8-dot-a"></view><view class="spa-v8-dot spa-v8-dot-b"></view><view class="spa-v8-star spa-v8-star-a"></view><view class="spa-v8-star spa-v8-star-b"></view><view class="spa-v8-shadow"></view><view class="spa-v8-package"><view class="spa-v8-box-side"></view><view class="spa-v8-box-front"></view><view class="spa-v8-box-lid"></view><view class="spa-v8-ribbon-front"></view><view class="spa-v8-ribbon-top"></view><view class="spa-v8-bow spa-v8-bow-left"></view><view class="spa-v8-bow spa-v8-bow-right"></view><view class="spa-v8-bow-center"></view><view class="spa-v8-sticker"><view class="spa-v8-sticker-heart"></view></view></view><view class="spa-v8-label"><text>暂无图片</text></view></view></view>
<view class="merchant-gallery-footer"><text>精品礼盒</text><text wx:if="{{placeholderStyle === 'premium'}}" class="merchant-gallery-check">已选中</text></view></view><view class="merchant-gallery-card merchant-gallery-upload" bindtap="uploadCustomPlaceholder"><view class="merchant-gallery-preview"><image wx:if="{{customPlaceholderUrl}}" src="{{customPlaceholderUrl}}" mode="aspectFill" class="merchant-gallery-upload-image" /><view wx:else class="merchant-gallery-upload-art"><view class="merchant-gallery-plus">+</view><text>上传图片</text></view></view><view class="merchant-gallery-footer"><text>自定义图片</text><text wx:if="{{placeholderStyle === 'custom'}}" class="merchant-gallery-check">已选中</text></view></view></view>
  <view class="stall-custom-actions"><button wx:if="{{customPlaceholderUrl}}" size="mini" bindtap="removeCustomPlaceholder">移除自定义图</button></view>
  <text class="stall-placeholder-admin-hint">自定义占位图仅供当前设备演示，正式上线需上传到服务器。</text>
</view>
</view>
