<view class="account-page">
 <view class="account-card"><view class="avatar-circle">我</view><view class="account-title">{{loggedIn ? (nickname || '微信用户') : '未登录'}}</view><view class="account-hint">{{loggedIn ? '账号资料已连接云端' : '请先在「我的」页面登录'}}</view></view>
 <view wx:if="{{loggedIn}}" class="editor-card"><view class="editor-title">基本资料</view><view class="field-title">昵称</view><input class="nickname-editor" maxlength="30" value="{{nickname}}" placeholder="输入昵称" bindinput="onNicknameInput"/><view class="editor-help">最多30个字符，不影响微信昵称</view><button class="primary-btn" loading="{{profileBusy}}" disabled="{{profileBusy}}" bindtap="saveNickname">保存修改</button><view wx:if="{{profileStatus}}" class="profile-message">{{profileStatus}}</view></view>
 <view class="footnote">头像上传及手机号绑定将在后续版本开放。</view>
</view>