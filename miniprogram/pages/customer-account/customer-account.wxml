<view class="account-page">
 <view class="account-card"><view class="avatar-circle avatar-{{avatarStyle}}">我</view><view class="account-title">{{loggedIn ? (nickname || '微信用户') : '未登录'}}</view><view class="account-hint">{{loggedIn ? '账号资料已连接云端' : '请先在「我的」页面登录'}}</view></view>
 <view wx:if="{{loggedIn}}" class="editor-card"><view class="editor-title">基本资料</view><view class="field-title">头像样式</view><view class="avatar-options"><view class="avatar-choice avatar-violet" data-style="violet" bindtap="chooseAvatarStyle">我</view><view class="avatar-choice avatar-blue" data-style="blue" bindtap="chooseAvatarStyle">我</view><view class="avatar-choice avatar-green" data-style="green" bindtap="chooseAvatarStyle">我</view><view class="avatar-choice avatar-peach" data-style="peach" bindtap="chooseAvatarStyle">我</view></view><view wx:if="{{avatarStatus}}" class="profile-message">{{avatarStatus}}</view><view class="field-title">昵称</view><input class="nickname-editor" maxlength="30" value="{{nickname}}" placeholder="输入昵称" bindinput="onNicknameInput"/><view class="editor-help">最多30个字符，不影响微信昵称</view><button class="primary-btn" loading="{{profileBusy}}" disabled="{{profileBusy}}" bindtap="saveNickname">保存修改</button><view wx:if="{{profileStatus}}" class="profile-message">{{profileStatus}}</view></view>
 <view class="footnote">目前支持云端头像样式；相册照片上传与手机号绑定仍在开发。</view>
</view>