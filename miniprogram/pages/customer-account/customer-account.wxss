page{background:#f7f5ff}
.account-page{min-height:100vh;background:#f7f5ff;padding-bottom:80rpx}
.profile-hero{height:365rpx;background:linear-gradient(116deg,#5731cf 0%,#7548e6 53%,#af81f2 100%);position:relative;overflow:hidden}
.hero-orb{position:absolute;right:107rpx;top:32rpx;width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,215,222,.6)}
.hero-wave{position:absolute;width:850rpx;height:260rpx;border-radius:50% 50% 0 0;bottom:-210rpx;left:50rpx;transform:rotate(-12deg)}
.wave-back{background:rgba(220,183,255,.21);bottom:-188rpx;left:155rpx}.wave-front{background:rgba(82,39,185,.32);left:340rpx;bottom:-200rpx}
.hero-user{position:absolute;left:40rpx;top:55rpx;display:flex;align-items:center;gap:24rpx}
.hero-avatar{width:130rpx;height:130rpx;position:relative;border:5rpx solid #fff;border-radius:50%;background:linear-gradient(145deg,#fbd2bc,#e68971);display:flex;align-items:center;justify-content:center;color:white;box-sizing:border-box}
.avatar-photo{width:100%;height:100%;border-radius:50%}.avatar-placeholder{font-size:74rpx;color:white}
.avatar-camera{position:absolute;bottom:-5rpx;right:-7rpx;width:38rpx;height:38rpx;border-radius:50%;background:#783dff;border:3rpx solid #fff;display:flex;align-items:center;justify-content:center;font-size:28rpx}
.hero-name{font-size:38rpx;color:white;font-weight:700}.hero-subtitle{margin-top:10rpx;color:#fff;font-size:25rpx}
.account-content{position:relative;margin:-28rpx 28rpx 0}
.settings-card{background:#fff;border-radius:27rpx;padding:9rpx 30rpx;box-shadow:0 10rpx 28rpx rgba(88,49,159,.045);margin-bottom:22rpx}
.settings-row{display:flex;align-items:center;gap:20rpx;min-height:113rpx;border-bottom:1rpx solid #eeeafb;padding:14rpx 4rpx;box-sizing:border-box}
.nickname-row,.phone-row{min-height:136rpx}
.last-row{border-bottom:0}
.outline-icon{width:45rpx;flex-shrink:0;color:#854cff;font-size:40rpx;text-align:center;font-weight:400}
.row-main{flex:1;min-width:0}.row-title{font-size:29rpx;font-weight:600;color:#241938}.row-hint{font-size:22rpx;color:#a198b3;margin-top:8rpx}
.row-value{font-size:26rpx;color:#9082a7;text-align:right;max-width:250rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nickname-input{width:195rpx;text-align:right;font-size:28rpx;color:#2e2342}
.chevron{font-size:38rpx;color:#9c8eb2;margin-left:5rpx}
.copy-mark{font-size:34rpx;color:#75618d;padding:8rpx}
.phone-right{display:flex;align-items:center;gap:8rpx}.phone-action{margin:0;padding:0 16rpx;font-size:23rpx;height:56rpx;line-height:56rpx;color:#7542dc;background:#f0e8ff;border-radius:13rpx}.phone-action::after{border:0}
.danger-card{margin-top:22rpx}
.save-button{margin-top:20rpx;border-radius:40rpx;background:linear-gradient(90deg,#6540e8,#a168f4);color:white;font-size:30rpx;font-weight:600;height:89rpx;line-height:89rpx}.save-button::after{border:0}
.inline-message{padding:15rpx 20rpx;font-size:23rpx;color:#7754a6;line-height:1.5}
.login-note{padding:32rpx;text-align:center;color:#86769e}
