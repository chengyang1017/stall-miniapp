page{background:#f5f6f8}.page{padding:28rpx}.title{font-size:38rpx;font-weight:bold;margin-bottom:24rpx}.card{background:white;border-radius:18rpx;padding:28rpx;margin-bottom:24rpx}.heading{font-weight:bold;font-size:32rpx;margin-bottom:16rpx}.line{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eee;padding:12rpx 0;gap:8rpx}.line text{flex:1;font-size:24rpx}.line button{margin:0}.card input{background:#f5f6f8;padding:18rpx;margin-top:14rpx;border-radius:12rpx}.card>button{margin-top:18rpx;background:#16865d;color:white}.tip{color:#888;font-size:24rpx;line-height:1.6}

.delivery-toolbar{position:sticky;top:0;z-index:5;display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;padding:18rpx;margin:18rpx 0;background:#eff8f1;border-radius:12rpx;font-size:24rpx}.delivery-toolbar button{margin:0}.error{background:#fff1e5;color:#a65b24;border-radius:12rpx;padding:18rpx;font-size:25rpx;line-height:1.6}.success{color:#16865d;padding:18rpx;font-size:25rpx}.area-editor,.slot-editor,.special-date{border-top:1rpx solid #e5ece6;padding:18rpx 0;overflow-wrap:anywhere}.mini-actions{display:flex;gap:12rpx;flex-wrap:wrap;margin:14rpx 0}.mini-actions button{margin:0}.time-choice{padding:18rpx;background:#f1f6f2;border-radius:10rpx;font-size:26rpx;margin:12rpx 0}.delivery-checks{display:flex;flex-wrap:wrap;gap:8rpx;margin:16rpx 0;font-size:24rpx}.delivery-checks label{display:flex;align-items:center;min-height:58rpx;overflow-wrap:anywhere}.delivery-checks checkbox{transform:scale(.72)}.area-geo-block{font-size:24rpx;margin-top:18rpx}.card input{min-width:0;box-sizing:border-box}.tip{overflow-wrap:anywhere}
