<view class="category-page">
  <view wx:if="{{loading && !ready}}" class="global-loading-wrap"><view class="global-loading-spinner"></view></view>
  <view wx:if="{{error}}" class="note-error">{{error}}</view>
  <view class="panel">
    <view class="panel-title">新增标签</view>
    <view class="add-row">
      <input class="name-input" placeholder="输入标签名称" maxlength="20" value="{{draft}}" bindinput="typeDraft" disabled="{{!ready}}" />
      <button class="add-btn" size="mini" bindtap="add" disabled="{{!ready}}">添加</button>
    </view>
  </view>
  <view class="panel">
    <view class="panel-title">标签列表</view>
    <view wx:if="{{ready && tags.length === 0}}" class="empty">暂无标签</view>
    <view wx:else class="sort-area" style="height:{{areaHeight}}px;">
      <view wx:for="{{rows}}" wx:key="key" class="sort-row {{draggingIndex === index ? 'is-dragging' : ''}}" style="height:{{rowHeight}}px;transform:translateY({{item.y}}px);">
        <view class="cat-row {{editingIndex === index ? 'is-editing' : ''}}">
          <view class="category-row-icon"><text class="note-glyph">▦</text></view>
          <view class="cat-info">
            <input wx:if="{{editingIndex === index}}" class="inline-cat-input" maxlength="20" value="{{editingValue}}" bindinput="typeEdit" bindconfirm="saveEdit" confirm-type="done" />
            <text wx:else class="cat-name">{{item.name}}</text>
          </view>
          <block wx:if="{{editingIndex === index}}">
            <button class="save-inline-btn" size="mini" bindtap="saveEdit">保存</button>
            <button class="cancel-inline-btn" size="mini" bindtap="cancelEdit">取消</button>
          </block>
          <block wx:else>
            <button class="edit-btn" size="mini" data-index="{{index}}" bindtap="edit">编辑</button>
            <button class="delete-btn" size="mini" data-index="{{index}}" bindtap="remove">删除</button>
          </block>
          <view class="handle" data-index="{{index}}" catchtouchstart="handleStart" catchtouchmove="handleMove" catchtouchend="handleEnd" catchtouchcancel="handleEnd">☰</view>
        </view>
      </view>
    </view>
  </view>
</view>
