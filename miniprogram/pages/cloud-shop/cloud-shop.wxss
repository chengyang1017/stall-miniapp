.shop{min-height:100vh;background:#f5f7f6;padding:24rpx;box-sizing:border-box}.panel,.product{background:white;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx}.heading{font-weight:700;font-size:34rpx;margin-bottom:14rpx}.hint{font-size:23rpx;color:#748079;margin:12rpx 0;line-height:1.5}.product{display:flex;gap:24rpx}.thumb{width:150rpx;height:150rpx;border-radius:12rpx;flex-shrink:0}.product-body{flex:1}.name{font-size:29rpx;font-weight:600}.price{color:#16865d;font-weight:700;margin:16rpx 0}.actions{display:flex;align-items:center;gap:16rpx}.actions button{margin:0}.detail-image{width:320rpx;height:320rpx}
