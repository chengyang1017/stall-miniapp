page{background:#f5f6f8}.hours-page{padding:28rpx;padding-bottom:100rpx}.hours-card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx}.hours-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.hours-heading{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.hours-tip{font-size:24rpx;color:var(--brand-muted);line-height:1.6;display:block;margin:10rpx 0}.hours-notice{box-sizing:border-box;width:100%;min-height:130rpx;padding:18rpx;background:#f5f6f8;border-radius:12rpx;margin-bottom:18rpx;font-size:27rpx}.hours-day{border-bottom:1rpx solid #eee;padding:20rpx 0}.hours-range{display:flex;align-items:center;gap:16rpx;margin-top:12rpx}.hours-time{padding:16rpx 22rpx;background:var(--brand-background);border-radius:10rpx;color:var(--brand-primary)}button[type=primary]{background:var(--brand-primary);margin-top:24rpx}
@import "../../styles/merchant-theme.wxss";
