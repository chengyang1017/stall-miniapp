page{background:#f7f6fb;color:#352843}
.members-page{padding:24rpx 26rpx 65rpx}
.members-intro{padding:12rpx 4rpx 22rpx}
.members-heading{font-size:35rpx;font-weight:700;color:#342548}
.members-subheading{font-size:23rpx;color:#8f829e;margin-top:10rpx}
.members-card{padding:27rpx;border-radius:24rpx;background:#fff;margin-bottom:20rpx;box-shadow:0 5rpx 20rpx rgba(75,43,113,.04)}
.members-card-title{font-size:30rpx;font-weight:700;margin-bottom:16rpx}
.members-count{font-size:23rpx;color:#846da3;font-weight:400}
.members-desc,.members-hint{font-size:23rpx;color:#81758e;line-height:1.65;margin-bottom:20rpx}
.members-hint{margin:16rpx 0 0;overflow-wrap:anywhere}
.members-primary{background:#6533d0!important;color:#fff!important;font-size:27rpx;border-radius:15rpx}
.members-invitation{display:flex;align-items:center;gap:12rpx;margin-top:20rpx;padding:15rpx;border-radius:14rpx;background:#f5f1fc}
.members-invitation text{font-size:23rpx;flex:1;min-width:0;overflow-wrap:anywhere;color:#5731a4}
.members-invitation button{margin:0}
.members-item{display:flex;align-items:center;gap:16rpx;padding:21rpx 0;border-bottom:1rpx solid #f0edf5}
.members-avatar{height:66rpx;width:66rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eee5fa;color:#7844d7;font-size:32rpx}
.members-meta{flex:1;min-width:0}
.members-name{font-size:26rpx;font-weight:650}
.members-role{font-size:22rpx;color:#93869f;margin-top:5rpx}
.members-remove{color:#bd465c!important;background:#fff3f5!important;margin:0}
.members-refresh{margin-top:25rpx;background:#f4f0fc;color:#6b3db9;font-size:25rpx}
.members-empty{padding:25rpx;color:#91859f;text-align:center}
.members-error{color:#b34550}
.members-loading{display:flex;align-items:center;justify-content:center;min-height:38vh}
