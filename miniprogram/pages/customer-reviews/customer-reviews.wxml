<view class="page"><view class="card"><view class="title">{{mode === 'form' ? '评价商品' : '我的评价'}}</view><view wx:if="{{!cloudMode}}" class="notice">本机演示不生成虚构已购评价；真实评价须登录云端并核验交易。</view><view wx:if="{{error}}" class="error">{{error}}</view><button size="mini" bindtap="login" disabled="{{busy}}">微信登录</button><view class="notice">{{policyText}}</view>
 <block wx:if="{{cloudMode && mode === 'form'}}"><view>订单商品：{{productName || '正在核对商品'}}</view><view class="notice">{{eligibilityReason}}</view><view wx:if="{{!eligible}}" class="error">资格尚未满足；支付标签不等于可信收款。</view><picker range="{{[1,2,3,4,5]}}" value="{{rating - 1}}" bindchange="rate" disabled="{{busy || pendingSubmit || !eligible}}"><view class="picker">评分：{{rating}} / 5 星 ›</view></picker><textarea maxlength="500" value="{{content}}" bindinput="input" placeholder="文字可留空，最多500字；请勿包含电话、地址等私人信息" disabled="{{busy || pendingSubmit || !eligible}}"/><view wx:for="{{photos}}" wx:key="key" class="photo"><image wx:if="{{item.path}}" src="{{item.path}}" mode="aspectFit"/><text>图片 {{index + 1}} · {{item.imageId ? '已关联私有图片' : '未上传'}}</text><button size="mini" data-index="{{index}}" bindtap="previewPhoto">预览图片</button><button size="mini" data-index="{{index}}" bindtap="removePhoto" disabled="{{busy || pendingSubmit}}">移除</button></view><button bindtap="choose" disabled="{{busy || pendingSubmit || !eligible || photos.length >= 3}}">选择图片（最多3张，每张5MB）</button><button bindtap="uploadPhotos" disabled="{{busy || pendingSubmit || !eligible}}" loading="{{busy}}">上传未确认图片</button><button bindtap="preview">{{previewing ? '收起预览' : '预览评价'}}</button><view wx:if="{{previewing}}" class="preview"><view>{{rating}} 星 · {{content || '仅评分'}}</view><view>{{photos.length}} 张图片；发布前需平台审核。</view></view><button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !eligible}}">{{pendingSubmit ? '使用原编号重试提交' : '提交并等待审核'}}</button><button bindtap="back" disabled="{{busy}}">返回我的评价／核对结果</button></block>
 <block wx:if="{{cloudMode && mode === 'list'}}"><button bindtap="refresh" loading="{{loading}}" disabled="{{loading || busy}}">刷新我的评价</button><view wx:if="{{!loading && !rows.length}}">尚无评价记录</view><block wx:for="{{rows}}" wx:key="id"><review-card row="{{item}}" bind:images="images"/><view>审核：{{item.statusText}} · 回复：{{item.replyStatusText}}</view><view wx:if="{{item.publicRating}}" class="notice">当前公开版本：{{item.publicRating}} 星，{{item.publicContent}}。修改候选未经审核不会替换它。</view><button wx:if="{{item.canEdit}}" size="mini" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">修改评价</button><button wx:if="{{!item.withdrawnAt}}" size="mini" data-id="{{item.id}}" bindtap="withdraw" disabled="{{busy}}">撤回评价</button></block><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多</button></block>
</view></view>
