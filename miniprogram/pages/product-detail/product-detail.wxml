<view class="page">
  <view class="hero">
    <image wx:if="{{imageUrl}}" class="photo" src="{{imageUrl}}" mode="aspectFill" />
    <view wx:else class="placeholder">商品图片待上传</view>
  </view>
  <view class="card">
    <view class="category">{{categoryName}}</view>
    <view class="name">{{name}}</view>
    <view class="price">¥{{current}} <text wx:if="{{discounted}}" class="old">¥{{original}}</text></view>
    <view wx:if="{{discounted}}" class="sale">限时优惠</view>
    <view class="category">{{inventoryText}}</view>
    <view wx:if="{{manualSoldOut}}" class="unavailable">商家手动售罄</view>
    <view wx:if="{{!available}}" class="unavailable">商品未上架、手动售罄或库存不足，暂不可购买</view>
  </view>
  <view class="card">
    <view class="subtitle">商品介绍</view>
    <view class="description">{{description || '商家暂未填写商品介绍。'}}</view>
  </view>
  <view class="card quantity-row">
    <text>购买数量</text>
    <view class="counter"><button size="mini" bindtap="decrease" disabled="{{quantity <= 1}}">−</button><text>{{quantity}}</text><button size="mini" bindtap="increase" disabled="{{quantity >= maxQuantity}}">＋</button></view>
  </view>
  <view class="footer">
    <view><view class="label">合计</view><view class="total">¥{{totalText}}</view></view>
    <view class="actions"><button bindtap="addCart" disabled="{{!available}}">加入购物车</button><button type="primary" bindtap="buyNow" disabled="{{!available}}">立即购买</button></view>
  </view>
</view>
