page{background:#f5f6f8}.page{padding-bottom:160rpx}.hero{height:380rpx;background:#e8eeea}.photo{height:100%;width:100%}.placeholder{height:100%;display:flex;align-items:center;justify-content:center;color:#81918a;font-size:29rpx}.card{background:#fff;padding:28rpx;margin:18rpx 24rpx;border-radius:18rpx}.category{color:#16865d;font-size:24rpx;margin-bottom:12rpx}.name{font-weight:bold;font-size:38rpx;color:#222}.price{font-size:38rpx;font-weight:bold;color:#16865d;margin-top:18rpx}.old{font-size:26rpx;color:#aaa;text-decoration:line-through;margin-left:15rpx}.sale{font-size:24rpx;color:#ef7f3f;margin-top:8rpx}.unavailable{margin-top:12rpx;color:#a44;font-size:26rpx}.subtitle{font-size:30rpx;font-weight:bold;margin-bottom:15rpx}.description{font-size:27rpx;color:#666;line-height:1.7;white-space:pre-wrap}.quantity-row{display:flex;align-items:center;justify-content:space-between}.counter{display:flex;align-items:center;gap:16rpx}.counter button{margin:0;min-width:65rpx}.footer{position:fixed;bottom:0;left:0;right:0;padding:20rpx 24rpx;display:flex;align-items:center;justify-content:space-between;background:#fff;box-shadow:0 -2rpx 12rpx #0001;gap:12rpx}.label{font-size:23rpx;color:#888}.total{font-size:34rpx;color:#16865d;font-weight:bold}.actions{display:flex;gap:10rpx}.actions button{margin:0;font-size:26rpx;padding:0 18rpx}
