<view class="bill-page">
  <view class="bill-header"><view class="bill-title">营业账单</view><view class="bill-hint">{{cloudMode ? '云端数据库账单 · CNY · 北京时间' : '本机演示订单 · 并非真实收款流水'}}</view></view>
  <view wx:if="{{loading}}" class="global-loading-wrap"><view class="global-loading-spinner"></view></view>
  <view wx:if="{{error}}" class="bill-warning">{{error}}<button disabled="{{exporting}}" size="mini" bindtap="refresh">重试</button></view>
  <view class="bill-filter">
    <picker disabled="{{exporting}}" mode="date" start="2000-01-01" end="2100-12-31" value="{{day}}" bindchange="chooseDay"><view class="bill-date">选择日期：{{day}}　⌄</view></picker>
    <view class="bill-actions"><button disabled="{{exporting}}" size="mini" bindtap="selectToday">今天</button><button disabled="{{exporting}}" size="mini" bindtap="selectAll">全部日期</button></view>
    <view class="bill-hint">范围：{{allDates ? '全部日期' : day}}</view>
  </view>
  <view wx:if="{{!loading && !error}}" class="bill-grid">
    <view class="bill-stat"><text>有效订单金额</text><view>¥{{orderValue}}</view></view>
    <view class="bill-stat"><text>微信已核验收款（退款前）</text><view>¥{{received}}</view></view>
    <view class="bill-stat"><text>待付款金额</text><view>¥{{unpaid}}</view></view>
    <view class="bill-stat"><text>总订单 / 取消 / 已送达</text><view>{{count}} / {{cancelled}} / {{delivered}}</view></view>
  </view>
  <view wx:if="{{cloudMode && livePayEnabled && !error}}" class="bill-grid">
    <view class="bill-stat"><text>已确认成功退款</text><view>¥{{refunded}}</view></view>
    <view class="bill-stat"><text>已核验收款净额（未扣手续费）</text><view>¥{{netReceived}}</view></view>
    <view class="bill-stat"><text>待确认退款金额</text><view>¥{{pendingRefunds}}</view></view>
    <view class="bill-stat"><text>异常到账待处理</text><view>¥{{abnormalCollections}}</view></view>
  </view>
  <view wx:if="{{cloudMode && livePayEnabled && abnormalRecords.length && !error}}" class="bill-anomaly-section">
    <view class="bill-section"><text>异常到账记录（最近 {{abnormalRecords.length}} 笔）</text><button size="mini" disabled="{{exporting || loading}}" bindtap="exportAbnormalCsv">导出核对 CSV</button></view>
    <view class="bill-warning">这些是需要核对的收款记录，并不代表已经退款。请以微信商户平台的交易记录为准。</view>
    <view wx:for="{{abnormalRecords}}" wx:key="transactionId" class="bill-anomaly-row">
      <view class="bill-order-top"><text>{{item.date}} {{item.time}}</text><text class="bill-money">¥{{item.amount}}</text></view>
      <view class="bill-id">订单：{{item.orderId}}</view>
      <view class="bill-id">微信交易号：{{item.transactionId}}</view>
    </view>
    <view wx:if="{{abnormalRecordsMore}}" class="bill-warning">只显示最近 10 笔。其余异常到账请在微信商户平台核对。</view>
  </view>
  <view wx:if="{{cloudMode && livePayEnabled && reviewRefunds}}" class="bill-warning">需人工复核的退款 {{reviewRefunds}} 笔；请到订单页核对。</view>
  <view class="bill-warning">{{notice}} 即使订单已送达，也不代表已付款。</view>
  <view class="bill-section"><text>订单明细（已加载 {{rows.length}} / {{count}}）</text><button disabled="{{exporting}}" size="mini" type="primary" bindtap="exportCsv">{{exporting ? '导出中…' : '导出账单（CSV）'}}</button></view>
  <view wx:if="{{rows.length === 0 && !loading && !error}}" class="bill-empty">所选日期暂无订单</view>
  <view wx:for="{{rows}}" wx:key="id" class="bill-order">
    <view class="bill-order-top"><text>{{item.date}} {{item.time}}</text><text class="bill-money">¥{{item.amount}}</text></view>
    <view class="bill-id">{{item.id}}</view>
    <view>{{item.items}}</view>
    <view class="bill-order-bottom"><text>{{item.status}} · {{item.payment}}</text><text>{{item.name}}</text></view>
  </view>
  <view wx:if="{{moreError}}" class="bill-warning">{{moreError}}</view>
  <button wx:if="{{hasMore}}" bindtap="loadMore" disabled="{{loadingMore || exporting || loading}}">{{loadingMore ? '加载中…' : '加载更多账单'}}</button>
</view>
