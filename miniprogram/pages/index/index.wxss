@import "../../styles/customer-catalog.wxss";

/* Tighter storefront rhythm: keep content readable without tall empty bands. */
.home-body{padding-top:0}
.home-sync-status{height:auto;min-height:30rpx;line-height:30rpx;margin:4rpx 0}
.deals-section{margin:8rpx 0 14rpx;padding:18rpx 16rpx}
.feature-swiper{height:164rpx;margin-top:12rpx}
.feature-swiper .feature-banner{height:164rpx}
.feature-banner{height:164rpx;margin-top:12rpx;padding:18rpx 26rpx}
.feature-banner image{height:130rpx}
.quick-grid{gap:12rpx;margin:14rpx 0}
.quick-grid>view{border-radius:20rpx;padding:12rpx 0}

/* Compact store trading status, replacing the tall generic notice row. */
.home-catalog .store-status-strip{display:flex;align-items:center;gap:9rpx;min-height:42rpx;margin:4rpx 2rpx 10rpx;padding:0 10rpx;box-sizing:border-box;overflow:hidden}
.store-status-dot{width:12rpx;height:12rpx;flex:0 0 12rpx;border-radius:50%;background:#dca15d}
.store-status-dot.is-open{background:#26aa78}
.store-status-label{flex-shrink:0;font-size:22rpx;font-weight:650;color:#71538f;white-space:nowrap}
.store-status-notice{flex:1;min-width:0;font-size:21rpx;color:#9a8cad;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.deals-subtitle{min-width:0;overflow:hidden;text-overflow:ellipsis;text-align:right;font-size:20rpx}
.deals-track{padding:2rpx 2rpx 7rpx}

/* Keep the status line concise without changing the discount section. */
.home-catalog .store-status-strip{min-height:32rpx;margin:2rpx 0 5rpx;padding:0 5rpx;gap:7rpx}
.home-catalog .store-status-label{font-size:21rpx}
.home-catalog .store-status-notice{font-size:20rpx}

/* Adaptive discount cards: fill the section for 1 or 2 items, scroll for more. */
.deals-track-single,.deals-track-double{width:100%;box-sizing:border-box;display:flex;gap:12rpx}
.deals-track-single .deal-product{flex:1 1 100%;width:100%;min-width:0;padding:12rpx}
.deals-track-single .deal-product-content{display:flex;align-items:center;gap:20rpx;min-height:146rpx}
.deals-track-single .deal-media{flex:0 0 148rpx;width:148rpx;height:148rpx}
.deals-track-single .deal-copy{flex:1;min-width:0}
.deals-track-single .deal-name{font-size:29rpx;margin:0 0 12rpx;white-space:normal;max-height:76rpx;line-height:38rpx;overflow:hidden}
.deals-track-single .deal-prices{flex-wrap:wrap;white-space:normal}
.deals-track-single .deal-price{font-size:31rpx}
.deals-track-single .deal-original{font-size:20rpx}
.deals-track-double .deal-product{flex:1 1 0;width:0;min-width:0}
.deals-track-double .deal-media{height:150rpx}
.deals-track-double .deal-name{font-size:25rpx}
.deals-track-double .deal-price{font-size:27rpx}

/* Merchant-managed promotion banner; entirely absent without an uploaded image. */
.home-promo-banner{width:100%;height:180rpx;overflow:hidden;border-radius:24rpx;margin:12rpx 0}
.home-promo-image{display:block;width:100%;height:100%}
