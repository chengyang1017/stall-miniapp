<import src="../../templates/customer-product.wxml"/>
<import src="../../templates/product-placeholder.wxml"/>
<view class="customer-hero">
<view class="hero-title">{{storeName}}</view>
<view class="hero-subtitle">{{homeSubtitle}}</view>
<view class="customer-search" bindtap="openSearch" role="button" aria-label="打开商品搜索">
  <view class="search-input-area">
    <text class="search-symbol">⌕</text>
    <text class="search-placeholder">搜索商品名称</text>
  </view>
  <view class="search-submit">搜索</view>
</view>
</view>
<view class="home-body">
<view wx:if="{{cloudStatus && !entryLoading && !cloudBusy}}" class="home-sync-status" aria-live="polite">{{cloudStatus}}</view>
<view wx:if="{{entryError || cloudConnectionError}}" class="surface stall-connect-card">
<view>暂时无法连接商店</view>
<view class="notice">{{entryError || '请检查网络后重试'}}</view>
<button size="mini" bindtap="retryStoreEntry">重新连接</button>
</view>
<view wx:if="{{cloudStatus && !cloudBusy}}" class="notice" bindtap="loadCloudHome">{{cloudStatus}} · 点击重试</view>
<view wx:if="{{entryBlocking && !entryError && !cloudConnectionError}}">
<view class="skeleton">
</view>
<view class="skeleton">
</view>
</view>
<view class="home-catalog" hidden="{{entryBlocking || cloudConnectionError || !!entryError}}">
<view wx:if="{{businessInfo.label || businessInfo.notice}}" class="store-status-strip">
  <view class="store-status-dot {{businessInfo.open ? 'is-open' : ''}}"></view>
  <text wx:if="{{businessInfo.label}}" class="store-status-label">{{businessInfo.label}}</text>
  <text wx:if="{{businessInfo.notice}}" class="store-status-notice">{{businessInfo.notice}}</text>
</view>
<view class="deals-section">
  <view class="deals-heading">
    <view class="deals-title"><text class="deals-title-icon">%</text><text>折扣专区</text></view>
    <text class="deals-subtitle">{{dealsHasMore ? '更多优惠 · 向右滑 ›' : (discountedProducts.length > 2 ? '向右滑查看更多 ›' : '精选优惠商品')}}</text>
  </view>
  <scroll-view wx:if="{{discountedProducts.length}}" scroll-x class="deals-scroll" show-scrollbar="{{false}}" lower-threshold="100" bindscrolltolower="loadMoreDeals" enhanced="{{true}}">
    <view class="deals-track {{discountedProducts.length === 1 ? 'deals-track-single' : ''}}">
      <view wx:for="{{discountedProducts}}" wx:key="id" class="deal-product" data-trace-list="discountedProducts" data-trace-key="{{item.id}}">
        <render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="home" list-name="discountedProducts" row-key="{{item.id}}"/>
        <view class="deal-product-content" data-id="{{item.id}}" bindtap="openProduct" role="button">
          <view class="deal-media">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/>
            <view wx:else class="deal-placeholder"><template is="productPlaceholder" data="{{placeholderStyle,customPlaceholderUrl}}"/></view>
            <text class="deal-percent">-{{item.discountPercent}}%</text>
          </view>
          <view class="deal-copy"><view class="deal-name">{{item.name}}</view>
          <view class="deal-prices"><text class="deal-price">¥{{item.current}}</text><text class="deal-original">¥{{item.original}}</text></view></view>
        </view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{!discountedProducts.length && !cloudBusy && !entryLoading}}" class="deals-empty">
    <text>暂无折扣商品</text>
    <text class="deals-empty-link" bindtap="goCategories">浏览全部商品 ›</text>
  </view>
  <view wx:if="{{discountedProducts.length && (dealsHasMore || dealError)}}" class="deals-load-more" bindtap="loadMoreDeals">{{dealError || (dealBusy ? '正在加载更多优惠…' : '继续向右滑，发现更多优惠 ›')}}</view>
</view>
<view wx:if="{{promoBannerUrl}}" class="home-promo-banner">
  <image class="home-promo-image" src="{{promoBannerUrl}}" mode="aspectFill" lazy-load="{{true}}"/>
</view>
<view class="quick-grid">
<view bindtap="goCategories">
<text>✦</text>全部商品</view>
<view bindtap="showDeals">
<text>♢</text>优惠</view>
<view bindtap="showDelivery">
<text>♧</text>配送</view>
<view bindtap="openFavorites">
<text>♡</text>收藏</view>
</view>
<view class="section-heading">
<text>▦ 商品分类</text>
<text class="more" bindtap="goCategories">查看全部 ›</text>
</view>
<scroll-view scroll-x class="category-scroll">
<view class="category-track">
<view class="category {{selectedCategory === 'all' ? 'active' : ''}}" data-id="all" bindtap="chooseCategory">
<image class="category-icon" src="{{selectedCategory === 'all' ? allCategoryIcon.iconActivePath : allCategoryIcon.iconPath}}" mode="aspectFit"/>全部</view>
<view wx:for="{{categories}}" wx:key="id" class="category {{selectedCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory">
<image class="category-icon" src="{{selectedCategory === item.id ? item.iconActivePath : item.iconPath}}" mode="aspectFit"/>{{item.name}}</view>
</view>
</scroll-view>
<view class="section-heading">
<text>✧ 推荐商品</text>
<text class="more" bindtap="goCategories">查看更多 ›</text>
</view>
<view class="product-grid">
<view wx:for="{{products}}" wx:key="id" class="product" data-trace-list="products" data-trace-key="{{item.id}}">
<render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="home" list-name="products" row-key="{{item.id}}"/>
<template is="productCard" data="{{item,placeholderStyle,customPlaceholderUrl}}"/>
</view>
</view>
<view wx:if="{{!products.length && !cloudBusy}}" class="empty">暂无符合条件的商品</view>
<button wx:if="{{hasMore}}" class="load-more" loading="{{cloudBusy}}" disabled="{{cloudBusy}}" bindtap="loadMoreProducts">加载更多商品</button>
<button wx:if="{{shareReady}}" open-type="share" class="share-shop">分享店铺</button>
</view>
</view>
