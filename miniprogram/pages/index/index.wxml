<import src="../../templates/customer-product.wxml"/>
<view class="customer-hero">
<view class="hero-title">{{storeName}}</view>
<view class="hero-subtitle">精选好物 · 便捷选购</view>
<view class="customer-search">
<text class="search-symbol">⌕</text>
<input maxlength="100" value="{{searchInput}}" bindinput="inputSearch" bindconfirm="searchProducts" confirm-type="search" placeholder="搜索商品名称"/>
<button bindtap="searchProducts">搜索</button>
<button wx:if="{{searchInput}}" bindtap="clearSearch">×</button>
</view>
</view>
<view class="home-body">
<view class="home-sync-status" aria-live="polite">{{entryLoading ? '正在确认店铺…' : cloudBusy ? '正在同步商品' : cloudStatus}}</view>
<view wx:if="{{entryError || cloudConnectionError}}" class="surface stall-connect-card">
<view>暂时无法连接商店</view>
<view class="notice">{{entryError || '请检查网络后重试'}}</view>
<button size="mini" bindtap="retryStoreEntry">重新连接</button>
</view>
<view wx:if="{{cloudStatus && !cloudBusy}}" class="notice" bindtap="loadCloudHome">{{cloudStatus}} · 点击重试</view>
<view wx:if="{{entryBlocking && !entryError && !cloudConnectionError}}">
<view class="skeleton">
</view>
<view class="skeleton">
</view>
</view>
<view class="home-catalog" hidden="{{entryBlocking || cloudConnectionError || !!entryError}}">
<view wx:if="{{businessInfo.label || businessInfo.notice}}" class="notice">{{businessInfo.label}} {{businessInfo.notice}}</view>
<view class="deals-section" hidden="{{!discountedProducts.length}}">
<view class="section-heading">
<text>✦ 优惠专区</text>
<text class="more">好物优惠 · 以实时价格为准</text>
</view>
<scroll-view scroll-x class="deals-scroll">
<view class="deals-track">
<view wx:for="{{discountedProducts}}" wx:key="id" class="product deal-product" data-trace-list="discountedProducts" data-trace-key="{{item.id}}">
<render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="home" list-name="discountedProducts" row-key="{{item.id}}"/>
<template is="productCard" data="{{item,placeholderStyle,customPlaceholderUrl}}"/>
</view>
</view>
</scroll-view>
<view wx:if="{{dealsHasMore || dealError}}" class="notice" bindtap="loadMoreDeals">{{dealError || (dealBusy ? '加载中…' : '查看更多优惠 ›')}}</view>
</view>
<swiper wx:if="{{discountedProducts.length}}" class="feature-swiper" indicator-dots circular indicator-active-color="#ffffff">
<swiper-item wx:for="{{discountedProducts}}" wx:key="id">
<view class="feature-banner" data-id="{{item.id}}" bindtap="openProduct">
<view>
<text class="feature-label">精选优惠</text>
<view class="feature-title">{{item.name}}</view>
<view>¥{{item.current}} · 立即选购 ›</view>
</view>
<image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/>
</view>
</swiper-item>
</swiper>
<view wx:else class="feature-banner" bindtap="goCategories">
<view>
<text class="feature-label">发现好物</text>
<view class="feature-title">{{storeName}}</view>
<view>浏览店铺商品 ›</view>
</view>
<text class="feature-art">✧</text>
</view>
<view class="quick-grid">
<view bindtap="goCategories">
<text>✦</text>全部商品</view>
<view bindtap="showDeals">
<text>♢</text>优惠</view>
<view bindtap="showDelivery">
<text>♧</text>配送</view>
<view bindtap="unavailable">
<text>♡</text>收藏</view>
</view>
<view class="section-heading">
<text>▦ 商品分类</text>
<text class="more" bindtap="goCategories">查看全部 ›</text>
</view>
<scroll-view scroll-x class="category-scroll">
<view class="category-track">
<view class="category {{selectedCategory === 'all' ? 'active' : ''}}" data-id="all" bindtap="chooseCategory">
<text class="category-icon">{{allCategoryIcon.iconGlyph}}</text>全部</view>
<view wx:for="{{categories}}" wx:key="id" class="category {{selectedCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory">
<text class="category-icon">{{item.iconGlyph}}</text>{{item.name}}</view>
</view>
</scroll-view>
<view class="section-heading">
<text>✧ 推荐商品</text>
<text class="more" bindtap="goCategories">查看更多 ›</text>
</view>
<view class="product-grid">
<view wx:for="{{products}}" wx:key="id" class="product" data-trace-list="products" data-trace-key="{{item.id}}">
<render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="home" list-name="products" row-key="{{item.id}}"/>
<template is="productCard" data="{{item,placeholderStyle,customPlaceholderUrl}}"/>
</view>
</view>
<view wx:if="{{!products.length && !cloudBusy}}" class="empty">暂无符合条件的商品</view>
<button wx:if="{{hasMore}}" class="load-more" loading="{{cloudBusy}}" disabled="{{cloudBusy}}" bindtap="loadMoreProducts">加载更多商品</button>
<button wx:if="{{shareReady}}" open-type="share" class="share-shop">分享店铺</button>
</view>
</view>
