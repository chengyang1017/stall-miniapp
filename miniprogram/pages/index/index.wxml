
<view class="page">

<view class="hero">
  <view class="hero-title">小摊商店</view>
  <view>欢迎选购 · 人民币结算</view>
</view>

<!-- 限时折扣专区 -->
<view wx:if="{{discountedProducts.length > 0}}">

  <view class="heading">🔥 限时折扣</view>

  <view
    wx:for="{{discountedProducts}}"
    wx:key="id"
    class="product"
  >
    <view class="details">
      <view class="name">{{item.name}}</view>
      <view class="sale">限时优惠</view>

      <view class="price">
        ¥{{item.current}}
        <text class="old">¥{{item.original}}</text>
      </view>
    </view>

    <button
      size="mini"
      data-id="{{item.id}}"
      bindtap="addCart"
    >
      加入
    </button>
  </view>

</view>

<!-- 商品分类 -->
<view class="heading">商品分类</view>

<scroll-view class="categories" scroll-x="true">

  <view
    class="category {{selectedCategory === 'all' ? 'active' : ''}}"
    data-id="all"
    bindtap="chooseCategory"
  >
    全部
  </view>

  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="category {{selectedCategory === item.id ? 'active' : ''}}"
    data-id="{{item.id}}"
    bindtap="chooseCategory"
  >
    {{item.name}}
  </view>

</scroll-view>

<!-- 商品列表 -->
<view class="heading">商品列表</view>

<view wx:if="{{products.length === 0}}" class="empty">
  暂无商品
</view>

<view
  wx:for="{{products}}"
  wx:key="id"
  class="product"
>
  <view class="details">
    <view class="name">{{item.name}}</view>

    <view wx:if="{{item.discounted}}" class="sale">
      限时折扣
    </view>

    <view class="price">
      ¥{{item.current}}

      <text wx:if="{{item.discounted}}" class="old">
        ¥{{item.original}}
      </text>
    </view>
  </view>

  <button
    size="mini"
    disabled="{{!item.available}}"
    data-id="{{item.id}}"
    bindtap="addCart"
  >
    {{item.available ? '加入' : '售罄'}}
  </button>
</view>

<!-- 底部购物车 -->
<view class="footer">
  <view>
    <view>购物车 {{cartCount}} 件</view>
    <view class="footer-price">¥{{cartTotal}}</view>
  </view>

  <button size="mini" type="primary" bindtap="goCart">
    查看购物车
  </button>
</view>

<view class="admin-entry" bindtap="goAdmin">
  商家管理演示
</view>

</view>
