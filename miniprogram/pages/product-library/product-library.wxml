<view class="library-page">
  <view class="library-tabs"><button class="{{kind === 'favorites' ? 'selected' : ''}}" data-kind="favorites" bindtap="chooseKind">♡ 我的收藏</button><button class="{{kind === 'history' ? 'selected' : ''}}" data-kind="history" bindtap="chooseKind">◷ 浏览记录</button></view>
  <view class="library-notice">仅保存在当前设备，按账号和店铺分别记录，不跨设备同步。浏览记录最多保留最近100件商品。</view>
  <view class="library-toolbar"><text>{{rows.length}} 件商品</text><button size="mini" disabled="{{!rows.length || loading || clearing}}" bindtap="clearRecords">清空{{kind === 'favorites' ? '收藏' : '记录'}}</button></view>
  <view wx:if="{{loading}}" class="library-status" aria-live="polite">正在确认商品信息…</view>
  <view wx:if="{{error}}" class="library-error">{{error}}<button size="mini" bindtap="loadRecords">重新读取</button></view>
  <view wx:if="{{!loading && !error && !rows.length}}" class="library-empty"><text>{{kind === 'favorites' ? '♡' : '◷'}}</text><view>{{kind === 'favorites' ? '还没有收藏商品' : '还没有浏览记录'}}</view><view class="library-hint">{{kind === 'favorites' ? '打开商品详情，点击底部收藏即可保存。' : '成功打开商品详情后，会自动记录在这里。'}}</view></view>
  <view wx:for="{{rows}}" wx:key="id" class="library-card">
    <view class="library-product" data-id="{{item.id}}" bindtap="openProduct" aria-label="{{item.name}}">
      <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="library-image-empty">▧</view>
      <view class="library-info"><view class="library-name">{{item.name}}</view><view class="library-hint">{{item.status}}</view><view class="library-price">¥{{item.priceText}}<text>{{item.confirmed ? '当前价' : '上次保存价格'}}</text></view></view>
    </view>
    <button size="mini" disabled="{{loading || clearing}}" data-id="{{item.id}}" catchtap="removeProduct">{{kind === 'favorites' ? '取消收藏' : '删除记录'}}</button>
  </view>
</view>
