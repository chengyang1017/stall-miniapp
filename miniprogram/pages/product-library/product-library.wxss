.library-page{min-height:100vh;box-sizing:border-box;background:#f7f3fc;padding:28rpx 24rpx 60rpx;color:#382447}
.library-tabs{display:flex;gap:12px}.library-tabs button{flex:1;margin:0;background:#fff;color:#776486;border-radius:22rpx;font-size:28rpx}.library-tabs .selected{background:#7137db;color:#fff}
.library-notice{font-size:24rpx;color:#8b789b;line-height:1.7;margin:24rpx 4rpx}.library-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22rpx}.library-toolbar button{margin:0;color:#7137db;background:#eee4ff}
.library-status,.library-error{font-size:26rpx;line-height:1.6;padding:20rpx 8rpx}.library-error{color:#a3485d}.library-error button{display:block;margin:12px 0;background:white}
.library-empty{text-align:center;padding:85rpx 20rpx}.library-empty>text{font-size:76rpx;color:#ad8cdd}.library-empty>view{margin-top:20rpx}.library-hint{font-size:24rpx;color:#97869f;line-height:1.6}
.library-card{background:white;border-radius:24rpx;padding:22rpx;margin-bottom:20rpx;display:flex;align-items:center;gap:12px}.library-product{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0}.library-product image,.library-image-empty{width:124rpx;height:124rpx;border-radius:16rpx;flex-shrink:0}.library-image-empty{background:#f1e9fb;display:flex;align-items:center;justify-content:center;color:#b79bd5;font-size:48rpx}.library-info{min-width:0;flex:1}.library-name{font-size:29rpx;font-weight:600;overflow-wrap:anywhere}.library-price{color:#7137db;font-size:30rpx;margin-top:8rpx}.library-price text{font-size:20rpx;color:#a08baf;margin-left:10rpx}.library-card button{margin:0;padding:0 14rpx;flex-shrink:0;background:#f5effd;color:#77558b;font-size:23rpx}
