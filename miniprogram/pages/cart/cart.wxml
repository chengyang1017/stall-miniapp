<view class="customer-hero"><view class="hero-title">购物车 ({{totalCount}})</view><view class="hero-subtitle">已选 {{selectedCount}} 件商品</view></view><view class="page"><view wx:if="{{presentationError}}" style="padding:16rpx;color:#a44;font-size:24rpx">{{presentationError}}</view>
  <!-- CART_CLEAR_V1 -->
  <view class="cart-clear-bar" wx:if="{{totalCount > 0}}">
    <view class="cart-select-all" bindtap="toggleAll"><text class="selection-check {{allSelected ? 'checked' : ''}}">{{allSelected ? '✓' : ''}}</text>全选</view><text class="cart-clear-hint">清空购物车</text>
    <view class="cart-clear-action" bindtap="clearCartConfirmed" aria-label="清空购物车">
      <image class="cart-clear-trash-img" src="/assets/cart-trash-red.png" mode="aspectFit" />
    </view>
  </view>

  <view class="cart-sync-status" aria-live="polite"><text>{{quantityPending ? '数量校验中，金额待确认' : cloudLoading ? '正在同步商品，已有内容保留' : deliveryLoading ? '正在核对配送规则' : (cloudMode && amountState !== 'confirmed') ? '价格待确认，请刷新核对' : ''}}</text></view>
  <view wx:if="{{cloudMode && quantityError}}" class="cart-sync-error">{{quantityError}}</view>
  <view wx:if="{{cloudMode && cloudError}}" class="cart-sync-error">{{cloudError}}</view>
  <view wx:if="{{cloudMode && deliveryError}}" class="cart-sync-error">{{deliveryError}}</view>
  <button wx:if="{{cloudMode && (cloudError || quantityError)}}" size="mini" bindtap="refresh" disabled="{{quantityPending || cloudLoading}}">重新核对商品</button>
  <view wx:if="{{items.length === 0 && !cloudLoading && !cloudError}}" class="empty">购物车还是空的</view>

  <view wx:for="{{items}}" wx:key="productId" class="cart-item" data-trace-list="items" data-trace-key="{{item.productId}}">
    <render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="cart" list-name="items" row-key="{{item.productId}}" />
    <!-- CART_THUMB_AND_FOOTER_V1 -->
    <view class="selection-check {{selectionMap[item.productId] !== false ? 'checked' : ''}}" data-id="{{item.productId}}" bindtap="toggleSelection">{{selectionMap[item.productId] !== false ? '✓' : ''}}</view><view class="cart-image-slot">
      <image wx:if="{{item.imageUrl}}" class="cart-product-image" src="{{item.imageUrl}}" mode="aspectFill" />
      <!-- UNIFIED_PLACEHOLDER_THUMB_V1 -->
<view wx:else class="stall-placeholder-choice-shell">
  <image wx:if="{{(placeholderStyle === 'custom') ? (customPlaceholderUrl) : false}}" class="stall-custom-placeholder-preview" src="{{customPlaceholderUrl}}" mode="aspectFill" />
  <view wx:if="{{placeholderStyle === 'classic'}}" class="stall-empty-thumb-v4 stall-classic-picker"><view class="stall-classic-icon"><view class="stall-classic-sun"></view><view class="stall-classic-hill"></view></view><text class="stall-classic-text">暂无图片</text></view>
  <view wx:if="{{placeholderStyle === 'mountain'}}" class="stall-empty-thumb-v4 stall-empty-art-v5">
    <view class="stall-art-frame-v5">
      <view class="stall-art-sun-v5"></view>
      <view class="stall-art-hill-back-v5"></view>
      <view class="stall-art-hill-front-v5"></view>
    </view>
    <text class="stall-art-label-v5">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'bag'}}" class="stall-empty-thumb-v4 stall-bag-placeholder-v6">
    <view class="stall-bag-icon-v6">
      <view class="stall-bag-handle-v6"></view>
      <view class="stall-bag-body-v6"></view>
    </view>
    <text class="stall-bag-label-v6">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'playful'}}" class="stall-empty-thumb-v4 stall-art-placeholder-v7">
    <view class="stall-art-glow-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-left-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-right-v7"></view>
    <view class="stall-art-shadow-v7"></view>
    <view class="stall-art-box-v7">
      <view class="stall-art-box-side-v7"></view>
      <view class="stall-art-box-front-v7"></view>
      <view class="stall-art-box-top-v7"></view>
      <view class="stall-art-ribbon-v7"></view>
      <view class="stall-art-face-left-v7"></view>
      <view class="stall-art-face-right-v7"></view>
      <view class="stall-art-smile-v7"></view>
    </view>
    <text class="stall-art-caption-v7">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'premium'}}" class="stall-empty-thumb-v4 stall-premium-art-v8">
    <view class="spa-v8-background"></view>
    <view class="spa-v8-halo"></view>
    <view class="spa-v8-ring"></view>
    <view class="spa-v8-dot spa-v8-dot-a"></view>
    <view class="spa-v8-dot spa-v8-dot-b"></view>
    <view class="spa-v8-star spa-v8-star-a"></view>
    <view class="spa-v8-star spa-v8-star-b"></view>
    <view class="spa-v8-shadow"></view>
    <view class="spa-v8-package">
      <view class="spa-v8-box-side"></view>
      <view class="spa-v8-box-front"></view>
      <view class="spa-v8-box-lid"></view>
      <view class="spa-v8-ribbon-front"></view>
      <view class="spa-v8-ribbon-top"></view>
      <view class="spa-v8-bow spa-v8-bow-left"></view>
      <view class="spa-v8-bow spa-v8-bow-right"></view>
      <view class="spa-v8-bow-center"></view>
      <view class="spa-v8-sticker"><view class="spa-v8-sticker-heart"></view></view>
    </view>
    <view class="spa-v8-label"><text>暂无图片</text></view>
  </view>
</view>
    </view>
    <view class="cart-item-content">
    <view class="cart-title-line"><view class="product-name">{{item.name}}</view><view class="remove-item" data-id="{{item.productId}}" bindtap="removeItem" aria-label="移除商品">×</view></view>
    <view wx:if="{{item.inventoryText}}" style="font-size:22rpx;color:{{item.stockInsufficient ? '#b33' : '#777'}}">{{item.inventoryText}}</view>
    <view class="item-bottom">
      <view>
        <view class="price">{{cloudMode ? '参考单价 ' : ''}}¥{{item.priceText}}</view>
        <view class="subtotal">小计：¥{{item.subtotalText}}</view>
      </view>
      <view class="quantity">
        <button size="mini" data-id="{{item.productId}}" bindtap="decrease">-</button>
        <text>{{item.quantity}}</text>
        <button size="mini" data-id="{{item.productId}}" bindtap="increase">+</button>
      </view>
    </view>
    </view>
  </view>

<view class="surface cart-services"><view class="service-row" bindtap="couponInfo"><text class="service-icon">♧</text><text>优惠券</text><text class="value">暂未开通 ›</text></view><navigator class="service-row" url="/pages/addresses/addresses"><text class="service-icon">♧</text><text>配送方式</text><text class="value">按地址核对 ›</text></navigator><view class="cart-delivery-note">{{deliveryError || deliveryInfo}}</view><view class="service-row"><text class="service-icon">♧</text><text>订单备注</text><input maxlength="200" value="{{orderNote}}" bindinput="updateCartNote" placeholder="口味、配送等要求"/></view></view><view class="surface cart-breakdown"><view class="section-heading">费用明细</view><view class="service-row"><text>已选商品（{{selectedCount}} 件）</text><text class="value">{{quantityPending || amountState !== 'confirmed' ? '金额待确认' : '¥' + selectedTotalText}}</text></view><view class="service-row"><text>配送费</text><text class="value">结算时按地址核对</text></view><view class="service-row"><text>优惠券</text><text class="value">未使用</text></view><view class="cart-pay-summary"><text>商品合计</text><text>{{quantityPending || amountState !== 'confirmed' ? '待确认' : '¥' + selectedTotalText}}</text></view><view class="notice">应付总额以结算页及服务器下单校验为准</view></view>
  <view class="footer cart-footer-compact" data-trace-list="footer" data-trace-key="cart-footer">
    <render-probe style="display:none" wx:if="{{uiTraceEnabled}}" page-name="cart" list-name="footer" row-key="cart-footer" />
    <view class="cart-footer-main">
      <view class="cart-footer-summary">
        <view class="cart-footer-count">已选 <text>{{selectedCount}}</text> 件<text class="quote-state">{{cloudMode && (quantityPending || amountState !== 'confirmed') ? ' · 待更新' : ''}}</text></view>
        <view class="total">¥<text>{{quantityPending || amountState !== 'confirmed' ? (selectedConfirmedTotalText || (confirmedTotalText || totalText)) : selectedTotalText}}</text></view>
      </view>
      <button class="cart-checkout" data-trace-list="checkout" data-trace-key="cart-checkout" type="primary" disabled="{{selectedCount === 0 || !selectedMinimumReached || !minimumReached || (cloudMode && (amountState !== 'confirmed' || quantityPending || cloudLoading || deliveryLoading || cloudError || deliveryError || !cloudDeliveryReady))}}" bindtap="checkout">去结算</button>
    </view>
    <view class="cart-footer-error" aria-live="polite" hidden="{{!(quantityError || cloudError || deliveryError || (selectedCount > 0 && !selectedMinimumReached))}}">{{quantityError ? '数量校验失败，请重试' : cloudError ? '商品金额未确认，请重试' : deliveryError ? '当前暂不可配送' : '未达到起送金额'}}</view>
  </view>
</view>
