<view class="page"><view wx:if="{{presentationError}}" style="padding:16rpx;color:#a44;font-size:24rpx">{{presentationError}}</view>
  <!-- CART_CLEAR_V1 -->
  <view class="cart-clear-bar" wx:if="{{totalCount > 0}}">
    <text class="cart-clear-hint">已选购 {{totalCount}} 件商品</text>
    <view class="cart-clear-action" bindtap="clearCartConfirmed" aria-label="清空购物车">
      <image class="cart-clear-trash-img" src="/assets/cart-trash-red.png" mode="aspectFit" />
    </view>
  </view>

  <view wx:if="{{cloudMode && cloudLoading}}" class="empty">正在读取云端商品…</view>
  <view wx:if="{{quantityPending || quantityError || (cloudMode && amountState !== 'confirmed')}}" class="empty">{{quantityError || (quantityPending ? '数量校验中，金额待确认' : '当前价格未确认，请刷新核对')}}</view>
  <view wx:if="{{cloudMode && cloudError}}" class="empty">{{cloudError}}</view>
  <button wx:if="{{cloudMode && (cloudError || quantityError)}}" size="mini" bindtap="refresh" disabled="{{quantityPending || cloudLoading}}">重新核对商品</button>
  <view wx:if="{{cloudMode && deliveryError}}" style="padding:16rpx;color:#a44;font-size:24rpx">{{deliveryError}}</view>
  <view wx:if="{{cloudMode && deliveryLoading}}" style="padding:16rpx;color:#777;font-size:24rpx">正在核对配送规则，暂不能结算…</view>
  <view wx:if="{{items.length === 0 && !cloudLoading && !cloudError}}" class="empty">购物车还是空的</view>

  <view wx:for="{{items}}" wx:key="productId" class="cart-item">
    <!-- CART_THUMB_AND_FOOTER_V1 -->
    <view class="cart-image-slot">
      <image wx:if="{{item.imageUrl}}" class="cart-product-image" src="{{item.imageUrl}}" mode="aspectFill" />
      <!-- UNIFIED_PLACEHOLDER_THUMB_V1 -->
<view wx:else class="stall-placeholder-choice-shell">
  <image wx:if="{{(placeholderStyle === 'custom') ? (customPlaceholderUrl) : false}}" class="stall-custom-placeholder-preview" src="{{customPlaceholderUrl}}" mode="aspectFill" />
  <view wx:if="{{placeholderStyle === 'classic'}}" class="stall-empty-thumb-v4 stall-classic-picker"><view class="stall-classic-icon"><view class="stall-classic-sun"></view><view class="stall-classic-hill"></view></view><text class="stall-classic-text">暂无图片</text></view>
  <view wx:if="{{placeholderStyle === 'mountain'}}" class="stall-empty-thumb-v4 stall-empty-art-v5">
    <view class="stall-art-frame-v5">
      <view class="stall-art-sun-v5"></view>
      <view class="stall-art-hill-back-v5"></view>
      <view class="stall-art-hill-front-v5"></view>
    </view>
    <text class="stall-art-label-v5">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'bag'}}" class="stall-empty-thumb-v4 stall-bag-placeholder-v6">
    <view class="stall-bag-icon-v6">
      <view class="stall-bag-handle-v6"></view>
      <view class="stall-bag-body-v6"></view>
    </view>
    <text class="stall-bag-label-v6">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'playful'}}" class="stall-empty-thumb-v4 stall-art-placeholder-v7">
    <view class="stall-art-glow-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-left-v7"></view>
    <view class="stall-art-spark-v7 stall-art-spark-right-v7"></view>
    <view class="stall-art-shadow-v7"></view>
    <view class="stall-art-box-v7">
      <view class="stall-art-box-side-v7"></view>
      <view class="stall-art-box-front-v7"></view>
      <view class="stall-art-box-top-v7"></view>
      <view class="stall-art-ribbon-v7"></view>
      <view class="stall-art-face-left-v7"></view>
      <view class="stall-art-face-right-v7"></view>
      <view class="stall-art-smile-v7"></view>
    </view>
    <text class="stall-art-caption-v7">暂无图片</text>
  </view>
  <view wx:if="{{placeholderStyle === 'premium'}}" class="stall-empty-thumb-v4 stall-premium-art-v8">
    <view class="spa-v8-background"></view>
    <view class="spa-v8-halo"></view>
    <view class="spa-v8-ring"></view>
    <view class="spa-v8-dot spa-v8-dot-a"></view>
    <view class="spa-v8-dot spa-v8-dot-b"></view>
    <view class="spa-v8-star spa-v8-star-a"></view>
    <view class="spa-v8-star spa-v8-star-b"></view>
    <view class="spa-v8-shadow"></view>
    <view class="spa-v8-package">
      <view class="spa-v8-box-side"></view>
      <view class="spa-v8-box-front"></view>
      <view class="spa-v8-box-lid"></view>
      <view class="spa-v8-ribbon-front"></view>
      <view class="spa-v8-ribbon-top"></view>
      <view class="spa-v8-bow spa-v8-bow-left"></view>
      <view class="spa-v8-bow spa-v8-bow-right"></view>
      <view class="spa-v8-bow-center"></view>
      <view class="spa-v8-sticker"><view class="spa-v8-sticker-heart"></view></view>
    </view>
    <view class="spa-v8-label"><text>暂无图片</text></view>
  </view>
</view>
    </view>
    <view class="cart-item-content">
    <view class="product-name">{{item.name}}</view>
    <view wx:if="{{item.inventoryText}}" style="font-size:22rpx;color:{{item.stockInsufficient ? '#b33' : '#777'}}">{{item.inventoryText}}</view>
    <view class="item-bottom">
      <view>
        <view class="price">{{cloudMode && (quantityPending || cloudLoading || amountState !== 'confirmed') ? '上次单价 ' : ''}}¥{{item.priceText}}</view>
        <view class="subtotal">小计：¥{{item.subtotalText}}</view>
      </view>
      <view class="quantity">
        <button size="mini" data-id="{{item.productId}}" bindtap="decrease">-</button>
        <text>{{item.quantity}}</text>
        <button size="mini" data-id="{{item.productId}}" bindtap="increase">+</button>
      </view>
    </view>
    </view>
  </view>

  <view class="footer cart-footer-compact">
    <view wx:if="{{cloudMode && deliveryInfo}}" style="font-size:23rpx;color:#66776b;margin-bottom:12rpx;">{{deliveryInfo}}<navigator url="/pages/addresses/addresses">选择或编辑收货地址 ›</navigator></view>
    <view wx:if="{{cloudMode}}" style="font-size:23rpx;color:#777">商品合计{{quantityPending || amountState !== 'confirmed' ? '待确认' : cloudLoading ? '（上次读取，正在刷新）' : '（以结算及下单校验为准）'}}</view>
    <view class="cart-footer-summary">
      <view class="cart-footer-count">共 {{totalCount}} 件商品</view>
      <view class="total">¥{{totalText}}</view>
    </view>
    <view wx:if="{{minimumOrderText && minimumOrderText !== '0.00'}}" style="font-size:24rpx;color:#666;margin-bottom:12rpx;">起送 ¥{{minimumOrderText}} <text wx:if="{{!minimumReached}}">· 还差 ¥{{minimumRemainingText}}</text><text wx:else> · 已达起送金额</text></view>
    <button type="primary" disabled="{{totalCount === 0 || !minimumReached || (cloudMode && (quantityPending || cloudLoading || deliveryLoading || cloudError || deliveryError || !cloudDeliveryReady))}}" bindtap="checkout">去结算</button>
  </view>
</view>
