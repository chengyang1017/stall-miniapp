@import "../../styles/customer-theme.wxss";
@import "../../styles/product-placeholder.wxss";

page {
  background: #f5f6f8;
}

.page {
  padding: 28rpx;
  padding-bottom: 180rpx;
}

.heading {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.cart-item {
  background: white;
  border-radius: 18rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.price {
  color: #c33232;
  font-size: 30rpx;
}

.subtotal {
  color: #888;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.quantity {
  display: flex;
  align-items: center;
}

.quantity button {
  margin: 0 12rpx;
  min-width: 60rpx;
}


.total {
  color: #c33232;
  font-size: 38rpx;
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

/* CART_CLEAR_V1 */
.cart-clear-bar { display:flex; align-items:center; justify-content:space-between; padding:8rpx 4rpx 22rpx; }
.cart-clear-hint { font-size:25rpx; color:#83918a; }
.cart-clear-action { font-size:26rpx; color:#c94d48; padding:14rpx 20rpx; background:#fff0ef; border-radius:14rpx; }
/* CART_COMPACT_FOOTER_V1 - keep clear icon full-size and compact summary */
.cart-clear-trash-img { width: 42rpx !important; height: 42rpx !important; display: block; }
/* CART_REPAIR_COMPACT_V2 */
.cart-clear-bar { display:flex; align-items:center; justify-content:space-between; padding:0 4rpx 14rpx; }
.cart-clear-hint { font-size:25rpx; color:#83918a; }
.cart-clear-action { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; padding:0; background:#fff0ef; border-radius:12rpx; }
.cart-clear-trash-img { display:block; width:44rpx !important; height:44rpx !important; }
/* CART_THUMB_AND_FOOTER_V1 */
.cart-item { display:flex; align-items:center; gap:22rpx; padding:22rpx !important; min-height:154rpx; box-sizing:border-box; }
.cart-image-slot { width:150rpx; height:150rpx; flex:0 0 150rpx; overflow:hidden; border-radius:16rpx; }
.cart-product-image { display:block; width:150rpx; height:150rpx; }
.cart-product-image-empty { width:150rpx; height:150rpx; background:linear-gradient(145deg,#f3efe6,#e6f2ea); display:flex; flex-direction:column; align-items:center; justify-content:center; color:#93a59b; }
.cart-image-empty-symbol { font-size:52rpx; line-height:1.1; }
.cart-image-empty-label { font-size:19rpx; margin-top:4rpx; }
.cart-item-content { flex:1; min-width:0; }
.cart-item-content .product-name { font-size:30rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.cart-item-content .item-bottom { margin-top:14rpx; gap:8rpx; }
.cart-item-content .quantity { flex-shrink:0; }
.cart-image-slot .stall-placeholder-choice-shell {width:150rpx;height:150rpx;min-width:150rpx;max-width:150rpx;} .cart-image-slot .stall-placeholder-choice-shell > view { transform:scale(1.136);transform-origin:top left;}

/* Reserved sync slot avoids inserting/removing 160rpx empty-state padding above rows. */
.cart-sync-status { height:44rpx; line-height:44rpx; font-size:23rpx; color:#77877d; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.cart-sync-error { padding:12rpx 0; color:#a44; font-size:24rpx; }

/* Native tabBar owns the safe area. The webview footer sits directly above it. */
.footer.cart-footer-compact {
  position:fixed; z-index:20; left:0; right:0; bottom:0;
  height:104rpx; box-sizing:border-box; padding:12rpx 24rpx;
  background:#fff; overflow:visible;
}
.cart-footer-main { height:80rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.cart-footer-summary { flex:1; min-width:0; height:76rpx; overflow:hidden; }
.cart-footer-count { height:28rpx; line-height:28rpx; font-size:22rpx; color:#8b7d9c; white-space:nowrap; }
.cart-footer-summary .total { height:44rpx; line-height:44rpx; font-size:32rpx; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-variant-numeric:tabular-nums; }
.cart-footer-main .cart-checkout { flex:0 0 220rpx; width:220rpx; height:72rpx; min-height:72rpx; line-height:72rpx; padding:0; margin:0; font-size:27rpx; box-sizing:border-box; }
.cart-footer-error { position:absolute; bottom:100%; left:0; right:0; height:32rpx; line-height:32rpx; padding:0 24rpx; box-sizing:border-box; color:#b34351; background:#fff1f3; font-size:21rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.quote-state{font-size:20rpx;color:#9c819f}.cart-delivery-note{font-size:22rpx;color:#8b7d9c;line-height:1.6;overflow-wrap:anywhere}


