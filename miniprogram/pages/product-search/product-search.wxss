page{background:#f7f5fb;color:#332742}.search-page{min-height:100vh;box-sizing:border-box}
.search-header{display:flex;align-items:center;gap:12rpx;background:#fff;padding:22rpx 22rpx;border-bottom:1rpx solid #eee9f4}
.search-back{flex:0 0 52rpx;height:66rpx;display:flex;align-items:center;justify-content:center;color:#66527e;font-size:54rpx;line-height:1}
.search-bar{display:flex;align-items:center;flex:1;min-width:0;height:72rpx;box-sizing:border-box;border-radius:42rpx;background:#f5f2fa;padding:0 20rpx;gap:12rpx}
.search-icon{font-size:36rpx;color:#9b8bac;line-height:1}.search-field{flex:1;min-width:0;width:0;height:58rpx;font-size:26rpx;color:#362847}
.search-clear{font-size:30rpx;color:#9e92ad;width:38rpx;text-align:center}.search-action{flex:0 0 74rpx;text-align:right;font-size:27rpx;font-weight:650;color:#7138d0;white-space:nowrap}
.search-content{padding:28rpx 24rpx 70rpx}.search-result-heading{display:flex;justify-content:space-between;align-items:center;margin:6rpx 0 20rpx}.search-result-heading text:first-child{font-size:30rpx;font-weight:700}.search-result-heading text:last-child{font-size:22rpx;color:#9486a1}
.search-state{padding:115rpx 25rpx;text-align:center;color:#6c587f;font-size:27rpx;font-weight:600}.search-state text{display:block;color:#9f91aa;font-size:23rpx;font-weight:400;margin-top:15rpx}.search-state .search-state-icon{font-size:75rpx;color:#c9b9df;margin-bottom:18rpx}
.search-results{display:flex;flex-direction:column;gap:16rpx}.search-product{display:flex;align-items:center;gap:20rpx;min-height:178rpx;padding:18rpx;background:#fff;border-radius:23rpx;box-shadow:0 5rpx 16rpx rgba(70,43,110,.045)}
.search-product-image,.search-product-empty{width:145rpx;height:145rpx;border-radius:16rpx;flex-shrink:0}.search-product-empty{background:#f0eafa;color:#b2a0cb;display:flex;align-items:center;justify-content:center;font-size:24rpx}
.search-product-info{display:flex;flex-direction:column;flex:1;min-width:0;gap:9rpx}.search-product-name{font-size:28rpx;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.search-product-stock{font-size:22rpx;color:#908399}.search-product-bottom{display:flex;align-items:center;gap:10rpx;margin-top:4rpx}
.search-price{color:#6f35d0;font-size:30rpx;font-weight:750}.search-original{font-size:21rpx;text-decoration:line-through;color:#aea1b9}.search-detail{margin-left:auto;color:#8865bd;font-size:22rpx}
.search-more{margin:24rpx auto;background:#f0e9fa;color:#7541be;border-radius:45rpx;font-size:25rpx}
.search-error{background:#fff0ed;color:#b14842;border-radius:15rpx;padding:18rpx;font-size:24rpx;margin-bottom:20rpx}.search-error text{margin-left:16rpx;color:#7140b9;text-decoration:underline}
