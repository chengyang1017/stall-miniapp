
page {
  background: #f5f6f8;
}

.page {
  box-sizing: border-box;
  padding: 28rpx;
  padding-bottom: 100rpx;
}

/* 页面标题 */
.heading {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 28rpx;
  color: #222;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.subheading {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #222;
}

/* 表单字段 */
.field {
  margin-bottom: 28rpx;
  font-size: 28rpx;
  color: #333;
}

.field text {
  display: block;
  margin-bottom: 12rpx;
}

/* 单行输入框：修复文字裁切 */
.field input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #222;
}

/* 多行备注输入框 */
.field textarea {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 140rpx;
  min-height: 140rpx;
  padding: 20rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #222;
}

/* 地区与配送时段选择框 */
.select {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 20rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

/* 商品清单 */
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eee;
}

/* 总金额 */
.total {
  color: #16865d;
  font-weight: bold;
}

/* 提示文字 */
.hint {
  color: #888;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

/* 普通提交按钮 */
.page > button {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #16865d;
  color: white;
  font-size: 28rpx;
}

/* address-card-phase8 */
.address-card { display:flex;align-items:center;justify-content:space-between;background:#f4faf7;border:1rpx solid #d7eadf;padding:26rpx;border-radius:14rpx;min-height:96rpx; }
.address-content { flex:1;min-width:0; }
.address-name { font-size:30rpx;font-weight:600;color:#202820; }
.address-detail { font-size:27rpx;color:#424a44;margin-top:12rpx;word-break:break-all; }
.address-hint { font-size:23rpx;color:#16865d;margin-top:13rpx; }
.address-placeholder { font-size:28rpx;color:#16865d; }
.address-arrow { font-size:44rpx;color:#16865d;margin-left:14rpx; }

/* CHECKOUT_NOTE_SHORTCUTS_V1 */
.checkout-note-presets {display:flex;flex-wrap:wrap;gap:14rpx;margin:14rpx 0 18rpx;}
.checkout-note-chip {padding:12rpx 19rpx;border-radius:999rpx;background:#edf7f1;border:1rpx solid #d1e8d9;color:#16865d;font-size:24rpx;line-height:1.3;}
.checkout-note-chip:active {opacity:.65;}