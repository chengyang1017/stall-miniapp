<view class="checkout-page">
  <view wx:if="{{cloudMode && cloudError}}" class="checkout-alert">{{cloudError}}<text class="checkout-retry" bindtap="refreshCloudCheckout">重新加载</text></view>
  <view class="checkout-section">
    <view class="section-head"><text class="section-icon">⌖</text><text>收货地址</text></view>
    <view class="checkout-address" bindtap="openAddresses">
      <view class="address-main" wx:if="{{hasAddress}}"><view class="address-person">{{selectedAddress.receiverName}} <text class="address-phone">{{selectedAddress.phone}}</text></view><view class="address-location">{{selectedAddress.area}} {{selectedAddress.detail}}</view></view>
      <view class="address-empty" wx:else>选择或添加收货地址</view>
      <text class="chevron">›</text>
    </view>
  </view>
  <view class="checkout-section">
    <view class="section-head"><text class="section-icon">◷</text><text>配送安排</text></view>
    <view wx:if="{{cloudMode}}" class="time-summary">按所选配送时段安排送达，非配送时间也可下单</view>
    <view class="date-label" wx:if="{{cloudMode}}">配送日期</view>
    <picker wx:if="{{cloudMode}}" mode="date" value="{{deliveryDate}}" start="{{deliveryDateMin}}" end="{{deliveryDateMax}}" bindchange="chooseDeliveryDate">
      <view class="date-select"><text>{{deliveryDate || '选择配送日期'}}</text><text class="chevron">›</text></view>
    </picker>
    <view class="date-label">配送时段</view>
    <view wx:if="{{slots.length}}" class="slot-options">
      <view wx:for="{{slots}}" wx:key="id" class="slot-choice {{selectedSlotId === item.id ? 'slot-selected' : ''}}" data-index="{{index}}" bindtap="tapDeliverySlot">
        <view class="slot-main"><text class="slot-label">{{item.label}}</text><text class="slot-hours">{{item.start}}–{{item.end}}</text></view>
        <view class="slot-radio"><view wx:if="{{selectedSlotId === item.id}}" class="slot-dot"></view></view>
      </view>
    </view>
    <view wx:else class="no-slots">当前日期没有可选配送时段，请更换配送日期或收货地址。</view>
    <view wx:if="{{cloudMode && selectionNotice}}" class="delivery-note">{{selectionNotice}}</view>
    <view wx:if="{{cloudMode && deliveryError}}" class="delivery-warning">{{deliveryError}}<text class="checkout-retry" bindtap="refreshCloudCheckout">刷新</text></view>
  </view>
  <view class="checkout-section">
    <view class="section-head"><text class="section-icon">▤</text><text>商品明细</text><text class="section-count">共 {{totalCount}} 件</text></view>
    <view wx:for="{{items}}" wx:key="productId" class="product-line"><text class="product-name">{{item.name}} <text class="product-count">× {{item.quantity}}</text></text><text class="product-price">¥{{item.subtotalText}}</text></view>
    <view class="price-line"><text>商品金额</text><text>¥{{totalText}}</text></view>
    <view wx:if="{{cloudMode}}" class="price-line"><text>配送费</text><text>¥{{deliveryFeeText}}</text></view>
    <view wx:if="{{minimumOrderText !== '0.00'}}" class="minimum-status">起送金额 ¥{{minimumOrderText}} <text wx:if="{{!minimumReached}}"> · 还差 ¥{{minimumRemainingText}}</text></view>
  </view>
  <view class="checkout-section">
    <view class="section-head"><text class="section-icon">✎</text><text>订单备注</text><text class="optional">选填</text></view>
    <view wx:if="{{noteShortcuts.length}}" class="checkout-note-presets"><view wx:for="{{noteShortcuts}}" wx:key="label" class="checkout-note-chip" data-label="{{item.label}}" bindtap="toggleNoteShortcut">{{item.label}}</view></view>
    <textarea class="note-input" maxlength="200" placeholder="有需要交代给商家的事项？" value="{{note}}" bindinput="updateNote" auto-height />
  </view>
  <view wx:if="{{cloudMode}}" class="checkout-section checkout-payment">
    <view class="section-head"><text class="section-icon">¥</text><text>支付方式</text><text class="payment-test-tag">测试环境</text></view>
    <view class="payment-explainer">选择测试渠道，提交订单后在订单详情获取 Stripe 外部付款链接。</view>
    <view class="payment-options">
      <view class="payment-option {{sandboxChannel === 'wechat_pay' ? 'payment-option-active' : ''}}" data-channel="wechat_pay" bindtap="chooseSandboxChannel" accessibilityLabel="微信支付测试" role="radio" aria-checked="{{sandboxChannel === 'wechat_pay'}}">
        <view class="payment-mark payment-mark-wechat">微</view>
        <view class="payment-copy"><view class="payment-name">微信支付</view><view class="payment-desc">Stripe 外部测试 · 非微信原生支付</view></view>
        <view class="payment-radio"><view wx:if="{{sandboxChannel === 'wechat_pay'}}" class="payment-radio-dot"></view></view>
      </view>
      <view class="payment-option {{sandboxChannel === 'alipay' ? 'payment-option-active' : ''}}" data-channel="alipay" bindtap="chooseSandboxChannel" accessibilityLabel="支付宝测试" role="radio" aria-checked="{{sandboxChannel === 'alipay'}}">
        <view class="payment-mark payment-mark-alipay">支</view>
        <view class="payment-copy"><view class="payment-name">支付宝</view><view class="payment-desc">Stripe 外部测试</view></view>
        <view class="payment-radio"><view wx:if="{{sandboxChannel === 'alipay'}}" class="payment-radio-dot"></view></view>
      </view>
      <view class="payment-option {{sandboxChannel === 'card' ? 'payment-option-active' : ''}}" data-channel="card" bindtap="chooseSandboxChannel" accessibilityLabel="银行卡测试" role="radio" aria-checked="{{sandboxChannel === 'card'}}">
        <view class="payment-mark payment-mark-card">卡</view>
        <view class="payment-copy"><view class="payment-name">银行卡</view><view class="payment-desc">Stripe Card 外部测试</view></view>
        <view class="payment-radio"><view wx:if="{{sandboxChannel === 'card'}}" class="payment-radio-dot"></view></view>
      </view>
    </view>
    <view class="payment-notice"><text class="payment-notice-icon">ⓘ</text><text>提交订单不会扣款，付款状态以服务端核验为准。具体渠道是否可用由测试服务决定。</text></view>
  </view>
  <view class="checkout-bottom-space"></view>
  <view class="checkout-bottom">
    <view class="bottom-amount"><view class="bottom-caption">合计</view><view class="bottom-price">¥{{payableText}}</view></view>
    <button wx:if="{{cloudMode}}" class="place-order" loading="{{cloudBusy || orderSubmitting}}" disabled="{{totalCount === 0 || orderSubmitting || cloudBusy || cloudError !== '' || deliveryError !== '' || !minimumReached || !selectedSlotId || !hasAddress}}" bindtap="confirmOrder">提交订单</button>
    <button wx:else class="place-order" loading="{{demoConfirmBusy}}" disabled="{{totalCount === 0 || demoConfirmBusy}}" bindtap="confirmOrder">提交订单</button>
  </view>
</view>
