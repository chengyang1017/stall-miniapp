page{background:#f5f6f8}.customer-orders-page{padding:28rpx;padding-bottom:100rpx}.customer-orders-title{font-size:38rpx;font-weight:700;color:#25332b;margin-bottom:12rpx}.customer-orders-tip{font-size:23rpx;color:#84918a;line-height:1.6;margin-bottom:18rpx}.customer-order-tabs{white-space:nowrap;width:100%;margin-bottom:25rpx}.customer-order-tabs-row{display:flex;flex-direction:row;gap:14rpx;width:max-content;padding:5rpx 0}.customer-tab{font-size:25rpx;padding:18rpx 22rpx;background:#fff;color:#617268;border-radius:30rpx;flex-shrink:0}.customer-tab-active{background:#16865d;color:#fff}.customer-tab-count{font-size:20rpx;margin-left:3rpx}.customer-orders-empty{padding:90rpx 25rpx;text-align:center;color:#999;font-size:27rpx}.customer-order-card{background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:20rpx}.customer-order-top,.customer-order-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.customer-order-number{font-size:22rpx;color:#8b9990;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:70%}.customer-order-state{color:#16865d;font-size:25rpx;font-weight:600;flex-shrink:0}.customer-order-items{font-size:30rpx;font-weight:500;color:#2d3530;margin-top:22rpx;line-height:1.5}.customer-order-info{font-size:23rpx;color:#8b948e;margin-top:10rpx}.customer-order-reason{color:#b85135;font-size:24rpx;margin-top:12rpx}.customer-order-bottom{border-top:1rpx solid #edf0ee;margin-top:22rpx;padding-top:20rpx}.customer-order-payment{font-size:24rpx;color:#b37e45}.customer-order-total{font-size:29rpx;font-weight:700}.customer-order-arrow{color:#96a59b}