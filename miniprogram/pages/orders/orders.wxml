<view class="customer-orders-page">
  <view wx:if="{{phoneOrdersLoading || phoneOrdersStatus || phoneOrders.length}}" class="customer-order-card">
    <view class="customer-orders-title">手机号顾客历史订单（只读）</view>
    <view wx:if="{{!phoneOrdersLoading && phoneOrdersStatus}}" class="customer-orders-tip">{{phoneOrdersStatus}}</view>
    <view wx:for="{{phoneOrders}}" wx:key="id" class="customer-order-info" data-id="{{item.id}}" bindtap="openPhoneOrder">
      <view>{{item.id}} · {{item.statusText}}</view>
      <view>{{item.createdText}} · {{item.paymentText}} · ¥{{item.totalText}}</view>
    </view>
    <button wx:if="{{phoneOrdersHasMore}}" size="mini" loading="{{phoneOrdersLoading}}" disabled="{{phoneOrdersLoading}}" bindtap="loadMorePhoneOrders">加载更多手机号历史订单</button>
  </view>
  <view wx:if="{{createdId && !cloudMode}}" class="customer-orders-tip">演示订单 {{createdId}} 已创建，尚未支付。</view>
    <view wx:if="{{loading && !visibleOrders.length}}" class="customer-orders-loading" aria-label="加载中"><view class="global-loading-spinner"></view></view><view wx:if="{{error}}" class="customer-order-card">
    <view>{{error}}</view>
    <button size="mini" bindtap="refresh">重新读取</button>
    <button wx:if="{{cloudMode}}" size="mini" bindtap="goOrderLogin">前往「我的」检查登录</button>
    <view class="customer-orders-tip">请求失败时，下方订单统计尚未确认，不代表没有订单。</view>
  </view>
  <scroll-view class="customer-order-tabs" scroll-x="true">
    <view class="customer-order-tabs-row">
      <view wx:for="{{tabs}}" wx:key="key" class="customer-tab {{activeTab === item.key ? 'customer-tab-active' : ''}}" data-tab="{{item.key}}" bindtap="switchTab">{{item.label}} <text class="customer-tab-count">{{!cloudMode || countsKnown ? item.count : '—'}}</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{!loading && !error && visibleOrders.length === 0}}" class="customer-orders-empty">这个分类暂时没有订单</view>
  <view wx:for="{{visibleOrders}}" wx:key="id" class="customer-order-card" data-id="{{item.id}}" bindtap="openOrder">
    <view class="customer-order-top"><text class="customer-order-number">{{item.id}}</text><text class="customer-order-state">{{item.statusText}}</text></view>
    <view class="customer-order-items">{{item.itemSummary}}</view>
    <view class="customer-order-info">{{item.createdText}}</view>
    <view wx:if="{{cloudMode}}" class="customer-order-info">查看订单详情 ›</view>
    <view wx:if="{{item.showEta}}" class="customer-order-info">预计送达：{{item.etaText}}</view>
    <view wx:if="{{item.other}}" class="customer-order-reason">原因：{{item.issueReason || '详情中查看'}}</view>
    <view class="customer-order-bottom"><text class="customer-order-payment">{{item.paymentText}}</text><view class="customer-order-total">¥{{item.totalText}}　<text class="customer-order-arrow">›</text></view></view>
  </view>
  <view wx:if="{{cloudMode}}" style="text-align:center;padding:24rpx">
    <button wx:if="{{hasMore}}" size="mini" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">加载更多订单</button>
    <text wx:if="{{!hasMore && !loading && !error && visibleOrders.length}}">已全部加载</text>
  </view>
</view>
