# Local development only. Never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/stall
PORT=8787
HOST=127.0.0.1
# Set to true only behind HTTPS with trusted reverse proxy in production.
PG_SSL=false
# Real WeChat Mini Program credentials; never place WX_APPSECRET in mini-program source.
WX_APPID=
WX_APPSECRET=

# S3-compatible object storage, e.g. Cloudflare R2. Use scoped credentials.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public HTTPS read-only image domain (R2 custom domain). Must not be R2 S3 endpoint.
IMAGE_PUBLIC_BASE_URL=
