# Local development only. Never commit real credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/stall
PORT=8787
HOST=127.0.0.1
# Set to true only behind HTTPS with trusted reverse proxy in production.
PG_SSL=false
# Real WeChat Mini Program credentials; never place WX_APPSECRET in mini-program source.
WX_APPID=
WX_APPSECRET=

# S3-compatible object storage, e.g. Cloudflare R2. Use scoped credentials.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public HTTPS read-only image domain (R2 custom domain). Must not be R2 S3 endpoint.
IMAGE_PUBLIC_BASE_URL=

# Phase32: a dedicated PRIVATE bucket, different from product/proof buckets.
# Confirm only after verifying public gateways and scoped storage credentials.
S3_REVIEW_BUCKET=
REVIEW_STORAGE_PRIVATE_CONFIRMED=false
# No payment/review auto-approval flag exists. Integrate the trusted server adapter.

# Staging simulation is OFF unless a source-reviewed deployment profile AND
# database identity/grants match. NODE_ENV=production remains a Node runtime mode.
# Do not copy test values to a production service; no approved real profile is shipped.
# APP_ENV=production
# STAGING_SIMULATED_PAYMENTS=DISABLED
# STAGING_DEPLOYMENT_ID=
# STAGING_PAYMENT_INSTANCE_ID=
# RENDER_SERVICE_ID is platform identity; do not invent or override it.

# Isolated Stripe TEST payment only. Never enable on the production database.
# APP_ENV=sandbox
# PAYMENT_DB_ENV=isolated-test
# STRIPE_TEST_PAYMENTS_ENABLED=false
# SANDBOX_PAYMENT_LIFECYCLE_ENABLED=false
# SANDBOX_PAYMENT_WORKER_ENABLED=false
# STRIPE_TEST_REFUNDS_ENABLED=false
# SANDBOX_PAYMENT_INSTANCE_ID=
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_TEST_CARD_CONFIGURATION=
# STRIPE_TEST_ALIPAY_CONFIGURATION=
# STRIPE_TEST_WECHAT_PAY_CONFIGURATION=
# Replace the HTTPS test-api.example domain with your own approved sandbox API host.
# STRIPE_TEST_SUCCESS_URL=https://test-api.example/v1/payments/stripe-test/return/complete
# STRIPE_TEST_CANCEL_URL=https://test-api.example/v1/payments/stripe-test/return/cancel
# Stripe test webhook endpoint: https://test-api.example/v1/payments/stripe-test/webhook
