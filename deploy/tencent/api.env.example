# TEMPLATE, NO ACTUAL SECRETS. Store as /etc/stall/api.env, root-owned mode 0640
# with access limited to the stall-api service group.
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# PostgreSQL 18 TencentDB private endpoint; use new role/password, not old Neon credentials.
DATABASE_URL=postgresql://APP_ROLE:SET_WITH_SECRET_MANAGER@PRIVATE_POSTGRES_HOST:5432/stall
PG_SSL=true
# Authentication: merchant-owned formal mini-program, not test AppID.
WX_APPID=
WX_APPSECRET=
# COS requires S3 compatibility validation and real bucket policy review before enabling uploads.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE_URL=
S3_PROOF_BUCKET=
PROOF_STORAGE_PRIVATE_CONFIRMED=false
S3_REVIEW_BUCKET=
REVIEW_STORAGE_PRIVATE_CONFIRMED=false
# Preserve closed-by-default money and destructive operations.
WECHAT_PAY_LIVE_ENABLED=false
WECHAT_PAY_LIVE_REFUNDS_ENABLED=false
WECHAT_PAY_REFUND_RECONCILE_ENABLED=false
IMAGE_CLEANUP_EXECUTION_ENABLED=false
IMAGE_CONDITIONAL_DELETE_VERIFIED=false
IMAGE_BACKUP_INVENTORY_CONFIRMED=false
# These staging and Stripe TEST flags must remain absent in real production.
# No STRIPE_TEST_*, SANDBOX_PAYMENT_* or STAGING_SIMULATED_PAYMENTS.
